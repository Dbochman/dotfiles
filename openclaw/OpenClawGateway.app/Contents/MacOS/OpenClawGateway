#!/bin/bash

export HOME="/Users/dbochman"
export PATH="$HOME/.openclaw/bin:/Users/dbochman/.local/share/openclaw/runtimes/node-v24.21.0-darwin-arm64/bin:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"

readonly GATEWAY_NODE_SHA256=e4b5a3af0e05c75de2eae013904145f40fe7fc2a6e6f17510128bf45cca4e79b
if [[ ! -x /Users/dbochman/.local/share/openclaw/runtimes/node-v24.21.0-darwin-arm64/bin/node ]] \
  || [[ "$(/usr/bin/shasum -a 256 /Users/dbochman/.local/share/openclaw/runtimes/node-v24.21.0-darwin-arm64/bin/node 2>/dev/null | /usr/bin/awk '{print $1}')" != "$GATEWAY_NODE_SHA256" ]]; then
  echo "FATAL: Required Node24 runtime is unavailable or unapproved; refusing fallback" >&2
  exit 78
fi

# Node's bundled roots do not receive browser revocation updates. Use the
# maintained Homebrew bundle (eMudhra incident, 2026-10-20), without adding the
# vulnerable bundled roots back via --use-system-ca or NODE_EXTRA_CA_CERTS.
readonly GATEWAY_CA_BUNDLE=/opt/homebrew/etc/ca-certificates/cert.pem
if [[ ! -s "$GATEWAY_CA_BUNDLE" || ! -r "$GATEWAY_CA_BUNDLE" ]]; then
  echo "FATAL: Required TLS CA bundle is unavailable" >&2
  exit 78
fi

CACHE="$HOME/.openclaw/.secrets-cache"

# Source secrets from cache file (KEY=VALUE format, one per line).
# Cache is populated/refreshed via: ssh dylans-mac-mini ~/bin/openclaw-refresh-secrets
if [[ -f "$CACHE" ]]; then
  set -a
  source "$CACHE"
  set +a
else
  echo "FATAL: No secrets cache at $CACHE" >&2
  echo "Run: ssh dylans-mac-mini ~/bin/openclaw-refresh-secrets" >&2
  exit 1
fi

# Truncate logs if over 5MB (keep last 1000 lines). The generated OpenClaw
# service plist writes to ~/Library/Logs/openclaw/gateway.log, while the tracked
# recovery plist uses ~/.openclaw/logs/gateway.{log,err.log}; cover both.
LOGS_DIR="$HOME/.openclaw/logs"
for f in \
  "$HOME/Library/Logs/openclaw/gateway.log" \
  "$LOGS_DIR/gateway.log" \
  "$LOGS_DIR/gateway.err.log"; do
  if [[ -f "$f" ]] && [[ "$(stat -f%z "$f" 2>/dev/null || echo 0)" -gt 5242880 ]]; then
    tail -1000 "$f" > "$f.tmp" && mv "$f.tmp" "$f"
  fi
done

# Verify critical secrets loaded
if [[ -z "${OPENCLAW_GATEWAY_TOKEN:-}" ]]; then
  echo "FATAL: OPENCLAW_GATEWAY_TOKEN not found in cache" >&2
  exit 1
fi

export SSL_CERT_FILE="$GATEWAY_CA_BUNDLE"
export CURL_CA_BUNDLE="$GATEWAY_CA_BUNDLE"
export NODE_OPTIONS=--use-openssl-ca
unset NODE_EXTRA_CA_CERTS NODE_USE_SYSTEM_CA
exec /Users/dbochman/.local/share/openclaw/runtimes/node-v24.21.0-darwin-arm64/bin/node /opt/homebrew/lib/node_modules/openclaw/dist/index.js gateway --port 18789
