{
  "id": "reachy-continuity",
  "name": "Reachy Continuity",
  "description": "Private, session-bound continuity between one owner iMessage DM and Reachy voice.",
  "version": "0.5.0",
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": [
      "reachy_continuity_handoff",
      "reachy_continuity_consume",
      "reachy_continuity_clear"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["imessageSession", "imessageTarget", "reachySession"],
    "properties": {
      "imessageSession": { "type": "string", "minLength": 1 },
      "imessageTarget": { "type": "string", "minLength": 1 },
      "reachySession": { "type": "string", "minLength": 1 },
      "statePath": { "type": "string", "minLength": 1 },
      "summaryModel": { "type": "string", "minLength": 1 },
      "identityPath": { "type": "string", "minLength": 1 },
      "soulPath": { "type": "string", "minLength": 1 },
      "userPath": { "type": "string", "minLength": 1 }
    }
  }
}
