#!/bin/sh

set -eu
umask 077

readonly SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
readonly PYTHON=/opt/homebrew/bin/python3
readonly WORKER="$SCRIPT_DIR/home_event_action.py"

[ -x "$PYTHON" ] && [ -f "$WORKER" ] && [ ! -L "$WORKER" ] || {
  printf '%s\n' '{"error":"action_worker_unavailable","ok":false}' >&2
  exit 1
}

exec "$PYTHON" -I "$WORKER" "$@"
