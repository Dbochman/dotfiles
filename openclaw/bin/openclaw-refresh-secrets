#!/usr/bin/env bash
# Refresh the protected OpenClaw cache from exact 1Password field references.
# This helper is manually invoked; LaunchAgents and their children must not run it.

set -euo pipefail
umask 077

CACHE="${OPENCLAW_SECRETS_CACHE:-$HOME/.openclaw/.secrets-cache}"
FINANCE_CACHE="${OPENCLAW_FINANCE_SECRETS_CACHE:-$HOME/.openclaw/financial-dashboard/scraper-credentials.json}"
NEST_EVENTS_SERVICE_ACCOUNT_FILE="${OPENCLAW_NEST_EVENTS_SERVICE_ACCOUNT_FILE:-$HOME/.openclaw/nest-events/credentials/subscriber-service-account.json}"
SEED_FILE="${OPENCLAW_SECRETS_SEED:-$HOME/.openclaw/.secrets-refresh.env}"
INTERACTIVE_CONFIRMED=0

usage() {
  cat >&2 <<'EOF'
Usage: openclaw-refresh-secrets --interactive [--seed-file PATH]

The owner-only seed file must be a regular mode-0600 shell assignment file. It
contains cache-only values and exact OP_REF_<CACHE_KEY> field references, never
secret values in tracked dotfiles. Existing cache-only values are preserved
when they are absent from the seed. A complete set of OP_REF_FINANCE_* fields
atomically refreshes the dedicated finance cache; no or partial values are
ever added to the gateway-exported general cache. An optional exact
OP_REF_NEST_EVENTS_SERVICE_ACCOUNT_JSON field atomically refreshes the
dedicated Nest event subscriber credential; it is never exported to the
general cache.
EOF
  exit 2
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --interactive)
      INTERACTIVE_CONFIRMED=1
      shift
      ;;
    --seed-file)
      [[ $# -ge 2 ]] || usage
      SEED_FILE="$2"
      shift 2
      ;;
    --help|-h)
      usage
      ;;
    *)
      usage
      ;;
  esac
done

if [[ "$INTERACTIVE_CONFIRMED" -ne 1 ]]; then
  echo "Refusing secret refresh without explicit --interactive confirmation." >&2
  exit 2
fi
if [[ ! -t 0 || ! -t 1 ]]; then
  echo "Refusing secret refresh without an attached interactive terminal." >&2
  exit 2
fi

printf 'Type REFRESH to read the configured exact 1Password fields: ' >&2
IFS= read -r attended_reply
if [[ "$attended_reply" != "REFRESH" ]]; then
  echo "Secret refresh cancelled." >&2
  exit 2
fi

private_file_metadata() {
  local file="$1"
  if stat -f '%u %Lp' "$file" >/dev/null 2>&1; then
    stat -f '%u %Lp' "$file"
  else
    stat -c '%u %a' "$file"
  fi
}

source_private_file() {
  local file="$1"
  local label="$2"
  [[ -e "$file" || -L "$file" ]] || return 1
  if [[ -L "$file" || ! -f "$file" ]]; then
    echo "$label must be a regular, non-symlink file; existing cache preserved." >&2
    exit 1
  fi

  local owner mode
  read -r owner mode < <(private_file_metadata "$file")
  if [[ "$owner" != "$(id -u)" || "$mode" != "600" ]]; then
    echo "$label must be owned by the current user with mode 0600; existing cache preserved." >&2
    exit 1
  fi

  # The file is owner-controlled input and contains shell-quoted assignments.
  set -a
  # shellcheck disable=SC1090
  if ! source "$file" >/dev/null 2>&1; then
    set +a
    echo "$label contains invalid assignments; existing cache preserved." >&2
    exit 1
  fi
  set +a
  return 0
}

validate_private_file() {
  local file="$1"
  local label="$2"
  [[ -e "$file" || -L "$file" ]] || return 1
  if [[ -L "$file" || ! -f "$file" ]]; then
    echo "$label must be a regular, non-symlink file; existing cache preserved." >&2
    exit 1
  fi
  local owner mode
  read -r owner mode < <(private_file_metadata "$file")
  if [[ "$owner" != "$(id -u)" || "$mode" != "600" ]]; then
    echo "$label must be owned by the current user with mode 0600; existing cache preserved." >&2
    exit 1
  fi
}

ensure_private_directory() {
  local directory="$1"
  local label="$2"

  if [[ -e "$directory" || -L "$directory" ]]; then
    if [[ -L "$directory" || ! -d "$directory" ]]; then
      echo "$label must be a regular, non-symlink directory; existing caches preserved." >&2
      exit 1
    fi
    local owner mode
    read -r owner mode < <(private_file_metadata "$directory")
    if [[ "$owner" != "$(id -u)" || "$mode" != "700" ]]; then
      echo "$label must be owned by the current user with mode 0700; existing caches preserved." >&2
      exit 1
    fi
    return 0
  fi

  if ! mkdir "$directory" || ! chmod 700 "$directory"; then
    echo "$label could not be created securely; existing caches preserved." >&2
    exit 1
  fi
}

# Load the last-good cache first, then allow the owner-only seed to update
# cache-only values and field references. Neither file is printed.
source_private_file "$CACHE" "Existing secrets cache" || true
source_private_file "$SEED_FILE" "Secrets refresh seed" || {
  echo "Owner-only seed file is required: $SEED_FILE" >&2
  exit 1
}

CACHE_ONLY_KEYS=(
  DYLAN_EMAIL
  JULIA_EMAIL
  OPENCLAW_EMAIL
  OPENTABLE_EMAIL
  HOUSEHOLD_CHAT_ID
  JULIA_CHAT_ID
  DYLAN_CHAT_ID
  ECHONEST_EMAIL
  STARMARKET_GMAIL
  STARMARKET_USER_HASH
  STARMARKET_DEVICE_TOKEN
  EIGHTSLEEP_CLIENT_ID
  EIGHTSLEEP_CLIENT_SECRET
  EIGHTSLEEP_DYLAN_USER_ID
  EIGHTSLEEP_JULIA_USER_ID
  EIGHTSLEEP_CROSSTOWN_DEVICE_ID
  EIGHTSLEEP_CABIN_DEVICE_ID
  PETLIBRO_APPSN
  CIELO_API_KEY
  TRYFI_EMAIL
  TRYFI_PASSWORD
  CROSSTOWN_LAT
  CROSSTOWN_LON
  CABIN_LAT
  CABIN_LON
)

VAULT_KEYS=(
  OPENAI_API_KEY
  ELEVENLABS_API_KEY
  OPENCLAW_GATEWAY_TOKEN
  CIELO_USERNAME
  CIELO_PASSWORD
  STARMARKET_USERNAME
  STARMARKET_PASSWORD
  PLAID_CLIENT_ID
  PLAID_SECRET_PRODUCTION
  PLAID_SECRET_SANDBOX
  NEST_CLIENT_ID
  NEST_CLIENT_SECRET
  NEST_REFRESH_TOKEN
  NEST_PROJECT_ID
)

FINANCE_VAULT_KEYS=(
  FINANCE_EVERSOURCE_USERNAME
  FINANCE_EVERSOURCE_PASSWORD
  FINANCE_NATIONAL_GRID_USERNAME
  FINANCE_NATIONAL_GRID_PASSWORD
  FINANCE_BWSC_USERNAME
  FINANCE_BWSC_PASSWORD
  FINANCE_PENNYMAC_USERNAME
  FINANCE_PENNYMAC_PASSWORD
  FINANCE_BOA_USERNAME
  FINANCE_BOA_PASSWORD
)

OPTIONAL_VAULT_KEYS=(MYSA_USERNAME MYSA_PASSWORD)

for key in "${CACHE_ONLY_KEYS[@]}"; do
  if [[ -z "${!key:-}" ]]; then
    echo "Required cache-only key $key is missing; existing cache preserved." >&2
    exit 1
  fi
done

OP_BIN=$(command -v op || true)
if [[ -z "$OP_BIN" ]]; then
  echo "1Password CLI is unavailable; existing cache preserved." >&2
  exit 1
fi

read_exact_field() {
  local key="$1"
  local reference_variable="OP_REF_${key}"
  local reference="${!reference_variable:-}"
  local value

  if [[ -z "$reference" ]]; then
    echo "Required field reference $reference_variable is missing; existing cache preserved." >&2
    exit 1
  fi
  if ! value=$("$OP_BIN" read "$reference" 2>/dev/null) || [[ -z "$value" ]]; then
    echo "Unable to refresh required field $key; existing cache preserved." >&2
    exit 1
  fi
  printf -v "$key" '%s' "$value"
}

for key in "${VAULT_KEYS[@]}"; do
  read_exact_field "$key"
done

# Finance credentials are optional for general cache refreshes but atomic as a
# complete dedicated-cache group. The weekly helper fails closed when this
# cache is absent or incomplete.
FINANCE_REF_COUNT=0
for key in "${FINANCE_VAULT_KEYS[@]}"; do
  reference_variable="OP_REF_${key}"
  [[ -n "${!reference_variable:-}" ]] && FINANCE_REF_COUNT=$((FINANCE_REF_COUNT + 1))
done
FINANCE_REFRESH=0
if [[ "$FINANCE_REF_COUNT" -eq "${#FINANCE_VAULT_KEYS[@]}" ]]; then
  FINANCE_REFRESH=1
  for key in "${FINANCE_VAULT_KEYS[@]}"; do
    read_exact_field "$key"
  done
elif [[ "$FINANCE_REF_COUNT" -ne 0 ]]; then
  echo "Finance field references must be configured as a complete set; existing caches preserved." >&2
  exit 1
fi

# Mysa is optional as a pair. If references are configured, both fields must
# refresh successfully. Otherwise preserve a complete existing pair or omit it.
MYSA_REF_COUNT=0
for key in "${OPTIONAL_VAULT_KEYS[@]}"; do
  reference_variable="OP_REF_${key}"
  [[ -n "${!reference_variable:-}" ]] && MYSA_REF_COUNT=$((MYSA_REF_COUNT + 1))
done
if [[ "$MYSA_REF_COUNT" -eq 2 ]]; then
  for key in "${OPTIONAL_VAULT_KEYS[@]}"; do
    read_exact_field "$key"
  done
elif [[ "$MYSA_REF_COUNT" -ne 0 ]]; then
  echo "Mysa field references must be configured as a complete pair; existing cache preserved." >&2
  exit 1
elif [[ -n "${MYSA_USERNAME:-}" || -n "${MYSA_PASSWORD:-}" ]]; then
  if [[ -z "${MYSA_USERNAME:-}" || -z "${MYSA_PASSWORD:-}" ]]; then
    echo "Existing Mysa cache is incomplete; existing cache preserved." >&2
    exit 1
  fi
fi

# The Pub/Sub subscriber credential is optional and remains isolated from the
# gateway-exported general cache. If configured, it is read as one exact field
# and materialized only by this attended refresh path.
NEST_EVENTS_SERVICE_ACCOUNT_REFRESH=0
if [[ -n "${OP_REF_NEST_EVENTS_SERVICE_ACCOUNT_JSON:-}" ]]; then
  NEST_EVENTS_SERVICE_ACCOUNT_REFRESH=1
  read_exact_field NEST_EVENTS_SERVICE_ACCOUNT_JSON
fi

CACHE_DIR=$(dirname "$CACHE")
mkdir -p "$CACHE_DIR"
chmod 700 "$CACHE_DIR"
TMP=$(mktemp "$CACHE_DIR/.secrets-cache.XXXXXX")
chmod 600 "$TMP"
FINANCE_TMP=""
NEST_EVENTS_SERVICE_ACCOUNT_TMP=""

cleanup_temps() {
  rm -f "$TMP"
  [[ -z "$FINANCE_TMP" ]] || rm -f "$FINANCE_TMP"
  [[ -z "$NEST_EVENTS_SERVICE_ACCOUNT_TMP" ]] || rm -f "$NEST_EVENTS_SERVICE_ACCOUNT_TMP"
}
trap cleanup_temps EXIT

write_assignment() {
  local key="$1"
  printf '%s=' "$key"
  printf '%q' "${!key}"
  printf '\n'
}

{
  for key in "${VAULT_KEYS[@]}" "${CACHE_ONLY_KEYS[@]}"; do
    write_assignment "$key"
  done
  if [[ -n "${MYSA_USERNAME:-}" && -n "${MYSA_PASSWORD:-}" ]]; then
    for key in "${OPTIONAL_VAULT_KEYS[@]}"; do
      write_assignment "$key"
    done
  fi
} > "$TMP"

if [[ "$FINANCE_REFRESH" -eq 1 ]]; then
  validate_private_file "$FINANCE_CACHE" "Existing finance secrets cache" || true
  FINANCE_CACHE_DIR=$(dirname "$FINANCE_CACHE")
  mkdir -p "$FINANCE_CACHE_DIR"
  chmod 700 "$FINANCE_CACHE_DIR"
  FINANCE_TMP=$(mktemp "$FINANCE_CACHE_DIR/.scraper-credentials.XXXXXX")
  chmod 600 "$FINANCE_TMP"
  for key in "${FINANCE_VAULT_KEYS[@]}"; do
    export "$key"
  done
  python3 - "$FINANCE_TMP" <<'PY'
import json
import os
import sys

profiles = {
    "eversource": ("FINANCE_EVERSOURCE_USERNAME", "FINANCE_EVERSOURCE_PASSWORD"),
    "national_grid": ("FINANCE_NATIONAL_GRID_USERNAME", "FINANCE_NATIONAL_GRID_PASSWORD"),
    "bwsc": ("FINANCE_BWSC_USERNAME", "FINANCE_BWSC_PASSWORD"),
    "pennymac": ("FINANCE_PENNYMAC_USERNAME", "FINANCE_PENNYMAC_PASSWORD"),
    "boa": ("FINANCE_BOA_USERNAME", "FINANCE_BOA_PASSWORD"),
}
payload = {
    profile: {"username": os.environ[username], "password": os.environ[password]}
    for profile, (username, password) in profiles.items()
}
with open(sys.argv[1], "w", encoding="utf-8") as handle:
    json.dump(payload, handle, sort_keys=True)
    handle.write("\n")
    handle.flush()
    os.fsync(handle.fileno())
PY
  for key in "${FINANCE_VAULT_KEYS[@]}"; do
    unset "$key"
  done
fi

if [[ "$NEST_EVENTS_SERVICE_ACCOUNT_REFRESH" -eq 1 ]]; then
  NEST_EVENTS_DIR=$(dirname "$(dirname "$NEST_EVENTS_SERVICE_ACCOUNT_FILE")")
  NEST_EVENTS_CREDENTIALS_DIR=$(dirname "$NEST_EVENTS_SERVICE_ACCOUNT_FILE")
  ensure_private_directory "$NEST_EVENTS_DIR" "Nest event runtime directory"
  ensure_private_directory "$NEST_EVENTS_CREDENTIALS_DIR" "Nest event credential directory"
  validate_private_file "$NEST_EVENTS_SERVICE_ACCOUNT_FILE" \
    "Existing Nest event subscriber credential" || true

  NEST_EVENTS_SERVICE_ACCOUNT_TMP=$(mktemp \
    "$NEST_EVENTS_CREDENTIALS_DIR/.subscriber-service-account.json.XXXXXX")
  chmod 600 "$NEST_EVENTS_SERVICE_ACCOUNT_TMP"
  printf '%s' "$NEST_EVENTS_SERVICE_ACCOUNT_JSON" > "$NEST_EVENTS_SERVICE_ACCOUNT_TMP"
  unset NEST_EVENTS_SERVICE_ACCOUNT_JSON

  if ! python3 - "$NEST_EVENTS_SERVICE_ACCOUNT_TMP" <<'PY'
import json
import os
import re
import sys


def reject_duplicate_keys(pairs):
    result = {}
    for key, value in pairs:
        if key in result:
            raise ValueError("duplicate JSON key")
        result[key] = value
    return result


path = sys.argv[1]
try:
    with open(path, encoding="utf-8") as credential_file:
        credential = json.load(
            credential_file,
            object_pairs_hook=reject_duplicate_keys,
        )

    if not isinstance(credential, dict) or credential.get("type") != "service_account":
        raise ValueError("invalid credential type")

    required_strings = (
        "project_id",
        "private_key_id",
        "private_key",
        "client_email",
        "client_id",
        "token_uri",
    )
    for field in required_strings:
        value = credential.get(field)
        if not isinstance(value, str) or not value or "\x00" in value:
            raise ValueError("missing required field")

    project_id = credential["project_id"]
    if not re.fullmatch(r"[a-z][a-z0-9-]{4,28}[a-z0-9]", project_id):
        raise ValueError("invalid project id")
    expected_email = (
        f"openclaw-nest-events@{project_id}.iam.gserviceaccount.com"
    )
    if credential["client_email"] != expected_email:
        raise ValueError("unexpected service account")
    if credential["token_uri"] != "https://oauth2.googleapis.com/token":
        raise ValueError("unexpected token endpoint")
    if not credential["client_id"].isdigit():
        raise ValueError("invalid client id")

    private_key = credential["private_key"].strip()
    if not (
        private_key.startswith("-----BEGIN PRIVATE KEY-----\n")
        and private_key.endswith("\n-----END PRIVATE KEY-----")
    ):
        raise ValueError("invalid private key")

    with open(path, "w", encoding="utf-8") as credential_file:
        json.dump(credential, credential_file, sort_keys=True, separators=(",", ":"))
        credential_file.write("\n")
        credential_file.flush()
        os.fsync(credential_file.fileno())
except (OSError, TypeError, ValueError, json.JSONDecodeError, UnicodeDecodeError):
    raise SystemExit(1)
PY
  then
    echo "Nest event subscriber credential is invalid; existing caches preserved." >&2
    exit 1
  fi
fi

python3 - "$TMP" ${FINANCE_TMP:+"$FINANCE_TMP"} \
  ${NEST_EVENTS_SERVICE_ACCOUNT_TMP:+"$NEST_EVENTS_SERVICE_ACCOUNT_TMP"} <<'PY'
import os
import sys

for path in sys.argv[1:]:
    descriptor = os.open(path, os.O_RDONLY)
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)
PY

if [[ "$FINANCE_REFRESH" -eq 1 ]]; then
  mv -f "$FINANCE_TMP" "$FINANCE_CACHE"
  chmod 600 "$FINANCE_CACHE"
  FINANCE_TMP=""
fi
mv -f "$TMP" "$CACHE"
chmod 600 "$CACHE"
TMP=""
if [[ "$NEST_EVENTS_SERVICE_ACCOUNT_REFRESH" -eq 1 ]]; then
  mv -f "$NEST_EVENTS_SERVICE_ACCOUNT_TMP" "$NEST_EVENTS_SERVICE_ACCOUNT_FILE"
  NEST_EVENTS_SERVICE_ACCOUNT_TMP=""
fi
trap - EXIT

echo "OpenClaw secrets cache refreshed atomically."
if [[ "$FINANCE_REFRESH" -eq 1 ]]; then
  echo "Dedicated finance secrets cache refreshed atomically."
fi
if [[ "$NEST_EVENTS_SERVICE_ACCOUNT_REFRESH" -eq 1 ]]; then
  echo "Dedicated Nest event subscriber credential refreshed atomically."
fi
echo "Restart only the services that need rotated values."
