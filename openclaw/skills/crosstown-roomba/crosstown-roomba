#!/usr/bin/env bash
# crosstown-roomba — control iRobot Roombas at Crosstown (Boston)
# Talks to robots via SSH to MacBook Pro + dorita980 MQTT.

set -euo pipefail

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
MACBOOK="${CROSSTOWN_ROOMBA_HOST:-dylans-macbook-pro}"
SSH_BIN="${CROSSTOWN_ROOMBA_SSH_BIN:-ssh}"
PYTHON_BIN="${CROSSTOWN_ROOMBA_PYTHON_BIN:-python3}"
JSON_HELPER="${CROSSTOWN_ROOMBA_JSON_HELPER:-$SCRIPT_DIR/roomba-json.py}"
CMD_SCRIPT="${CROSSTOWN_ROOMBA_REMOTE_SCRIPT:-\$HOME/.openclaw/rest980/roomba-cmd.js}"
ENV_10MAX="${CROSSTOWN_ROOMBA_ENV_10MAX:-\$HOME/.openclaw/rest980/env-10max}"
ENV_J5="${CROSSTOWN_ROOMBA_ENV_J5:-\$HOME/.openclaw/rest980/env-j5}"
NODE="${CROSSTOWN_ROOMBA_REMOTE_NODE:-/opt/homebrew/bin/node}"
VERIFY_ATTEMPTS="${CROSSTOWN_ROOMBA_VERIFY_ATTEMPTS:-4}"
VERIFY_INTERVAL="${CROSSTOWN_ROOMBA_VERIFY_INTERVAL:-2}"
DOCK_STOP_DELAY="${CROSSTOWN_ROOMBA_DOCK_STOP_DELAY:-1}"

LAST_RESPONSE=""
LAST_ERROR_CODE=""
LAST_ERROR_MESSAGE=""
LAST_ERROR_DETAIL=""
LAST_PHASE=""

usage() {
  cat <<'EOF'
Usage: crosstown-roomba <command> [robot]

Commands:
  status  [robot]   Battery, mission status, bin (default: all)
  start   [robot]   Start cleaning (default: all)
  stop    [robot]   Stop cleaning (default: all)
  pause   [robot]   Pause cleaning (default: all)
  resume  [robot]   Resume cleaning (default: all)
  dock    [robot]   Stop, then return to dock (default: all)
  find    [robot]   Play sound to locate (default: all)
  wifi    [robot]   WiFi info (default: all)
  state   <robot>   Full robot state JSON
  list              Show known robots

Robots: roomba (10 Max), scoomba (J5), all
EOF
}

require_command() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "Required command not found: $1" >&2
    return 1
  fi
}

validate_remote_token() {
  [[ -n "$2" && "$2" =~ ^[A-Za-z0-9_./\$~-]+$ ]] || {
    echo "Invalid $1 setting" >&2
    return 1
  }
}

validate_settings() {
  require_command "$SSH_BIN"
  require_command "$PYTHON_BIN"
  [[ -r "$JSON_HELPER" ]] || {
    echo "Roomba JSON helper is not readable: $JSON_HELPER" >&2
    return 1
  }

  [[ "$MACBOOK" =~ ^[A-Za-z0-9_.@-]+$ ]] || {
    echo "Invalid CROSSTOWN_ROOMBA_HOST setting" >&2
    return 1
  }
  validate_remote_token "remote Node path" "$NODE"
  validate_remote_token "remote command script" "$CMD_SCRIPT"
  validate_remote_token "10 Max environment path" "$ENV_10MAX"
  validate_remote_token "J5 environment path" "$ENV_J5"

  [[ "$VERIFY_ATTEMPTS" =~ ^[1-9][0-9]*$ ]] || {
    echo "CROSSTOWN_ROOMBA_VERIFY_ATTEMPTS must be a positive integer" >&2
    return 1
  }
  (( VERIFY_ATTEMPTS <= 10 )) || {
    echo "CROSSTOWN_ROOMBA_VERIFY_ATTEMPTS must be 10 or less" >&2
    return 1
  }
  [[ "$VERIFY_INTERVAL" =~ ^(0|[1-9][0-9]*)$ ]] || {
    echo "CROSSTOWN_ROOMBA_VERIFY_INTERVAL must be a non-negative integer" >&2
    return 1
  }
  (( VERIFY_INTERVAL <= 30 )) || {
    echo "CROSSTOWN_ROOMBA_VERIFY_INTERVAL must be 30 or less" >&2
    return 1
  }
  [[ "$DOCK_STOP_DELAY" =~ ^(0|[1-9][0-9]*)$ ]] || {
    echo "CROSSTOWN_ROOMBA_DOCK_STOP_DELAY must be a non-negative integer" >&2
    return 1
  }
  (( DOCK_STOP_DELAY <= 30 )) || {
    echo "CROSSTOWN_ROOMBA_DOCK_STOP_DELAY must be 30 or less" >&2
    return 1
  }
}

# Robot aliases are intentionally exact. Fuzzy matching is unsafe for commands
# that can start a physical device.
resolve_robot() {
  local name
  name=$(printf '%s' "${1:-}" | tr '[:upper:]' '[:lower:]')
  case "$name" in
    roomba|10max|10-max|combo|max) echo "10max" ;;
    scoomba|j5|j-5)               echo "j5" ;;
    all|both|"")                   echo "all" ;;
    *)                            echo "unknown" ;;
  esac
}

env_for_robot() {
  case "$1" in
    10max) echo "$ENV_10MAX" ;;
    j5)    echo "$ENV_J5" ;;
    *)     return 2 ;;
  esac
}

label_for_robot() {
  case "$1" in
    10max) echo "Roomba (10 Max)" ;;
    j5)    echo "scoomba (J5)" ;;
    *)     return 2 ;;
  esac
}

run_one() {
  local robot="$1"
  local command="$2"
  local env_file remote_command

  case "$command" in
    status|state|start|stop|pause|resume|dock|find|wifi|mission) ;;
    *)
      echo "Refusing unsupported remote command: $command" >&2
      return 2
      ;;
  esac
  env_file=$(env_for_robot "$robot") || {
    echo "Refusing unknown robot target: $robot" >&2
    return 2
  }
  remote_command="PATH=/opt/homebrew/bin:\$PATH $NODE $CMD_SCRIPT $env_file $command"
  "$SSH_BIN" -o BatchMode=yes -o ConnectTimeout=5 "$MACBOOK" "$remote_command" 2>&1
}

response_reports_error() {
  local rc
  if printf '%s' "$1" | "$PYTHON_BIN" "$JSON_HELPER" validate >/dev/null 2>&1; then
    return 1
  else
    rc=$?
  fi
  (( rc == 3 ))
}

# Populate LAST_RESPONSE on success, or LAST_ERROR_* on failure.
invoke_json() {
  local robot="$1"
  local command="$2"
  local output normalized rc

  LAST_RESPONSE=""
  LAST_ERROR_CODE=""
  LAST_ERROR_MESSAGE=""
  LAST_ERROR_DETAIL=""

  if output=$(run_one "$robot" "$command"); then
    :
  else
    rc=$?
    LAST_ERROR_DETAIL="$output"
    if (( rc == 255 )); then
      LAST_ERROR_CODE="transport_error"
      LAST_ERROR_MESSAGE="SSH transport failed"
    elif response_reports_error "$output"; then
      LAST_ERROR_CODE="action_error"
      LAST_ERROR_MESSAGE="Remote command reported a failure"
    else
      LAST_ERROR_CODE="remote_command_failed"
      LAST_ERROR_MESSAGE="Remote command exited with status $rc"
    fi
    return 1
  fi

  if normalized=$(printf '%s' "$output" | "$PYTHON_BIN" "$JSON_HELPER" validate 2>&1); then
    LAST_RESPONSE="$normalized"
    return 0
  else
    rc=$?
  fi

  LAST_ERROR_DETAIL="$normalized"
  if (( rc == 3 )); then
    LAST_ERROR_CODE="action_error"
    LAST_ERROR_MESSAGE="Robot reported a command error"
  else
    LAST_ERROR_CODE="invalid_json"
    LAST_ERROR_MESSAGE="Remote command returned invalid JSON"
  fi
  return 1
}

fetch_phase() {
  local robot="$1"
  local phase

  LAST_PHASE=""
  if ! invoke_json "$robot" "status"; then
    return 1
  fi
  if phase=$(printf '%s' "$LAST_RESPONSE" | "$PYTHON_BIN" "$JSON_HELPER" phase); then
    LAST_PHASE="$phase"
    return 0
  fi

  LAST_ERROR_CODE="missing_phase"
  LAST_ERROR_MESSAGE="Status response did not include a mission phase"
  LAST_ERROR_DETAIL="$LAST_RESPONSE"
  LAST_PHASE=""
  return 1
}

phase_matches_action() {
  local action="$1"
  local phase="$2"
  case "$action:$phase" in
    start:run|resume:run|pause:pause|stop:stop|stop:charge) return 0 ;;
    dock:charge|dock:hmUsrDock|dock:hmMidMsn|dock:hmPostMsn) return 0 ;;
    *) return 1 ;;
  esac
}

verify_phase() {
  local robot="$1"
  local action="$2"
  local attempt last_seen=""
  local underlying_detail=""

  for ((attempt = 1; attempt <= VERIFY_ATTEMPTS; attempt++)); do
    if fetch_phase "$robot"; then
      last_seen="$LAST_PHASE"
      if phase_matches_action "$action" "$LAST_PHASE"; then
        return 0
      fi
    else
      underlying_detail="$LAST_ERROR_DETAIL"
    fi
    if (( attempt < VERIFY_ATTEMPTS && VERIFY_INTERVAL > 0 )); then
      sleep "$VERIFY_INTERVAL"
    fi
  done

  LAST_ERROR_CODE="verification_failed"
  if [[ -n "$last_seen" ]]; then
    LAST_ERROR_MESSAGE="Mission phase did not reach the expected state for $action"
    LAST_ERROR_DETAIL="last phase: $last_seen"
    LAST_PHASE="$last_seen"
  else
    LAST_ERROR_MESSAGE="Unable to verify mission phase after $action"
    LAST_ERROR_DETAIL="$underlying_detail"
    LAST_PHASE=""
  fi
  return 1
}

make_success_result() {
  "$PYTHON_BIN" "$JSON_HELPER" success "$@"
}

make_failure_result() {
  "$PYTHON_BIN" "$JSON_HELPER" failure "$@"
}

action_message() {
  case "$1" in
    start)  echo "Cleaning started" ;;
    stop)   echo "Cleaning stopped" ;;
    pause)  echo "Cleaning paused" ;;
    resume) echo "Cleaning resumed" ;;
    dock)   echo "Return to dock started" ;;
    find)   echo "Locate sound requested" ;;
  esac
}

execute_action_one() {
  local robot="$1"
  local action="$2"
  local label message
  label=$(label_for_robot "$robot")
  message=$(action_message "$action")

  if [[ "$action" == "dock" ]]; then
    if fetch_phase "$robot"; then
      if [[ "$LAST_PHASE" == "charge" ]]; then
        make_success_result \
          "$robot" "$label" "$action" "skipped" "true" "$LAST_PHASE" \
          "Already charging on dock; no command sent"
        return 0
      fi
    else
      make_failure_result \
        "$robot" "$label" "$action" "dock_status_check_failed" \
        "$LAST_ERROR_MESSAGE" "$LAST_ERROR_DETAIL" "$LAST_PHASE"
      return 1
    fi

    if ! invoke_json "$robot" "stop"; then
      make_failure_result \
        "$robot" "$label" "$action" "pre_dock_stop_failed" \
        "$LAST_ERROR_MESSAGE" "$LAST_ERROR_DETAIL" "$LAST_PHASE"
      return 1
    fi
    if ! verify_phase "$robot" "stop"; then
      make_failure_result \
        "$robot" "$label" "$action" "pre_dock_stop_verification_failed" \
        "$LAST_ERROR_MESSAGE" "$LAST_ERROR_DETAIL" "$LAST_PHASE"
      return 1
    fi
    if (( DOCK_STOP_DELAY > 0 )); then
      sleep "$DOCK_STOP_DELAY"
    fi
  fi

  if ! invoke_json "$robot" "$action"; then
    make_failure_result \
      "$robot" "$label" "$action" "$LAST_ERROR_CODE" \
      "$LAST_ERROR_MESSAGE" "$LAST_ERROR_DETAIL" "$LAST_PHASE"
    return 1
  fi

  if [[ "$action" == "find" ]]; then
    make_success_result \
      "$robot" "$label" "$action" "not_applicable" "false" "" "$message"
    return 0
  fi

  if ! verify_phase "$robot" "$action"; then
    make_failure_result \
      "$robot" "$label" "$action" "$LAST_ERROR_CODE" \
      "$LAST_ERROR_MESSAGE" "$LAST_ERROR_DETAIL" "$LAST_PHASE"
    return 1
  fi
  make_success_result \
    "$robot" "$label" "$action" "passed" "false" "$LAST_PHASE" "$message"
}

emit_action_summary() {
  local action="$1"
  local target="$2"
  shift 2
  {
    local item
    for item in "$@"; do
      printf '%s\n' "$item"
    done
  } | "$PYTHON_BIN" "$JSON_HELPER" summary "$action" "$target"
}

cmd_action() {
  local action="$1"
  local requested="${2:-all}"
  local robot result failed=0
  local results=()
  local targets=()

  robot=$(resolve_robot "$requested")
  if [[ "$robot" == "unknown" ]]; then
    echo "Unknown robot: $requested. Use: roomba, scoomba, or all" >&2
    return 2
  fi
  if [[ "$robot" == "all" ]]; then
    targets=(10max j5)
  else
    targets=("$robot")
  fi

  for robot in "${targets[@]}"; do
    if result=$(execute_action_one "$robot" "$action"); then
      :
    else
      failed=1
    fi
    results[${#results[@]}]="$result"
  done
  emit_action_summary "$action" "$requested" "${results[@]}"
  return "$failed"
}

parse_status() {
  "$PYTHON_BIN" "$JSON_HELPER" status "$1"
}

parse_wifi() {
  "$PYTHON_BIN" "$JSON_HELPER" wifi "$1"
}

print_last_error() {
  local label="$1"
  echo "$label: Error [$LAST_ERROR_CODE] — $LAST_ERROR_MESSAGE" >&2
}

show_status_one() {
  local robot="$1"
  local label
  label=$(label_for_robot "$robot")
  if ! invoke_json "$robot" "status"; then
    print_last_error "$label"
    return 1
  fi
  printf '%s' "$LAST_RESPONSE" | parse_status "$label"
}

show_wifi_one() {
  local robot="$1"
  local label
  label=$(label_for_robot "$robot")
  if ! invoke_json "$robot" "wifi"; then
    print_last_error "$label"
    return 1
  fi
  printf '%s' "$LAST_RESPONSE" | parse_wifi "$label"
}

run_for_target() {
  local operation="$1"
  local requested="${2:-all}"
  local robot current failed=0 first=1
  local targets=()

  robot=$(resolve_robot "$requested")
  if [[ "$robot" == "unknown" ]]; then
    echo "Unknown robot: $requested. Use: roomba, scoomba, or all" >&2
    return 2
  fi
  if [[ "$robot" == "all" ]]; then
    targets=(10max j5)
  else
    targets=("$robot")
  fi

  for current in "${targets[@]}"; do
    if (( first == 0 )); then
      echo ""
    fi
    first=0
    if "$operation" "$current"; then
      :
    else
      failed=1
    fi
  done
  return "$failed"
}

cmd_state() {
  local requested="$1"
  local robot
  robot=$(resolve_robot "$requested")
  if [[ "$robot" == "unknown" || "$robot" == "all" ]]; then
    echo "Usage: crosstown-roomba state <roomba|scoomba>" >&2
    return 2
  fi
  if ! invoke_json "$robot" "state"; then
    print_last_error "$(label_for_robot "$robot")"
    return 1
  fi
  printf '%s' "$LAST_RESPONSE" | "$PYTHON_BIN" -m json.tool
}

cmd_list() {
  cat <<'EOF'
Crosstown Roombas:
  roomba  (10max, 10-max, combo, max)  — iRobot Roomba Combo 10 Max
  scoomba (j5, j-5)                   — iRobot Roomba J5

Use 'all' or 'both' to target both robots.
EOF
}

if (( $# < 1 )); then
  usage
  exit 2
fi

command="$1"
shift
case "$command" in
  list)
    if (( $# != 0 )); then
      echo "Usage: crosstown-roomba list" >&2
      exit 2
    fi
    cmd_list
    ;;
  state)
    if (( $# != 1 )); then
      echo "Usage: crosstown-roomba state <roomba|scoomba>" >&2
      exit 2
    fi
    validate_settings
    cmd_state "$1"
    ;;
  status|wifi|start|stop|pause|resume|dock|find)
    if (( $# > 1 )); then
      echo "Usage: crosstown-roomba $command [robot]" >&2
      exit 2
    fi
    validate_settings
    case "$command" in
      status) run_for_target show_status_one "${1:-all}" ;;
      wifi)   run_for_target show_wifi_one "${1:-all}" ;;
      *)      cmd_action "$command" "${1:-all}" ;;
    esac
    ;;
  *)
    echo "Unknown command: $command" >&2
    echo "Run 'crosstown-roomba' for help." >&2
    exit 2
    ;;
esac
