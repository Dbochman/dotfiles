#!/usr/bin/env python3
"""Human and JSON CLI for the guarded Litter-Robot adapter."""

from __future__ import annotations

import json
import os
from pathlib import Path
import subprocess
import sys


SKILL_DIR = Path(__file__).resolve().parent
API_SCRIPT = SKILL_DIR / "litter-robot-api.py"
PYTHON = Path(
    os.environ.get(
        "LITTER_ROBOT_PYTHON",
        Path.home() / ".openclaw/venvs/litter-robot/bin/python3",
    )
).expanduser()


def usage() -> str:
    return """Usage: litter-robot [--json] <command>

Commands:
  status [alias]                 Status for all robots or one exact alias
  overview [N]                   Cat profiles plus both robots and recent visits
  observe [N]                    Sanitized two-site activity for automation
  pets                           Cat profiles and recent weights
  history <alias> [N]            Activity history (default: 10)
  clean <alias>                  Start one cleaning cycle
  nightlight <alias> <on|off>    Set the night light
  reset <alias>                  Reset the robot (may trigger a cycle)

Aliases:
  crosstown-litter-robot
  cabin-litter-robot"""


def _status(payload: dict) -> str:
    lines: list[str] = []
    for robot in payload.get("robots", []):
        alias = robot.get("alias", "unknown")
        model = robot.get("model", "Litter-Robot")
        online = "Online" if robot.get("is_online") else "Offline"
        lines.append(f"{alias} ({model}) — {online}")
        lines.append(f"  Status:       {robot.get('status_text') or robot.get('status') or '?'}")
        waste = robot.get("waste_level_pct")
        waste_text = f"{waste}%" if waste is not None else "?"
        if robot.get("waste_full"):
            waste_text += " (FULL)"
        lines.append(f"  Waste Level:  {waste_text}")
        litter = robot.get("litter_level_pct")
        if litter is not None:
            lines.append(f"  Litter Level: {litter}%")
        lines.append(f"  Night Light:  {'On' if robot.get('night_light') else 'Off'}")
        lines.append(f"  Panel Lock:   {'On' if robot.get('panel_lock') else 'Off'}")
        lines.append(f"  Clean Wait:   {robot.get('clean_wait_minutes', '?')} min")
        cycles = robot.get("cycle_count")
        if cycles is not None:
            lines.append(f"  Cycles:       {cycles}")
        lines.append("")
    pets = payload.get("pets", [])
    if pets:
        lines.append("Cats:")
        for pet in pets:
            lines.append(f"  {pet.get('name', '?')} — {pet.get('weight_lbs', '?')} lbs")
    return "\n".join(lines).rstrip()


def _pets(payload: dict) -> str:
    lines: list[str] = []
    for pet in payload.get("pets", []):
        lines.append(f"{pet.get('name', '?')} — {pet.get('weight_lbs', '?')} lbs")
        recent = pet.get("recent_weights", [])
        if recent:
            latest = recent[0]
            lines.append(
                f"  Latest: {latest.get('weight_lbs', '?')} lbs at {latest.get('timestamp', '?')}"
            )
    return "\n".join(lines) or "No pet profiles found."


def _history(payload: dict) -> str:
    lines = [f"{payload.get('alias', 'Litter-Robot')} history:"]
    for item in payload.get("history", []):
        action = item.get("action", "?")
        if isinstance(item.get("weight_lbs"), (int, float)) and not isinstance(
            item.get("weight_lbs"), bool
        ):
            action = f"{action}: {item['weight_lbs']} lbs"
        lines.append(f"  {item.get('timestamp', '?')} — {action}")
    return "\n".join(lines)


def _action(payload: dict) -> str:
    action = str(payload.get("action", "done")).replace("_", " ").title()
    return f"{payload.get('alias', 'Litter-Robot')}: {action}"


def _observe(payload: dict) -> str:
    lines = [f"Observed: {payload.get('observedAt', '?')}"]
    for robot in payload.get("robots", []):
        lines.append(
            f"{robot.get('selector', '?')}: {len(robot.get('activities', []))} "
            "qualifying activities"
        )
    return "\n".join(lines)


def main(argv: list[str]) -> int:
    json_output = False
    if argv and argv[0] == "--json":
        json_output = True
        argv = argv[1:]
    elif argv and argv[-1] == "--json":
        json_output = True
        argv = argv[:-1]

    if not argv or argv[0] in {"help", "-h", "--help"}:
        print(usage())
        return 0 if argv else 1
    if not PYTHON.is_file() or not os.access(PYTHON, os.X_OK):
        payload = {
            "ok": False,
            "error": "runtime_missing",
            "message": "The locked Litter-Robot runtime is unavailable.",
        }
        if json_output:
            print(json.dumps(payload, separators=(",", ":"), sort_keys=True))
        else:
            print(f"Error: {payload['message']}", file=sys.stderr)
        return 1

    result = subprocess.run(
        [str(PYTHON), str(API_SCRIPT), *argv],
        capture_output=True,
        text=True,
    )
    try:
        payload = json.loads(result.stdout)
    except json.JSONDecodeError:
        payload = {
            "ok": False,
            "error": "invalid_response",
            "message": "Litter-Robot adapter returned an invalid response.",
        }
        result = subprocess.CompletedProcess(result.args, 1, result.stdout, result.stderr)

    if json_output:
        print(json.dumps(payload, separators=(",", ":"), sort_keys=True))
    elif not payload.get("ok"):
        print(f"Error: {payload.get('message', payload.get('error', 'command failed'))}", file=sys.stderr)
    elif argv[0] in {"status", "overview"}:
        print(_status(payload))
    elif argv[0] == "pets":
        print(_pets(payload))
    elif argv[0] == "history":
        print(_history(payload))
    elif argv[0] == "observe":
        print(_observe(payload))
    else:
        print(_action(payload))
    return result.returncode


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
