def operator_probe_local_user(
    arguments: list[str],
    *,
    password_reader: Callable[[str], str] = getpass.getpass,
    input_reader: Callable[[str], str] = input,
    fingerprint_probe: Callable[[str, int], str] = probe_tls_fingerprint,
    client_factory: Callable[[Binding], ReolinkClient] = ReolinkClient,
) -> dict[str, int | str | bool]:
    if arguments:
        raise PublicError("Operator capability probe arguments are invalid")
    if not sys.stdin.isatty() or not sys.stdout.isatty():
        raise PublicError(
            "Operator capability probe requires an attended terminal"
        )
    cancelled_message = "Operator capability probe cancelled"
    host = _validate_private_host(
        _read_operator_value(
            input_reader,
            "Reserved Home Hub private IP address: ",
            cancelled_message=cancelled_message,
        )
    )
    port_text = _read_operator_value(
        input_reader,
        "Home Hub HTTPS port [443]: ",
        cancelled_message=cancelled_message,
    )
    username_text = _read_operator_value(
        input_reader,
        "Home Hub administrator user [admin]: ",
        cancelled_message=cancelled_message,
    )
    try:
        port = _validate_port(int(port_text or "443"))
    except ValueError as error:
        raise PublicError("Operator capability probe input is invalid") from error
    username = _validate_username(username_text or "admin")
    try:
        password = _validate_password(
            password_reader("Home Hub administrator password: ")
        )
    except (EOFError, KeyboardInterrupt) as error:
        raise PublicError(cancelled_message) from error

    fingerprint = _validate_fingerprint(fingerprint_probe(host, port))
    grouped = ":".join(
        fingerprint[index : index + 2]
        for index in range(0, len(fingerprint), 2)
    )
    print(f"Home Hub TLS SHA-256 fingerprint: {grouped}")
    confirmation = _read_operator_value(
        input_reader,
        "Verify the local Hub endpoint, then type TRUST to probe it: ",
        cancelled_message=cancelled_message,
    )
    if confirmation != "TRUST":
        raise PublicError(cancelled_message)

    binding = Binding(
        alias="Operator capability probe",
        site="Cabin",
        host=host,
        port=port,
        channel=0,
        tls_sha256=fingerprint,
        username=username,
        password=password,
    )
    client = client_factory(binding)
    api_token: str | None = None
    try:
        try:
            api_token = client.login()
        except PublicError as error:
            raise PublicError(
                "Camera admin login verification failed"
            ) from error
        try:
            if isinstance(client, ReolinkClient):
                inspection = client._inspect_local_user_capability(
                    api_token,
                    username,
                )
                return client._project_local_user_capability(inspection)
            return client.probe_local_user_capability(api_token, username)
        except PublicError as error:
            safe_errors = {
                "Camera capability request failed",
                "Camera capability response is invalid",
                "Camera user-list request failed",
                "Camera user response is invalid",
            } | set(LOCAL_USER_PARSE_ERRORS)
            if str(error) in safe_errors:
                raise
            raise PublicError(
                "Camera local-user capability probe failed"
            ) from error
    except PublicError:
        raise
    except Exception as error:
        raise PublicError("Camera capability probe failed") from error
    finally:
        if api_token is not None:
            try:
                client.logout(api_token)
            except Exception:
                pass
        password = ""


def _existing_registry_payloads(
    *,
    config_path: Path,
    credentials_path: Path,
) -> tuple[list[dict[str, Any]], list[dict[str, str]]]:
    config_exists = config_path.exists() or config_path.is_symlink()
    credentials_exist = (
        credentials_path.exists() or credentials_path.is_symlink()
    )
    if config_exists != credentials_exist:
        raise PublicError("Camera configuration is inconsistent")
    if not config_exists:
        return [], []
    bindings, credentials = _load_registries(
        config_path=config_path,
        credentials_path=credentials_path,
    )
    return list(bindings.values()), list(credentials.values())


def _existing_registry_state(
    *,
    config_path: Path,
    credentials_path: Path,
) -> tuple[
    list[dict[str, Any]],
    list[dict[str, str]],
    dict[str, Any] | None,
    dict[str, Any] | None,
]:
    config_exists = config_path.exists() or config_path.is_symlink()
    credentials_exist = (
        credentials_path.exists() or credentials_path.is_symlink()
    )
    if config_exists != credentials_exist:
        raise PublicError("Camera configuration is inconsistent")
    if not config_exists:
        return [], [], None, None
    config = _read_private_json(config_path, "Camera configuration")
    credentials = _read_private_json(
        credentials_path,
        "Camera credentials",
    )
    config_generation, bindings = _validate_config_registry(config)
    credentials_generation, secrets_by_alias = _validate_credentials_registry(
        credentials
    )
    if (
        config_generation != credentials_generation
        or set(bindings) != set(secrets_by_alias)
    ):
        raise PublicError("Camera configuration is inconsistent")
    return (
        list(bindings.values()),
        list(secrets_by_alias.values()),
        config,
        credentials,
    )


def _generate_guest_username(directory: _LocalUserDirectory) -> str:
    minimum = directory.username_minimum
    maximum = directory.username_maximum
    if (
        isinstance(minimum, bool)
        or not isinstance(minimum, int)
        or isinstance(maximum, bool)
        or not isinstance(maximum, int)
    ):
        raise PublicError("Camera guest-account bootstrap is unsupported")
    maximum = min(maximum, 31)
    target_length = max(16, minimum)
    target_length = max(target_length, min(24, maximum))
    if target_length > maximum:
        raise PublicError("Camera guest-account bootstrap is unsupported")
    suffix_length = target_length - len("openclaw")
    existing = {username for username, _level in directory.users}
    for _attempt in range(32):
        suffix = secrets.token_hex(16)[:suffix_length]
        candidate = "openclaw" + suffix
        if (
            len(suffix) == suffix_length
            and GENERATED_GUEST_USERNAME_PATTERN.fullmatch(candidate)
            and candidate not in existing
        ):
            return candidate
    raise PublicError("Camera guest account name could not be generated")


def _guest_bootstrap_directory(
    inspection: _LocalUserCapability,
) -> _LocalUserDirectory:
    directory = inspection.directory
    if (
        inspection.version <= 0
        or not inspection.can_read
        or not inspection.can_write
        or directory is None
        or len(directory.users) >= MAX_LOCAL_USERS
        or (
            directory.levels is not None
            and "guest" not in directory.levels
        )
        or directory.username_minimum is None
        or directory.username_maximum is None
        or directory.password_minimum is None
        or directory.password_maximum is None
        or not (
            directory.password_minimum
            <= 30
            <= directory.password_maximum
        )
    ):
        raise PublicError("Camera guest-account bootstrap is unsupported")
    return directory


def _guest_registry_payloads(
    *,
    existing_bindings: list[dict[str, Any]],
    existing_credentials: list[dict[str, str]],
    binding: Binding,
) -> tuple[dict[str, Any], dict[str, Any], str]:
    bindings = [dict(camera) for camera in existing_bindings]
    credentials = [dict(camera) for camera in existing_credentials]
    bindings.append(
        {
            "alias": binding.alias,
            "site": binding.site,
            "host": binding.host,
            "port": binding.port,
            "channel": binding.channel,
            "tlsSha256": binding.tls_sha256,
        }
    )
    credentials.append(
        {
            "alias": binding.alias,
            "username": binding.username,
            "password": binding.password,
        }
    )
    bindings.sort(key=lambda camera: camera["alias"])
    credentials.sort(key=lambda camera: camera["alias"])
    generation = secrets.token_hex(16)
    config = {
        "version": CONFIG_VERSION,
        "generation": generation,
        "cameras": bindings,
    }
    credential_registry = {
        "version": CONFIG_VERSION,
        "generation": generation,
        "cameras": credentials,
    }
    _validate_config_registry(config)
    _validate_credentials_registry(credential_registry)
    return config, credential_registry, generation


def _restore_registry_state(
    *,
    previous_config: dict[str, Any] | None,
    previous_credentials: dict[str, Any] | None,
    attempted_generation: str,
    config_path: Path,
    credentials_path: Path,
) -> bool:
    try:
        if previous_config is not None and previous_credentials is not None:
            _activate_registry_pair(
                previous_config,
                previous_credentials,
                config_path=config_path,
                credentials_path=credentials_path,
            )
            restored_config = _read_private_json(
                config_path,
                "Camera configuration",
            )
            restored_credentials = _read_private_json(
                credentials_path,
                "Camera credentials",
            )
            return (
                restored_config == previous_config
                and restored_credentials == previous_credentials
            )
        if previous_config is not None or previous_credentials is not None:
            return False

        for path, label in (
            (config_path, "Camera configuration"),
            (credentials_path, "Camera credentials"),
        ):
            if not (path.exists() or path.is_symlink()):
                continue
            payload = _read_private_json(path, label)
            if (
                not isinstance(payload, dict)
                or payload.get("generation") != attempted_generation
            ):
                return False
        for path in (config_path, credentials_path):
            try:
                path.unlink()
            except FileNotFoundError:
                pass
        directory_descriptor = os.open(
            config_path.parent,
            os.O_RDONLY | getattr(os, "O_DIRECTORY", 0),
        )
        try:
            os.fsync(directory_descriptor)
        finally:
            os.close(directory_descriptor)
        return True
    except (OSError, PublicError):
        return False


def _rollback_guest_user(
    client: ReolinkOperatorClient,
    token: str,
    username: str,
) -> bool:
    try:
        client.delete_guest_user(token, username)
    except Exception:
        pass
    try:
        directory = client._get_local_user_directory(token)
    except Exception:
        return False
    return all(
        listed_username != username
        for listed_username, _level in directory.users
    )


def operator_bootstrap_guest(
    arguments: list[str],
    *,
    config_path: Path | None = None,
    credentials_path: Path | None = None,
    password_reader: Callable[[str], str] = getpass.getpass,
    input_reader: Callable[[str], str] = input,
    fingerprint_probe: Callable[[str, int], str] = probe_tls_fingerprint,
    operator_client_factory: Callable[
        [Binding], ReolinkOperatorClient
    ] = ReolinkOperatorClient,
    guest_client_factory: Callable[[Binding], ReolinkClient] = ReolinkClient,
) -> dict[str, str | bool]:
    if arguments:
        raise PublicError("Operator guest bootstrap arguments are invalid")
    if not sys.stdin.isatty() or not sys.stdout.isatty():
        raise PublicError(
            "Operator guest bootstrap requires an attended terminal"
        )
    cancelled_message = "Operator guest bootstrap cancelled"
    alias = _validate_alias(
        _read_operator_value(
            input_reader,
            "Exact OpenClaw camera alias: ",
            cancelled_message=cancelled_message,
        )
    )
    site = _validate_site(
        _read_operator_value(
            input_reader,
            "Site (Cabin or Crosstown): ",
            cancelled_message=cancelled_message,
        )
    )
    host = _validate_private_host(
        _read_operator_value(
            input_reader,
            "Reserved Home Hub private IP address: ",
            cancelled_message=cancelled_message,
        )
    )
    port_text = _read_operator_value(
        input_reader,
        "Home Hub HTTPS port [443]: ",
        cancelled_message=cancelled_message,
    )
    channel_text = _read_operator_value(
        input_reader,
        "Exact Home Hub channel [0]: ",
        cancelled_message=cancelled_message,
    )
    admin_username_text = _read_operator_value(
        input_reader,
        "Home Hub administrator user [admin]: ",
        cancelled_message=cancelled_message,
    )
    try:
        port = _validate_port(int(port_text or "443"))
        channel = _validate_channel(int(channel_text or "0"))
    except ValueError as error:
        raise PublicError("Operator guest bootstrap input is invalid") from error
    admin_username = _validate_username(admin_username_text or "admin")

    destination_config = config_path or _config_path()
    destination_credentials = credentials_path or _credentials_path()
    if destination_config.parent != destination_credentials.parent:
        raise PublicError("Camera configuration paths are invalid")
    _ensure_private_runtime_directory(destination_config.parent)
    (
        existing_bindings,
        existing_credentials,
        previous_config,
        previous_credentials,
    ) = _existing_registry_state(
        config_path=destination_config,
        credentials_path=destination_credentials,
    )
    if any(camera["alias"] == alias for camera in existing_bindings):
        raise PublicError("Camera alias is already configured")
    if len(existing_bindings) >= MAX_CAMERAS:
        raise PublicError("Camera configuration is full")

    fingerprint = _validate_fingerprint(fingerprint_probe(host, port))
    grouped = ":".join(
        fingerprint[index : index + 2]
        for index in range(0, len(fingerprint), 2)
    )
    print(f"Home Hub TLS SHA-256 fingerprint: {grouped}")
    trust = _read_operator_value(
        input_reader,
        "Verify the local Hub endpoint, then type TRUST to continue: ",
        cancelled_message=cancelled_message,
    )
    if trust != "TRUST":
        raise PublicError(cancelled_message)
    try:
        admin_password = _validate_password(
            password_reader("Home Hub administrator password: ")
        )
    except (EOFError, KeyboardInterrupt) as error:
        raise PublicError(cancelled_message) from error

    admin_binding = Binding(
        alias=alias,
        site=site,
        host=host,
        port=port,
        channel=channel,
        tls_sha256=fingerprint,
        username=admin_username,
        password=admin_password,
    )
    admin_client = operator_client_factory(admin_binding)
    admin_token: str | None = None
    guest_client: ReolinkClient | None = None
    guest_token: str | None = None
    guest_username = ""
    guest_password = ""
    snapshot_payload = b""
    remote_guest_created = False
    activation_started = False
    attempted_generation = ""
    committed = False
    failure: PublicError | None = None
    try:
        try:
            try:
                admin_token = admin_client.login()
            except Exception as error:
                raise PublicError(
                    "Camera admin login verification failed"
                ) from error
            try:
                inspection = admin_client._inspect_local_user_capability(
                    admin_token,
                    admin_username,
                )
                directory = _guest_bootstrap_directory(inspection)
            except PublicError as error:
                if str(error) in LOCAL_USER_PARSE_ERRORS or str(error) in {
                    "Camera capability request failed",
                    "Camera capability response is invalid",
                    "Camera user-list request failed",
                    "Camera guest-account bootstrap is unsupported",
                }:
                    raise
                raise PublicError(
                    "Camera guest-account capability check failed"
                ) from error
            except Exception as error:
                raise PublicError(
                    "Camera guest-account capability check failed"
                ) from error
            guest_username = _generate_guest_username(directory)
            guest_password = secrets.token_hex(15)
            if not GENERATED_GUEST_PASSWORD_PATTERN.fullmatch(guest_password):
                raise PublicError(
                    "Camera guest credential could not be generated"
                )
            guest_binding = Binding(
                alias=alias,
                site=site,
                host=host,
                port=port,
                channel=channel,
                tls_sha256=fingerprint,
                username=guest_username,
                password=guest_password,
            )
            (
                config_payload,
                credentials_payload,
                attempted_generation,
            ) = _guest_registry_payloads(
                existing_bindings=existing_bindings,
                existing_credentials=existing_credentials,
                binding=guest_binding,
            )
            create = _read_operator_value(
                input_reader,
                "Type CREATE to add the dedicated guest and activate it: ",
                cancelled_message=cancelled_message,
            )
            if create != "CREATE":
                raise PublicError(cancelled_message)

            try:
                admin_client.add_guest_user(
                    admin_token,
                    guest_username,
                    guest_password,
                )
            except _UserMutationRejected:
                raise
            except Exception as error:
                raise PublicError(
                    "Camera guest bootstrap requires manual cleanup"
                ) from error
            remote_guest_created = True

            try:
                confirmed_directory = (
                    admin_client._get_local_user_directory(admin_token)
                )
            except Exception as error:
                raise PublicError(
                    "Camera guest-account confirmation failed"
                ) from error
            matching_users = [
                level
                for listed_username, level in confirmed_directory.users
                if hmac.compare_digest(listed_username, guest_username)
            ]
            if matching_users != ["guest"]:
                raise PublicError(
                    "Camera guest-account confirmation failed"
                )

            guest_client = guest_client_factory(guest_binding)
            try:
                guest_token = guest_client.login()
            except Exception as error:
                raise PublicError(
                    "Camera guest login verification failed"
                ) from error
            try:
                if not guest_client.status(guest_token):
                    raise PublicError("Camera status is unavailable")
            except Exception as error:
                raise PublicError(
                    "Camera status verification failed"
                ) from error
            try:
                snapshot_payload = guest_client.snapshot(guest_token)
                if not _looks_like_jpeg(snapshot_payload):
                    raise PublicError("Captured camera image is invalid")
            except Exception as error:
                raise PublicError(
                    "Camera snapshot verification failed"
                ) from error
            finally:
                snapshot_payload = b""

            activation_started = True
            try:
                _activate_registry_pair(
                    config_payload,
                    credentials_payload,
                    config_path=destination_config,
                    credentials_path=destination_credentials,
                )
                activated_binding = load_binding(
                    alias,
                    config_path=destination_config,
                    credentials_path=destination_credentials,
                )
                if activated_binding != guest_binding:
                    raise PublicError(
                        "Camera configuration activation failed"
                    )
            except Exception as error:
                if (
                    isinstance(error, PublicError)
                    and str(error)
                    == "Camera configuration activation failed"
                ):
                    raise
                raise PublicError(
                    "Camera configuration activation failed"
                ) from error
            committed = True
        except PublicError as error:
            failure = error
        except Exception:
            failure = PublicError("Camera guest bootstrap failed")

        if failure is not None and not committed:
            local_restored = True
            if activation_started:
                local_restored = _restore_registry_state(
                    previous_config=previous_config,
                    previous_credentials=previous_credentials,
                    attempted_generation=attempted_generation,
                    config_path=destination_config,
                    credentials_path=destination_credentials,
                )
            remote_rolled_back = True
            if remote_guest_created:
                remote_rolled_back = (
                    admin_token is not None
                    and _rollback_guest_user(
                        admin_client,
                        admin_token,
                        guest_username,
                    )
                )
            if not local_restored or not remote_rolled_back:
                raise PublicError(
                    "Camera guest bootstrap requires manual cleanup"
                ) from failure
            raise failure
        return {"alias": alias, "site": site, "configured": True}
    finally:
        if guest_client is not None and guest_token is not None:
            try:
                guest_client.logout(guest_token)
            except Exception:
                pass
        if admin_token is not None:
            try:
                admin_client.logout(admin_token)
            except Exception:
                pass
        snapshot_payload = b""
        guest_password = ""
        admin_password = ""


