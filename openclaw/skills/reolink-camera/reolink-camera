        raise
    except Exception as error:
        raise PublicError("Camera enrollment verification failed") from error
    finally:
        if api_token is not None:
            try:
                client.logout(api_token)
            except Exception:
                pass

    destination_config = config_path or _config_path()
    destination_credentials = credentials_path or _credentials_path()
    existing_bindings, existing_credentials = _existing_registry_payloads(
        config_path=destination_config,
        credentials_path=destination_credentials,
    )
    existing_aliases = {camera["alias"] for camera in existing_bindings}
    if alias in existing_aliases and not parsed["replace"]:
        raise PublicError("Camera alias is already configured")
    existing_bindings = [
        camera for camera in existing_bindings if camera["alias"] != alias
    ]
    existing_credentials = [
        camera for camera in existing_credentials if camera["alias"] != alias
    ]
    if len(existing_bindings) >= MAX_CAMERAS:
        raise PublicError("Camera configuration is full")
    existing_bindings.append(
        {
            "alias": alias,
            "site": site,
            "host": host,
            "port": port,
            "channel": channel,
            "tlsSha256": fingerprint,
        }
    )
    existing_credentials.append(
        {
            "alias": alias,
            "username": username,
            "password": password,
        }
    )
    existing_bindings.sort(key=lambda camera: camera["alias"])
    existing_credentials.sort(key=lambda camera: camera["alias"])
    generation = secrets.token_hex(16)
    config_payload = {
        "version": CONFIG_VERSION,
        "generation": generation,
        "cameras": existing_bindings,
    }
    credentials_payload = {
        "version": CONFIG_VERSION,
        "generation": generation,
        "cameras": existing_credentials,
    }
    _validate_config_registry(config_payload)
    _validate_credentials_registry(credentials_payload)
    _activate_registry_pair(
        config_payload,
        credentials_payload,
        config_path=destination_config,
        credentials_path=destination_credentials,
    )
    password = ""
    return {"alias": alias, "site": site, "configured": True}


def _usage() -> PublicError:
    return PublicError(
        "Usage: reolink-camera check-config | status <alias> | "
        "capture <alias> | describe <token> | "
        "share <alias> <dylan|julia|household> | "
        "spotlight <alias> <status|on|off> | cleanup <token> | sweep | "
        "operator-probe-local-user | operator-bootstrap-guest"
    )


def main(argv: list[str] | None = None) -> int:
    arguments = sys.argv[1:] if argv is None else argv
    try:
        if arguments == ["check-config"]:
            print(
                json.dumps(
                    {"cameras": configured_cameras()},
                    separators=(",", ":"),
                    sort_keys=True,
                )
            )
            return 0
        if len(arguments) == 2 and arguments[0] == "status":
            print(
                json.dumps(
                    camera_status(arguments[1]),
                    separators=(",", ":"),
                    sort_keys=True,
                )
            )
            return 0
        if len(arguments) == 2 and arguments[0] == "capture":
            print(
                json.dumps(
                    capture_image(arguments[1]),
                    separators=(",", ":"),
                    sort_keys=True,
                )
            )
            return 0
        if len(arguments) == 2 and arguments[0] == "describe":
            print(
                json.dumps(
                    analyze_image(arguments[1]),
                    separators=(",", ":"),
                    sort_keys=True,
                )
            )
            return 0
        if len(arguments) == 3 and arguments[0] == "share":
            print(
                json.dumps(
                    share_image(arguments[1], arguments[2]),
                    separators=(",", ":"),
                    sort_keys=True,
                )
            )
            return 0
        if len(arguments) == 3 and arguments[0] == "spotlight":
            print(
                json.dumps(
                    camera_spotlight(arguments[1], arguments[2]),
                    separators=(",", ":"),
                    sort_keys=True,
                )
            )
            return 0
        if len(arguments) == 2 and arguments[0] == "cleanup":
            cleanup_image(arguments[1])
            return 0
        if arguments == ["sweep"]:
            sweep_images()
            return 0
        if arguments and arguments[0] == "operator-enroll":
            print(
                json.dumps(
                    operator_enroll(arguments[1:]),
                    separators=(",", ":"),
                    sort_keys=True,
                )
            )
            return 0
        if arguments and arguments[0] == "operator-probe-local-user":
            print(
                json.dumps(
                    operator_probe_local_user(arguments[1:]),
                    separators=(",", ":"),
                    sort_keys=True,
                )
            )
            return 0
        if arguments and arguments[0] == "operator-bootstrap-guest":
            print(
                json.dumps(
                    operator_bootstrap_guest(arguments[1:]),
                    separators=(",", ":"),
                    sort_keys=True,
                )
            )
            return 0
        raise _usage()
    except PublicError as error:
        print(str(error), file=sys.stderr)
        return 2
    except (KeyboardInterrupt, SystemExit):
        print("Camera request interrupted", file=sys.stderr)
        return 1
    except Exception:
        print("Camera request failed", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
