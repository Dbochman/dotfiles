def _reject_duplicate_keys(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
    result: dict[str, Any] = {}
    for key, value in pairs:
        if key in result:
            raise ValueError("duplicate key")
        result[key] = value
    return result


def _file_metadata(path: Path, label: str) -> os.stat_result:
    try:
        metadata = path.lstat()
    except OSError as error:
        raise PublicError(f"{label} is unavailable") from error
    if (
        stat.S_ISLNK(metadata.st_mode)
        or not stat.S_ISREG(metadata.st_mode)
        or metadata.st_uid != os.geteuid()
        or stat.S_IMODE(metadata.st_mode) != 0o600
        or metadata.st_nlink != 1
        or metadata.st_size <= 0
        or metadata.st_size > MAX_PRIVATE_JSON_BYTES
    ):
        raise PublicError(f"{label} is unavailable")
    return metadata


def _private_directory_metadata(path: Path, label: str) -> os.stat_result:
    try:
        metadata = path.lstat()
    except OSError as error:
        raise PublicError(f"{label} is unavailable") from error
    if (
        stat.S_ISLNK(metadata.st_mode)
        or not stat.S_ISDIR(metadata.st_mode)
        or metadata.st_uid != os.geteuid()
        or stat.S_IMODE(metadata.st_mode) != 0o700
    ):
        raise PublicError(f"{label} is unavailable")
    return metadata


def _read_private_json(path: Path, label: str) -> Any:
    parent_metadata = _private_directory_metadata(
        path.parent, "Camera configuration directory"
    )
    named_metadata = _file_metadata(path, label)
    flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0)
    flags |= getattr(os, "O_NONBLOCK", 0)
    try:
        descriptor = os.open(path, flags)
    except OSError as error:
        raise PublicError(f"{label} is unavailable") from error
    try:
        opened = os.fstat(descriptor)
        current_parent = path.parent.lstat()
        if (
            not stat.S_ISREG(opened.st_mode)
            or opened.st_uid != os.geteuid()
            or stat.S_IMODE(opened.st_mode) != 0o600
            or opened.st_nlink != 1
            or opened.st_size != named_metadata.st_size
            or (opened.st_dev, opened.st_ino)
            != (named_metadata.st_dev, named_metadata.st_ino)
            or (current_parent.st_dev, current_parent.st_ino)
            != (parent_metadata.st_dev, parent_metadata.st_ino)
        ):
            raise PublicError(f"{label} is unavailable")
        chunks: list[bytes] = []
        remaining = MAX_PRIVATE_JSON_BYTES + 1
        while remaining:
            chunk = os.read(descriptor, min(64 * 1024, remaining))
            if not chunk:
                break
            chunks.append(chunk)
            remaining -= len(chunk)
        after_read = os.fstat(descriptor)
        if (
            after_read.st_size != opened.st_size
            or after_read.st_mtime_ns != opened.st_mtime_ns
        ):
            raise PublicError(f"{label} is unavailable")
    except OSError as error:
        raise PublicError(f"{label} is unavailable") from error
    finally:
        os.close(descriptor)
    payload = b"".join(chunks)
    if len(payload) != named_metadata.st_size:
        raise PublicError(f"{label} is unavailable")
    try:
        return json.loads(
            payload.decode("utf-8"),
            object_pairs_hook=_reject_duplicate_keys,
        )
    except (UnicodeDecodeError, json.JSONDecodeError, TypeError, ValueError) as error:
        raise PublicError(f"{label} is invalid") from error


def _validate_text(
    value: Any,
    *,
    label: str,
    maximum: int,
    allow_newlines: bool = False,
) -> str:
    if not isinstance(value, str) or not value or len(value) > maximum:
        raise PublicError(f"{label} is invalid")
    if value != value.strip() or "\x00" in value:
        raise PublicError(f"{label} is invalid")
    has_control = any(
        ord(character) < 32 or ord(character) == 127
        for character in value
    )
    if not allow_newlines and has_control:
        raise PublicError(f"{label} is invalid")
    return value


def _validate_alias(value: Any) -> str:
    return _validate_text(value, label="Camera alias", maximum=80)


def _validate_site(value: Any) -> str:
    if value not in ALLOWED_SITES:
        raise PublicError("Camera site is invalid")
    return value


def _validate_private_host(value: Any) -> str:
    if not isinstance(value, str) or not value or len(value) > 64:
        raise PublicError("Camera host is invalid")
    try:
        address = ipaddress.ip_address(value)
    except ValueError as error:
        raise PublicError("Camera host is invalid") from error
    if str(address) != value:
        raise PublicError("Camera host is invalid")
    if isinstance(address, ipaddress.IPv4Address):
        allowed = any(address in network for network in PRIVATE_IPV4_NETWORKS)
    else:
        allowed = address in PRIVATE_IPV6_NETWORK
    if not allowed:
        raise PublicError("Camera host is invalid")
    return value


def _validate_port(value: Any) -> int:
    if isinstance(value, bool) or not isinstance(value, int):
        raise PublicError("Camera HTTPS port is invalid")
    if not 1 <= value <= 65535:
        raise PublicError("Camera HTTPS port is invalid")
    return value


def _validate_channel(value: Any) -> int:
    if isinstance(value, bool) or not isinstance(value, int):
        raise PublicError("Camera channel is invalid")
    if not 0 <= value <= 255:
        raise PublicError("Camera channel is invalid")
    return value


def _validate_fingerprint(value: Any) -> str:
    if not isinstance(value, str) or not FINGERPRINT_PATTERN.fullmatch(value):
        raise PublicError("Camera TLS fingerprint is invalid")
    return value


def _validate_username(value: Any) -> str:
    return _validate_text(value, label="Camera username", maximum=64)


def _validate_password(value: Any) -> str:
    return _validate_text(
        value,
        label="Camera password",
        maximum=256,
        allow_newlines=True,
    )


def _valid_length_range(
    value: Any,
    *,
    minimum: int,
    maximum: int,
) -> bool:
    if not isinstance(value, dict) or set(value) != {"minLen", "maxLen"}:
        return False
    minimum_length = value["minLen"]
    maximum_length = value["maxLen"]
    return (
        not isinstance(minimum_length, bool)
        and isinstance(minimum_length, int)
        and not isinstance(maximum_length, bool)
        and isinstance(maximum_length, int)
        and minimum <= minimum_length <= maximum_length <= maximum
    )


def _validate_generation(value: Any) -> str:
    if not isinstance(value, str) or not GENERATION_PATTERN.fullmatch(value):
        raise PublicError("Camera configuration is invalid")
    return value


def _validate_config_registry(value: Any) -> tuple[str, dict[str, dict[str, Any]]]:
    if not isinstance(value, dict) or set(value) != {
        "version",
        "generation",
        "cameras",
    }:
        raise PublicError("Camera configuration is invalid")
    if value["version"] != CONFIG_VERSION:
        raise PublicError("Camera configuration is invalid")
    generation = _validate_generation(value["generation"])
    cameras = value["cameras"]
    if not isinstance(cameras, list) or not 1 <= len(cameras) <= MAX_CAMERAS:
        raise PublicError("Camera configuration is invalid")
    result: dict[str, dict[str, Any]] = {}
    for camera in cameras:
        if not isinstance(camera, dict) or set(camera) != {
            "alias",
            "site",
            "host",
            "port",
            "channel",
            "tlsSha256",
        }:
            raise PublicError("Camera configuration is invalid")
        alias = _validate_alias(camera["alias"])
        if alias in result:
            raise PublicError("Camera configuration is invalid")
        result[alias] = {
            "alias": alias,
            "site": _validate_site(camera["site"]),
            "host": _validate_private_host(camera["host"]),
            "port": _validate_port(camera["port"]),
            "channel": _validate_channel(camera["channel"]),
            "tlsSha256": _validate_fingerprint(camera["tlsSha256"]),
        }
    return generation, result


def _validate_credentials_registry(
    value: Any,
) -> tuple[str, dict[str, dict[str, str]]]:
    if not isinstance(value, dict) or set(value) != {
        "version",
        "generation",
        "cameras",
    }:
        raise PublicError("Camera credentials are invalid")
    if value["version"] != CONFIG_VERSION:
        raise PublicError("Camera credentials are invalid")
    generation = _validate_generation(value["generation"])
    cameras = value["cameras"]
    if not isinstance(cameras, list) or not 1 <= len(cameras) <= MAX_CAMERAS:
        raise PublicError("Camera credentials are invalid")
    result: dict[str, dict[str, str]] = {}
    for camera in cameras:
        if not isinstance(camera, dict) or set(camera) != {
            "alias",
            "username",
            "password",
        }:
            raise PublicError("Camera credentials are invalid")
        alias = _validate_alias(camera["alias"])
        if alias in result:
            raise PublicError("Camera credentials are invalid")
        result[alias] = {
            "alias": alias,
            "username": _validate_username(camera["username"]),
            "password": _validate_password(camera["password"]),
        }
    return generation, result


def _load_registries(
    *,
    config_path: Path | None = None,
    credentials_path: Path | None = None,
) -> tuple[dict[str, dict[str, Any]], dict[str, dict[str, str]]]:
    config = _read_private_json(
        config_path or _config_path(), "Camera configuration"
    )
    credentials = _read_private_json(
        credentials_path or _credentials_path(), "Camera credentials"
    )
    config_generation, bindings = _validate_config_registry(config)
    credentials_generation, secrets_by_alias = _validate_credentials_registry(
        credentials
    )
    if (
        config_generation != credentials_generation
        or set(bindings) != set(secrets_by_alias)
    ):
        raise PublicError("Camera configuration is inconsistent")
    return bindings, secrets_by_alias


def load_binding(
    alias: str,
    *,
    config_path: Path | None = None,
    credentials_path: Path | None = None,
) -> Binding:
    requested_alias = _validate_alias(alias)
    bindings, credentials = _load_registries(
        config_path=config_path,
        credentials_path=credentials_path,
    )
    if requested_alias not in bindings:
        raise PublicError("Unknown camera alias")
    configured = bindings[requested_alias]
    credential = credentials[requested_alias]
    return Binding(
        alias=requested_alias,
        site=configured["site"],
        host=configured["host"],
        port=configured["port"],
        channel=configured["channel"],
        tls_sha256=configured["tlsSha256"],
        username=credential["username"],
        password=credential["password"],
    )


def configured_cameras(
    *,
    config_path: Path | None = None,
    credentials_path: Path | None = None,
) -> list[dict[str, str]]:
    bindings, _credentials = _load_registries(
        config_path=config_path,
        credentials_path=credentials_path,
    )
    return [
        {"alias": binding["alias"], "site": binding["site"]}
        for binding in sorted(bindings.values(), key=lambda item: item["alias"])
    ]


def _tls_context() -> ssl.SSLContext:
    context = ssl.SSLContext(ssl.PROTOCOL_TLS_CLIENT)
    context.check_hostname = False
    context.verify_mode = ssl.CERT_NONE
    context.minimum_version = ssl.TLSVersion.TLSv1_2
    return context


def _peer_fingerprint(connection: http.client.HTTPSConnection) -> str:
    peer = getattr(connection, "sock", None)
    if peer is None:
        raise PublicError("Camera TLS verification failed")
    try:
        certificate = peer.getpeercert(binary_form=True)
    except (OSError, ssl.SSLError) as error:
        raise PublicError("Camera TLS verification failed") from error
    if not isinstance(certificate, bytes) or not certificate:
        raise PublicError("Camera TLS verification failed")
    return hashlib.sha256(certificate).hexdigest()


def _parse_api_response(payload: bytes, expected_command: str) -> dict[str, Any]:
    try:
        parsed = json.loads(
            payload.decode("utf-8"),
            object_pairs_hook=_reject_duplicate_keys,
        )
    except (UnicodeDecodeError, json.JSONDecodeError, TypeError, ValueError) as error:
        raise PublicError("Camera returned an invalid response") from error
    if (
        not isinstance(parsed, list)
        or len(parsed) != 1
        or not isinstance(parsed[0], dict)
        or parsed[0].get("cmd") != expected_command
        or parsed[0].get("code") != 0
    ):
        raise PublicError("Camera request failed")
    return parsed[0]


class ReolinkClient:
    """Pinned-HTTPS access for the bounded public camera command set."""

    def __init__(
        self,
        binding: Binding,
        *,
        connection_factory: Callable[..., http.client.HTTPSConnection] = (
            http.client.HTTPSConnection
        ),
    ) -> None:
        self.binding = binding
        self.connection_factory = connection_factory

    def _request(
        self,
        method: str,
        path: str,
        *,
        body: bytes | None = None,
        maximum_bytes: int = MAX_API_RESPONSE_BYTES,
    ) -> bytes:
        if method not in ("GET", "POST"):
            raise PublicError("Camera request is invalid")
        if (
            not path.startswith("/cgi-bin/api.cgi?")
            or any(ord(character) < 32 or ord(character) == 127 for character in path)
        ):
            raise PublicError("Camera request is invalid")
        headers = {
            "Accept": "application/json, image/jpeg",
            "Connection": "close",
            "User-Agent": "OpenClaw-Reolink/1",
        }
        if body is not None:
            headers["Content-Type"] = "application/json"
            headers["Content-Length"] = str(len(body))
        connection: http.client.HTTPSConnection | None = None
        try:
            connection = self.connection_factory(
                self.binding.host,
                self.binding.port,
                timeout=REQUEST_TIMEOUT_SECONDS,
                context=_tls_context(),
            )
            connection.connect()
            actual_fingerprint = _peer_fingerprint(connection)
            if not hmac.compare_digest(
                actual_fingerprint, self.binding.tls_sha256
            ):
                raise PublicError("Camera TLS verification failed")
            connection.request(method, path, body=body, headers=headers)
            response = connection.getresponse()
            if response.status != 200:
                raise PublicError("Camera request failed")
            declared_length = response.getheader("Content-Length")
            if declared_length is not None:
                try:
                    parsed_length = int(declared_length)
                except ValueError as error:
                    raise PublicError("Camera returned an invalid response") from error
                if parsed_length < 0 or parsed_length > maximum_bytes:
                    raise PublicError("Camera returned an invalid response")
            payload = response.read(maximum_bytes + 1)
            if len(payload) > maximum_bytes:
                raise PublicError("Camera returned an invalid response")
            return payload
        except PublicError:
            raise
        except (
            OSError,
            TimeoutError,
            socket.timeout,
            ssl.SSLError,
            http.client.HTTPException,
        ) as error:
            raise PublicError("Camera is unavailable") from error
        finally:
            if connection is not None:
                try:
                    connection.close()
                except OSError:
                    pass

    def login(self) -> str:
        request = [
            {
                "cmd": "Login",
                "action": 0,
                "param": {
                    "User": {
                        "userName": self.binding.username,
                        "password": self.binding.password,
                        "Version": "0",
                    }
                },
            }
        ]
        body = json.dumps(
            request, separators=(",", ":"), ensure_ascii=False
        ).encode("utf-8")
        response = self._request(
            "POST",
            "/cgi-bin/api.cgi?cmd=Login",
            body=body,
        )
        item = _parse_api_response(response, "Login")
        value = item.get("value")
        token_container = value.get("Token") if isinstance(value, dict) else None
        token = (
            token_container.get("name")
            if isinstance(token_container, dict)
            else None
        )
        if not isinstance(token, str) or not API_TOKEN_PATTERN.fullmatch(token):
            raise PublicError("Camera authentication failed")
        return token

    def _post_command(
        self,
        command: str,
        token: str,
        param: dict[str, Any] | None,
        *,
        action: int = 0,
    ) -> dict[str, Any]:
        if command not in (
            "GetAbility",
            "GetBatteryInfo",
            "GetChannelstatus",
            "GetUser",
            "GetWhiteLed",
            "Logout",
            "SetWhiteLed",
        ):
            raise PublicError("Camera request is invalid")
        if not API_TOKEN_PATTERN.fullmatch(token):
            raise PublicError("Camera authentication failed")
        if action not in (0, 1):
            raise PublicError("Camera request is invalid")
        query = urllib.parse.urlencode({"cmd": command, "token": token})
        request_item: dict[str, Any] = {
            "cmd": command,
            "action": action,
        }
        if param is not None:
            request_item["param"] = param
        request = [request_item]
        body = json.dumps(request, separators=(",", ":")).encode("utf-8")
        response = self._request(
            "POST",
            "/cgi-bin/api.cgi?" + query,
            body=body,
        )
        return _parse_api_response(response, command)

    def _get_local_user_directory(
        self, token: str
    ) -> _LocalUserDirectory:
        try:
            users_item = self._post_command(
                "GetUser",
                token,
                None,
                action=1,
            )
        except PublicError as error:
            raise PublicError("Camera user-list request failed") from error
        users_value = users_item.get("value")
        users = (
            users_value.get("User")
            if isinstance(users_value, dict)
            else None
        )
        if not isinstance(users, list) or len(users) > MAX_LOCAL_USERS:
            raise PublicError(
                "Camera user response has an invalid list shape or count"
            )
        validated_users: list[tuple[str, str]] = []
        for user in users:
            if not isinstance(user, dict):
                raise PublicError(
                    "Camera user response has an invalid entry shape"
                )
            listed_username = user.get("userName")
            level = user.get("level")
            if (
                not isinstance(listed_username, str)
                or not listed_username
                or len(listed_username) > 31
                or listed_username != listed_username.strip()
                or any(
                    ord(character) < 32 or ord(character) == 127
                    for character in listed_username
                )
            ):
                raise PublicError(
                    "Camera user response has an invalid username"
                )
            if level not in ("admin", "guest"):
                raise PublicError(
                    "Camera user response has an unsupported role category"
                )
            validated_users.append((listed_username, level))

        range_value = users_item.get("range")
        if range_value is None:
            return _LocalUserDirectory(
                users=tuple(validated_users),
                levels=None,
                username_minimum=None,
                username_maximum=None,
                password_minimum=None,
                password_maximum=None,
            )
        range_user = (
            range_value.get("User")
            if isinstance(range_value, dict)
            else None
        )
        if not isinstance(range_user, dict):
            raise PublicError(
                "Camera user response has an invalid range shape"
            )
        levels_value = range_user.get("level")
        username_range = range_user.get("userName")
        password_range = range_user.get("password")
        if levels_value is None:
            levels: list[str] | None = None
        elif not isinstance(levels_value, list):
            if isinstance(levels_value, str):
                detail = "text"
            elif isinstance(levels_value, dict):
                detail = "object"
            elif isinstance(levels_value, bool):
                detail = "boolean"
            elif isinstance(levels_value, (int, float)):
                detail = "numeric"
            else:
                detail = "unknown"
            raise PublicError(
                f"Camera user response has a {detail} level range"
                if detail != "unknown"
                else "Camera user response has an unknown level range shape"
            )
        else:
            levels = levels_value
        if levels is not None and not levels:
            raise PublicError(
                "Camera user response has an empty level range"
            )
        if levels is not None and len(levels) > 8:
            raise PublicError(
                "Camera user response has an oversized level range"
            )
        for level in levels or ():
            if not isinstance(level, str):
                raise PublicError(
                    "Camera user response has a non-text level range entry"
                )
            if not level:
                raise PublicError(
                    "Camera user response has an empty level range entry"
                )
            if len(level) > 32:
                raise PublicError(
                    "Camera user response has an oversized level range entry"
                )
        if not _valid_length_range(
            username_range,
            minimum=1,
            maximum=64,
        ):
            raise PublicError(
                "Camera user response has an invalid username range"
            )
        if not _valid_length_range(
            password_range,
            minimum=0,
            maximum=256,
        ):
            raise PublicError(
                "Camera user response has an invalid password range"
            )
        return _LocalUserDirectory(
            users=tuple(validated_users),
            levels=tuple(levels) if levels is not None else None,
            username_minimum=username_range["minLen"],
            username_maximum=username_range["maxLen"],
            password_minimum=password_range["minLen"],
            password_maximum=password_range["maxLen"],
        )

    def _inspect_local_user_capability(
        self, token: str, username: str
    ) -> _LocalUserCapability:
        validated_username = _validate_username(username)
        try:
            item = self._post_command(
                "GetAbility",
                token,
                {"User": {"userName": validated_username}},
            )
        except PublicError as error:
            raise PublicError("Camera capability request failed") from error
        value = item.get("value")
        ability = value.get("Ability") if isinstance(value, dict) else None
        user_ability = (
            ability.get("user") if isinstance(ability, dict) else None
        )
        if not isinstance(user_ability, dict):
            raise PublicError("Camera capability response is invalid")
        permit = user_ability.get("permit")
        version = user_ability.get("ver")
        if (
            isinstance(permit, bool)
            or not isinstance(permit, int)
            or permit < 0
            or permit > 7
            or isinstance(version, bool)
            or not isinstance(version, int)
            or version < 0
            or version > 255
        ):
            raise PublicError("Camera capability response is invalid")

        can_read = version > 0 and bool(permit & 4)
        can_write = version > 0 and bool(permit & 2)
        directory: _LocalUserDirectory | None = None
        if can_read:
            directory = self._get_local_user_directory(token)
        return _LocalUserCapability(
            version=version,
            permit=permit,
            can_read=can_read,
            can_write=can_write,
            directory=directory,
        )

    def probe_local_user_capability(
        self, token: str, username: str
    ) -> dict[str, int | str | bool]:
        try:
            inspection = self._inspect_local_user_capability(token, username)
        except PublicError as error:
            if str(error) in LOCAL_USER_PARSE_ERRORS:
                raise PublicError("Camera user response is invalid") from error
            raise
        return self._project_local_user_capability(inspection)

    def _project_local_user_capability(
        self, inspection: _LocalUserCapability
    ) -> dict[str, int | str | bool]:
        existing_users: int | None = None
        listing_accessible = False
        account_range_advertised = False
        guest_account_advertised = False
        directory = inspection.directory
        if directory is not None:
            listing_accessible = True
            existing_users = len(directory.users)
            if directory.levels is not None:
                account_range_advertised = True
                guest_account_advertised = "guest" in directory.levels

        if inspection.version == 0 or not inspection.can_write:
            support = "unsupported"
        elif (
            listing_accessible
            and existing_users == MAX_LOCAL_USERS
        ):
            support = "full"
        elif listing_accessible and guest_account_advertised:
            support = "supported"
        elif account_range_advertised:
            support = "unsupported"
        else:
            support = "inconclusive"
        result: dict[str, int | str | bool] = {
            "authenticated": True,
            "guestAccountAdvertised": guest_account_advertised,
            "localUserManagement": support,
            "userListingAccessible": listing_accessible,
            "userWriteAdvertised": inspection.can_write,
        }
        if existing_users is not None:
            result["existingLocalUsers"] = existing_users
        return result

    def status(self, token: str) -> bool:
        item = self._post_command("GetChannelstatus", token, {})
        value = item.get("value")
        rows = value.get("status") if isinstance(value, dict) else None
        if not isinstance(rows, list) or len(rows) > 256:
            raise PublicError("Camera status is unavailable")
        for row in rows:
            if not isinstance(row, dict) or row.get("channel") != self.binding.channel:
                continue
            online = row.get("online")
            if online not in (0, 1, False, True):
                raise PublicError("Camera status is unavailable")
            return bool(online)
        raise PublicError("Camera status is unavailable")

    def power_status(self, token: str) -> dict[str, int | str]:
        try:
            item = self._post_command(
                "GetBatteryInfo",
                token,
                {"channel": self.binding.channel},
            )
        except PublicError as error:
            raise PublicError("Camera power status is unavailable") from error
        value = item.get("value")
        battery = value.get("Battery") if isinstance(value, dict) else None
        if not isinstance(battery, dict):
            raise PublicError("Camera power status is unavailable")
        battery_percent = battery.get("batteryPercent")
        charge_status = battery.get("chargeStatus")
        temperature = battery.get("temperature")
        response_channel = battery.get("channel")
        if (
            isinstance(battery_percent, bool)
            or not isinstance(battery_percent, int)
            or not 0 <= battery_percent <= 100
            or isinstance(charge_status, bool)
            or not isinstance(charge_status, int)
            or charge_status not in CHARGE_STATUS_NAMES
            or isinstance(temperature, bool)
            or not isinstance(temperature, int)
            or not -50 <= temperature <= 100
            or (
                response_channel is not None
                and response_channel != self.binding.channel
            )
        ):
            raise PublicError("Camera power status is unavailable")
        return {
            "batteryPercent": battery_percent,
            "chargeStatus": CHARGE_STATUS_NAMES[charge_status],
            "temperatureC": temperature,
        }

    def spotlight_state(self, token: str) -> bool:
        try:
            item = self._post_command(
                "GetWhiteLed",
                token,
                {"channel": self.binding.channel},
            )
        except PublicError as error:
            raise PublicError("Camera spotlight status is unavailable") from error
        value = item.get("value")
        spotlight = value.get("WhiteLed") if isinstance(value, dict) else None
        if not isinstance(spotlight, dict):
            raise PublicError("Camera spotlight status is unavailable")
        response_channel = spotlight.get("channel")
        state = spotlight.get("state")
        brightness = spotlight.get("bright")
        mode = spotlight.get("mode")
        if (
            isinstance(response_channel, bool)
            or response_channel != self.binding.channel
            or isinstance(state, bool)
            or not isinstance(state, int)
            or state not in (0, 1)
            or (
                brightness is not None
                and (
                    isinstance(brightness, bool)
                    or not isinstance(brightness, int)
                    or not 0 <= brightness <= 100
                )
            )
            or (
                mode is not None
                and (isinstance(mode, bool) or not isinstance(mode, int))
            )
        ):
            raise PublicError("Camera spotlight status is unavailable")
        return bool(state)

    def set_spotlight(
        self,
        token: str,
        enabled: bool,
        *,
        sleeper: Callable[[float], None] = time.sleep,
    ) -> bool:
        if type(enabled) is not bool:
            raise PublicError("Camera spotlight request is invalid")
        current = self.spotlight_state(token)
        if current == enabled:
            return False
        sleeper(SPOTLIGHT_WAKE_DELAY_SECONDS)
        try:
            item = self._post_command(
                "SetWhiteLed",
                token,
                {
                    "WhiteLed": {
                        "channel": self.binding.channel,
                        "state": 1 if enabled else 0,
                    }
                },
            )
        except PublicError as error:
            raise PublicError("Camera spotlight control failed") from error
        value = item.get("value")
        response_code = value.get("rspCode") if isinstance(value, dict) else None
        if (
            isinstance(response_code, bool)
            or not isinstance(response_code, int)
            or response_code != 200
        ):
            raise PublicError("Camera spotlight control failed")
        sleeper(SPOTLIGHT_READBACK_DELAY_SECONDS)
        if self.spotlight_state(token) != enabled:
            raise PublicError("Camera spotlight control could not be verified")
        return True

    def snapshot(self, token: str) -> bytes:
        if not API_TOKEN_PATTERN.fullmatch(token):
            raise PublicError("Camera authentication failed")
        query = urllib.parse.urlencode(
            {
                "cmd": "Snap",
                "channel": self.binding.channel,
                "rs": secrets.token_hex(8),
                "token": token,
            }
        )
        payload = self._request(
            "GET",
            "/cgi-bin/api.cgi?" + query,
            maximum_bytes=MAX_IMAGE_BYTES,
        )
        if not _looks_like_jpeg(payload):
            raise PublicError("Captured camera image is invalid")
        return payload

    def logout(self, token: str) -> None:
        try:
            self._post_command("Logout", token, {})
        except PublicError:
            pass


class ReolinkOperatorClient(ReolinkClient):
    """Operator-only user bootstrap commands; never exposed by the skill."""

    @staticmethod
    def _parse_user_mutation_response(
        payload: bytes,
        command: str,
    ) -> None:
        try:
            parsed = json.loads(
                payload.decode("utf-8"),
                object_pairs_hook=_reject_duplicate_keys,
            )
        except (
            UnicodeDecodeError,
            json.JSONDecodeError,
            TypeError,
            ValueError,
        ) as error:
            raise _UserMutationOutcomeUnknown(
                "Camera guest-account mutation outcome is unknown"
            ) from error
        if (
            not isinstance(parsed, list)
            or len(parsed) != 1
            or not isinstance(parsed[0], dict)
        ):
            raise _UserMutationOutcomeUnknown(
                "Camera guest-account mutation outcome is unknown"
            )
        item = parsed[0]
        response_command = item.get("cmd")
        response_code = item.get("code")
        value = item.get("value")
        success_code = (
            value.get("rspCode") if isinstance(value, dict) else None
        )
        if (
            response_command == command
            and response_code == 0
            and success_code == 200
        ):
            return

        error_value = item.get("error")
        rejection_code = (
            error_value.get("rspCode")
            if isinstance(error_value, dict)
            else success_code
        )
        if (
            isinstance(rejection_code, bool)
            or not isinstance(rejection_code, int)
            or response_code not in (0, 1)
        ):
            raise _UserMutationOutcomeUnknown(
                "Camera guest-account mutation outcome is unknown"
            )
        rejection_categories = {
            -6: "authentication",
            -9: "unsupported",
            -13: "set-failed",
            -22: "invalid-length",
            -26: "permission",
            -27: "invalid-user",
            -28: "already-exists",
            -29: "user-limit",
            -39: "missing-user",
        }
        category = rejection_categories.get(rejection_code, "rejected")
        raise _UserMutationRejected(
            f"Camera guest-account mutation was rejected: {category}"
        )

    def _user_mutation(
        self,
        command: str,
        token: str,
        user: dict[str, str],
    ) -> None:
        if command not in ("AddUser", "DelUser"):
            raise PublicError("Camera operator request is invalid")
        if not API_TOKEN_PATTERN.fullmatch(token):
            raise PublicError("Camera authentication failed")
        query = urllib.parse.urlencode({"cmd": command, "token": token})
        request = [
            {
                "cmd": command,
                "action": 0,
                "param": {
                    "User": user,
                },
            }
        ]
        body = json.dumps(
            request,
            separators=(",", ":"),
            ensure_ascii=False,
        ).encode("utf-8")
        try:
            response = self._request(
                "POST",
                "/cgi-bin/api.cgi?" + query,
                body=body,
            )
        except PublicError as error:
            raise _UserMutationOutcomeUnknown(
                "Camera guest-account mutation outcome is unknown"
            ) from error
        self._parse_user_mutation_response(response, command)

    def add_guest_user(
        self,
        token: str,
        username: str,
        password: str,
    ) -> None:
        if (
            not isinstance(username, str)
            or not GENERATED_GUEST_USERNAME_PATTERN.fullmatch(username)
            or not isinstance(password, str)
            or not GENERATED_GUEST_PASSWORD_PATTERN.fullmatch(password)
        ):
            raise PublicError("Camera operator request is invalid")
        self._user_mutation(
            "AddUser",
            token,
            {
                "userName": username,
                "password": password,
                "level": "guest",
            },
        )

    def delete_guest_user(self, token: str, username: str) -> None:
        if (
            not isinstance(username, str)
            or not GENERATED_GUEST_USERNAME_PATTERN.fullmatch(username)
        ):
            raise PublicError("Camera operator request is invalid")
        self._user_mutation(
            "DelUser",
            token,
            {"userName": username},
        )


def camera_status(
    alias: str,
    *,
    config_path: Path | None = None,
    credentials_path: Path | None = None,
    client_factory: Callable[[Binding], ReolinkClient] = ReolinkClient,
) -> dict[str, str | bool | int]:
    binding = load_binding(
        alias,
        config_path=config_path,
        credentials_path=credentials_path,
    )
    client = client_factory(binding)
    token: str | None = None
    try:
        token = client.login()
        available = client.status(token)
        power = client.power_status(token)
    except PublicError:
        raise
    except Exception as error:
        raise PublicError("Camera status is unavailable") from error
    finally:
        if token is not None:
            try:
                client.logout(token)
            except Exception:
                pass
    return {
        "alias": binding.alias,
        "site": binding.site,
        "available": available,
        **power,
    }


def camera_spotlight(
    alias: str,
    requested_state: str,
    *,
    config_path: Path | None = None,
    credentials_path: Path | None = None,
    client_factory: Callable[[Binding], ReolinkClient] = ReolinkClient,
    sleeper: Callable[[float], None] = time.sleep,
) -> dict[str, str | bool]:
    if requested_state not in ("status", "on", "off"):
        raise PublicError("Camera spotlight request is invalid")
    binding = load_binding(
        alias,
        config_path=config_path,
        credentials_path=credentials_path,
    )
    client = client_factory(binding)
    token: str | None = None
    changed: bool | None = None
    try:
        token = client.login()
        if requested_state == "status":
            enabled = client.spotlight_state(token)
        else:
            enabled = requested_state == "on"
            changed = client.set_spotlight(
                token,
                enabled,
                sleeper=sleeper,
            )
    except PublicError:
        raise
    except Exception as error:
        raise PublicError("Camera spotlight request failed") from error
    finally:
        if token is not None:
            try:
                client.logout(token)
            except Exception:
                pass
    result: dict[str, str | bool] = {
        "alias": binding.alias,
        "site": binding.site,
        "control": "spotlight",
        "state": "on" if enabled else "off",
    }
    if changed is not None:
        result["changed"] = changed
    return result


def _open_media_directory(path: Path, *, create: bool) -> int | None:
    try:
        parent_metadata = path.parent.lstat()
    except FileNotFoundError:
        if not create:
            return None
        previous_umask = os.umask(0o077)
        try:
            path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
        except OSError as error:
            raise PublicError("Camera image directory is unavailable") from error
        finally:
            os.umask(previous_umask)
        try:
            parent_metadata = path.parent.lstat()
        except OSError as error:
            raise PublicError("Camera image directory is unavailable") from error
    except OSError as error:
        raise PublicError("Camera image directory is unavailable") from error
    if (
        stat.S_ISLNK(parent_metadata.st_mode)
        or not stat.S_ISDIR(parent_metadata.st_mode)
        or parent_metadata.st_uid != os.geteuid()
        or stat.S_IMODE(parent_metadata.st_mode) != 0o700
    ):
        raise PublicError("Camera image directory is unavailable")

    try:
        metadata = path.lstat()
    except FileNotFoundError:
        if not create:
            return None
        previous_umask = os.umask(0o077)
        try:
            path.mkdir(mode=0o700, parents=True, exist_ok=False)
        except FileExistsError:
            pass
        except OSError as error:
            raise PublicError("Camera image directory is unavailable") from error
        finally:
            os.umask(previous_umask)
        try:
            metadata = path.lstat()
        except OSError as error:
            raise PublicError("Camera image directory is unavailable") from error
    except OSError as error:
        raise PublicError("Camera image directory is unavailable") from error
    if (
        stat.S_ISLNK(metadata.st_mode)
        or not stat.S_ISDIR(metadata.st_mode)
        or metadata.st_uid != os.geteuid()
        or stat.S_IMODE(metadata.st_mode) != 0o700
    ):
        raise PublicError("Camera image directory is unavailable")

    flags = os.O_RDONLY | getattr(os, "O_DIRECTORY", 0)
    flags |= getattr(os, "O_NOFOLLOW", 0)
    try:
        descriptor = os.open(path, flags)
    except OSError as error:
        raise PublicError("Camera image directory is unavailable") from error
    opened = os.fstat(descriptor)
    if (
        not stat.S_ISDIR(opened.st_mode)
        or opened.st_uid != os.geteuid()
        or stat.S_IMODE(opened.st_mode) != 0o700
        or (opened.st_dev, opened.st_ino) != (metadata.st_dev, metadata.st_ino)
    ):
        os.close(descriptor)
        raise PublicError("Camera image directory is unavailable")
    return descriptor


def _directory_identity_is_current(path: Path, descriptor: int) -> bool:
    try:
        named = path.lstat()
        opened = os.fstat(descriptor)
    except OSError:
        return False
    return (
        not stat.S_ISLNK(named.st_mode)
        and stat.S_ISDIR(named.st_mode)
        and named.st_uid == os.geteuid()
        and stat.S_IMODE(named.st_mode) == 0o700
        and (named.st_dev, named.st_ino) == (opened.st_dev, opened.st_ino)
    )


def _safe_unlink(descriptor: int, filename: str) -> None:
    try:
        os.unlink(filename, dir_fd=descriptor)
    except FileNotFoundError:
        pass


def _new_token(descriptor: int) -> str:
    for _ in range(32):
        token = secrets.token_hex(24)
        try:
            os.stat(token + ".jpg", dir_fd=descriptor, follow_symlinks=False)
        except FileNotFoundError:
            return token
        except OSError as error:
            raise PublicError("Camera image capture failed") from error
    raise PublicError("Camera image capture failed")


def _looks_like_jpeg(payload: bytes) -> bool:
    if (
        len(payload) < 16
        or payload[:2] != b"\xff\xd8"
        or payload[-2:] != b"\xff\xd9"
    ):
        return False
    saw_frame = False
    position = 2
    frame_markers = set(range(0xC0, 0xC4)) | set(range(0xC5, 0xC8))
    frame_markers |= set(range(0xC9, 0xCC)) | set(range(0xCD, 0xD0))
    while position < len(payload) - 2:
        if payload[position] != 0xFF:
            return False
        while position < len(payload) and payload[position] == 0xFF:
            position += 1
        if position >= len(payload):
            return False
        marker = payload[position]
        position += 1
        if marker == 0xDA:
            if position + 2 > len(payload):
                return False
            segment_length = int.from_bytes(
                payload[position : position + 2], "big"
            )
            if segment_length < 2 or position + segment_length > len(payload) - 2:
                return False
            return saw_frame
        if marker in (0xD8, 0xD9, 0x00) or 0xD0 <= marker <= 0xD7:
            return False
        if position + 2 > len(payload):
            return False
        segment_length = int.from_bytes(
            payload[position : position + 2], "big"
        )
        if segment_length < 2 or position + segment_length > len(payload):
            return False
        if marker in frame_markers:
            saw_frame = True
        position += segment_length
    return False


def _write_image(
    descriptor: int,
    directory: Path,
    token: str,
    payload: bytes,
    capture_started_ns: int,
) -> Path:
    if not _looks_like_jpeg(payload) or len(payload) > MAX_IMAGE_BYTES:
        raise PublicError("Captured camera image is invalid")
    filename = token + ".jpg"
    temporary = f".{token}.jpg.{secrets.token_hex(8)}.tmp"
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
    flags |= getattr(os, "O_NOFOLLOW", 0)
    image_descriptor: int | None = None
    try:
        image_descriptor = os.open(
            temporary,
            flags,
            0o600,
            dir_fd=descriptor,
        )
        offset = 0
        while offset < len(payload):
            written = os.write(image_descriptor, payload[offset:])
            if written <= 0:
                raise OSError("short write")
            offset += written
        os.fchmod(image_descriptor, 0o600)
        os.fsync(image_descriptor)
        os.close(image_descriptor)
        image_descriptor = None
        if not _directory_identity_is_current(directory, descriptor):
            raise PublicError("Camera image capture failed")
        os.rename(
            temporary,
            filename,
            src_dir_fd=descriptor,
            dst_dir_fd=descriptor,
        )
        metadata = os.stat(filename, dir_fd=descriptor, follow_symlinks=False)
        now_ns = time.time_ns()
        if (
            not stat.S_ISREG(metadata.st_mode)
            or metadata.st_uid != os.geteuid()
            or stat.S_IMODE(metadata.st_mode) != 0o600
            or metadata.st_size != len(payload)
            or metadata.st_mtime_ns + FRESHNESS_SLOP_NS < capture_started_ns
            or metadata.st_mtime_ns > now_ns + FRESHNESS_SLOP_NS
        ):
            raise PublicError("Captured camera image is invalid")
        return directory / filename
    except PublicError:
        raise
    except OSError as error:
        raise PublicError("Camera image capture failed") from error
    finally:
        if image_descriptor is not None:
            os.close(image_descriptor)
        _safe_unlink(descriptor, temporary)


def spawn_cleanup_reaper(
    token: str,
    media_directory: Path,
    *,
    ttl_seconds: int = DEFAULT_TTL_SECONDS,
    popen_factory: Callable[..., subprocess.Popen] = subprocess.Popen,
) -> None:
    if not TOKEN_PATTERN.fullmatch(token) or ttl_seconds <= 0:
        raise PublicError("Camera image cleanup could not be scheduled")
    if media_directory != _media_directory():
        raise PublicError("Camera image cleanup could not be scheduled")
    helper = Path(__file__).resolve()
    command = 'sleep "$1"; exec "$2" "$3" cleanup "$4"'
    try:
        popen_factory(
            [
                "/bin/sh",
                "-c",
                command,
                "reolink-camera-reaper",
                str(ttl_seconds),
                sys.executable,
                str(helper),
                token,
            ],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            cwd="/",
            env={
                "HOME": str(Path.home()),
                "PATH": "/usr/bin:/bin:/usr/sbin:/sbin",
            },
            close_fds=True,
            start_new_session=True,
        )
    except OSError as error:
        raise PublicError("Camera image cleanup could not be scheduled") from error


def _sweep_open_directory(
    descriptor: int,
    *,
    now: float | None = None,
    ttl_seconds: int = DEFAULT_TTL_SECONDS,
) -> int:
    if ttl_seconds <= 0:
        raise PublicError("Camera image sweep failed")
    cutoff = (time.time() if now is None else now) - ttl_seconds
    try:
        filenames = os.listdir(descriptor)
    except OSError as error:
        raise PublicError("Camera image sweep failed") from error
    removed = 0
    for filename in filenames:
        if not (
            MEDIA_NAME_PATTERN.fullmatch(filename)
            or TEMP_NAME_PATTERN.fullmatch(filename)
        ):
            continue
        try:
            metadata = os.stat(
                filename, dir_fd=descriptor, follow_symlinks=False
            )
        except FileNotFoundError:
            continue
        except OSError as error:
            raise PublicError("Camera image sweep failed") from error
        if metadata.st_mtime > cutoff:
            continue
        if metadata.st_uid != os.geteuid() or not (
            stat.S_ISREG(metadata.st_mode) or stat.S_ISLNK(metadata.st_mode)
        ):
            continue
        try:
            os.unlink(filename, dir_fd=descriptor)
            removed += 1
        except FileNotFoundError:
            continue
        except OSError as error:
            raise PublicError("Camera image sweep failed") from error
    return removed


def sweep_images(
    *,
    media_directory: Path | None = None,
    now: float | None = None,
    ttl_seconds: int = DEFAULT_TTL_SECONDS,
) -> int:
    directory = media_directory or _media_directory()
    descriptor = _open_media_directory(directory, create=False)
    if descriptor is None:
        return 0
    try:
        return _sweep_open_directory(
            descriptor,
            now=now,
            ttl_seconds=ttl_seconds,
        )
    finally:
        os.close(descriptor)


def cleanup_image(
    token: str,
    *,
    media_directory: Path | None = None,
) -> None:
    if not TOKEN_PATTERN.fullmatch(token):
        raise PublicError("Invalid camera image cleanup token")
    directory = media_directory or _media_directory()
    descriptor = _open_media_directory(directory, create=False)
    if descriptor is None:
        return
    try:
        _safe_unlink(descriptor, token + ".jpg")
    except OSError as error:
        raise PublicError("Camera image cleanup failed") from error
    finally:
        os.close(descriptor)


def capture_image(
    alias: str,
    *,
    config_path: Path | None = None,
    credentials_path: Path | None = None,
    media_directory: Path | None = None,
    client_factory: Callable[[Binding], ReolinkClient] = ReolinkClient,
    reaper: Callable[[str, Path], None] = spawn_cleanup_reaper,
) -> dict[str, str]:
    binding = load_binding(
        alias,
        config_path=config_path,
        credentials_path=credentials_path,
    )
    client = client_factory(binding)
    token: str | None = None
    capture_started_ns = time.time_ns()
    try:
        token = client.login()
        payload = client.snapshot(token)
    except PublicError:
        raise
    except Exception as error:
        raise PublicError("Camera image capture failed") from error
    finally:
        if token is not None:
            try:
                client.logout(token)
            except Exception:
                pass

    directory = media_directory or _media_directory()
    descriptor = _open_media_directory(directory, create=True)
    assert descriptor is not None
    token_handle = _new_token(descriptor)
    filename = token_handle + ".jpg"
    try:
        _sweep_open_directory(descriptor)
        media_path = _write_image(
            descriptor,
            directory,
            token_handle,
            payload,
            capture_started_ns,
        )
        try:
            reaper(token_handle, directory)
        except PublicError:
            raise
        except Exception as error:
            raise PublicError(
                "Camera image cleanup could not be scheduled"
            ) from error
        return {
            "alias": binding.alias,
            "mediaPath": str(media_path),
            "cleanupToken": token_handle,
        }
    except Exception:
        _safe_unlink(descriptor, filename)
        raise
    finally:
        os.close(descriptor)


def _validated_media_path(
    token: str,
    *,
    media_directory: Path | None = None,
) -> Path:
    if not isinstance(token, str) or not TOKEN_PATTERN.fullmatch(token):
        raise PublicError("Invalid camera image token")
    directory = media_directory or _media_directory()
    descriptor = _open_media_directory(directory, create=False)
    if descriptor is None:
        raise PublicError("Camera image is unavailable")
    filename = token + ".jpg"
    image_descriptor: int | None = None
    try:
        try:
            named = os.stat(filename, dir_fd=descriptor, follow_symlinks=False)
            flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0)
            image_descriptor = os.open(filename, flags, dir_fd=descriptor)
            opened = os.fstat(image_descriptor)
        except (OSError, ValueError) as error:
            raise PublicError("Camera image is unavailable") from error
        if (
            not stat.S_ISREG(named.st_mode)
            or named.st_uid != os.geteuid()
            or stat.S_IMODE(named.st_mode) != 0o600
            or named.st_nlink != 1
            or named.st_size <= 0
            or named.st_size > MAX_IMAGE_BYTES
            or (named.st_dev, named.st_ino) != (opened.st_dev, opened.st_ino)
            or opened.st_uid != os.geteuid()
            or stat.S_IMODE(opened.st_mode) != 0o600
            or opened.st_nlink != 1
            or not _directory_identity_is_current(directory, descriptor)
        ):
            raise PublicError("Camera image is unavailable")
        chunks: list[bytes] = []
        remaining = MAX_IMAGE_BYTES + 1
        while remaining:
            chunk = os.read(image_descriptor, min(64 * 1024, remaining))
            if not chunk:
                break
            chunks.append(chunk)
            remaining -= len(chunk)
        after_read = os.fstat(image_descriptor)
        payload = b"".join(chunks)
        if (
            len(payload) != opened.st_size
            or after_read.st_size != opened.st_size
            or after_read.st_mtime_ns != opened.st_mtime_ns
            or not _looks_like_jpeg(payload)
        ):
            raise PublicError("Camera image is unavailable")
    except PublicError:
        raise
    except OSError as error:
        raise PublicError("Camera image is unavailable") from error
    finally:
        if image_descriptor is not None:
            os.close(image_descriptor)
        os.close(descriptor)
    return directory / filename


def _runtime_environment() -> dict[str, str]:
    return {
        "HOME": str(Path.home()),
        "PATH": RUNTIME_PATH,
        "LANG": "en_US.UTF-8",
        "LC_ALL": "en_US.UTF-8",
    }


def _run_bounded_command(
    command: list[str],
    *,
    timeout: int,
    failure_message: str,
    stdin_data: bytes | None = None,
) -> bytes:
    if (
        stdin_data is not None
        and (
            not isinstance(stdin_data, bytes)
            or not stdin_data
            or len(stdin_data) > MAX_COMMAND_INPUT_BYTES
        )
    ):
        raise PublicError(failure_message)
    run_options: dict[str, Any] = {
        "stdout": subprocess.PIPE,
        "stderr": subprocess.PIPE,
        "env": _runtime_environment(),
        "timeout": timeout,
        "check": False,
        "start_new_session": True,
    }
    if stdin_data is None:
        run_options["stdin"] = subprocess.DEVNULL
    else:
        run_options["input"] = stdin_data
    try:
        completed = subprocess.run(command, **run_options)
    except (OSError, subprocess.SubprocessError) as error:
        raise PublicError(failure_message) from error
    if (
        completed.returncode != 0
        or not isinstance(completed.stdout, bytes)
        or not completed.stdout
        or len(completed.stdout) > MAX_INFERENCE_OUTPUT_BYTES
        or not isinstance(completed.stderr, bytes)
        or len(completed.stderr) > MAX_INFERENCE_OUTPUT_BYTES
    ):
        raise PublicError(failure_message)
    return completed.stdout


def _parse_image_commentary(
    stdout: bytes,
    image_path: Path,
) -> dict[str, str | bool]:
    try:
        envelope = json.loads(stdout.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError, TypeError) as error:
        raise PublicError("Camera image analysis failed") from error
    if (
        not isinstance(envelope, dict)
        or envelope.get("ok") is not True
        or envelope.get("capability") != "image.describe"
        or envelope.get("transport") != "local"
        or envelope.get("provider") != VISION_PROVIDER
        or envelope.get("model") != VISION_MODEL_NAME
    ):
        raise PublicError("Camera image analysis failed")
    outputs = envelope.get("outputs")
    if (
        not isinstance(outputs, list)
        or len(outputs) != 1
        or not isinstance(outputs[0], dict)
    ):
        raise PublicError("Camera image analysis failed")
    output = outputs[0]
    if (
        output.get("kind") != "image.description"
        or output.get("provider") != VISION_PROVIDER
        or output.get("model") != VISION_MODEL_NAME
        or not isinstance(output.get("path"), str)
    ):
        raise PublicError("Camera image analysis failed")
    try:
        returned_path = Path(output["path"]).resolve(strict=True)
        expected_path = image_path.resolve(strict=True)
    except OSError as error:
        raise PublicError("Camera image analysis failed") from error
    if returned_path != expected_path:
        raise PublicError("Camera image analysis failed")
    text_value = output.get("text")
    if (
        not isinstance(text_value, str)
        or not text_value
        or len(text_value.encode("utf-8")) > MAX_INFERENCE_TEXT_BYTES
    ):
        raise PublicError("Camera image analysis failed")
    try:
        value = json.loads(text_value)
    except json.JSONDecodeError as error:
        raise PublicError("Camera image analysis failed") from error
    if (
        not isinstance(value, dict)
        or set(value) != {"category", "confidence", "notable", "summary"}
        or value.get("category") not in VISION_CATEGORIES
        or value.get("confidence") not in VISION_CONFIDENCE
        or type(value.get("notable")) is not bool
        or not isinstance(value.get("summary"), str)
    ):
        raise PublicError("Camera image analysis failed")
    summary = value["summary"]
    if (
        not 1 <= len(summary) <= MAX_COMMENTARY_CHARACTERS
        or summary != summary.strip()
        or CONTROL_CHARACTER_PATTERN.search(summary)
        or URL_PATTERN.search(summary)
    ):
        raise PublicError("Camera image analysis failed")
    return {
        "category": value["category"],
        "confidence": value["confidence"],
        "notable": value["notable"],
        "summary": summary,
    }


def analyze_image(
    token: str,
    *,
    media_directory: Path | None = None,
    command_runner: Callable[..., bytes] = _run_bounded_command,
) -> dict[str, str | bool]:
    image_path = _validated_media_path(
        token,
        media_directory=media_directory,
    )
    stdout = command_runner(
        [
            str(OPENCLAW_BINARY),
            "--no-color",
            "infer",
            "image",
            "describe",
            "--file",
            str(image_path),
            "--model",
            VISION_MODEL,
            "--prompt",
            VISION_PROMPT,
            "--timeout-ms",
            "60000",
            "--json",
        ],
        timeout=INFERENCE_TIMEOUT_SECONDS,
        failure_message="Camera image analysis failed",
    )
    commentary = _parse_image_commentary(stdout, image_path)
    _validated_media_path(token, media_directory=media_directory)
    return commentary


def _secrets_cache_path() -> Path:
    return Path.home() / ".openclaw" / ".secrets-cache"


def _read_owner_chat_id(
    recipient: str,
    *,
    secrets_cache: Path | None = None,
) -> tuple[str, str]:
    selected = OWNER_RECIPIENTS.get(recipient)
    if selected is None:
        raise PublicError("Camera image recipient is invalid")
    display_name, key = selected
    path = secrets_cache or _secrets_cache_path()
    parent_metadata = _private_directory_metadata(
        path.parent, "OpenClaw secrets directory"
    )
    named_metadata = _file_metadata(path, "OpenClaw owner routing")
    if named_metadata.st_size > MAX_SECRETS_CACHE_BYTES:
        raise PublicError("OpenClaw owner routing is unavailable")
    flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0)
    try:
        descriptor = os.open(path, flags)
    except OSError as error:
        raise PublicError("OpenClaw owner routing is unavailable") from error
    try:
        opened = os.fstat(descriptor)
        current_parent = path.parent.lstat()
        if (
            not stat.S_ISREG(opened.st_mode)
            or opened.st_uid != os.geteuid()
            or stat.S_IMODE(opened.st_mode) != 0o600
            or opened.st_nlink != 1
            or opened.st_size != named_metadata.st_size
            or (opened.st_dev, opened.st_ino)
            != (named_metadata.st_dev, named_metadata.st_ino)
            or (current_parent.st_dev, current_parent.st_ino)
            != (parent_metadata.st_dev, parent_metadata.st_ino)
        ):
            raise PublicError("OpenClaw owner routing is unavailable")
        chunks: list[bytes] = []
        remaining = MAX_SECRETS_CACHE_BYTES + 1
        while remaining:
            chunk = os.read(descriptor, min(64 * 1024, remaining))
            if not chunk:
                break
            chunks.append(chunk)
            remaining -= len(chunk)
        payload = b"".join(chunks)
        after_read = os.fstat(descriptor)
        if (
            len(payload) != opened.st_size
            or after_read.st_size != opened.st_size
            or after_read.st_mtime_ns != opened.st_mtime_ns
        ):
            raise PublicError("OpenClaw owner routing is unavailable")
    except OSError as error:
        raise PublicError("OpenClaw owner routing is unavailable") from error
    finally:
        os.close(descriptor)
    prefix = key.encode("ascii") + b"="
    matches = [line for line in payload.splitlines() if line.startswith(prefix)]
    if len(matches) != 1:
        raise PublicError("OpenClaw owner routing is unavailable")
    match = CHAT_ID_ASSIGNMENT_PATTERN.fullmatch(matches[0])
    if match is None:
        raise PublicError("OpenClaw owner routing is unavailable")
    return display_name, match.group(1).decode("ascii")


def _deliver_owner_image(
    recipient: str,
    token: str,
    caption: str,
    *,
    media_directory: Path | None = None,
    secrets_cache: Path | None = None,
    command_runner: Callable[..., bytes] = _run_bounded_command,
) -> tuple[str, bool]:
    if (
        not isinstance(caption, str)
        or not 1 <= len(caption) <= MAX_COMMENTARY_CHARACTERS + 100
        or caption != caption.strip()
        or CONTROL_CHARACTER_PATTERN.search(caption)
        or URL_PATTERN.search(caption)
    ):
        raise PublicError("Camera image delivery failed")
    image_path = _validated_media_path(
        token,
        media_directory=media_directory,
    )
    display_name, chat_id = _read_owner_chat_id(
        recipient,
        secrets_cache=secrets_cache,
    )
    group_stdout = command_runner(
        [
            str(IMSG_BINARY),
            "group",
            "--chat-id",
            chat_id,
            "--json",
        ],
        timeout=DELIVERY_TIMEOUT_SECONDS,
        failure_message="Camera image delivery failed",
    )
    try:
        lines = group_stdout.decode("utf-8").splitlines()
        if len(lines) != 1 or not lines[0]:
            raise ValueError("invalid route receipt line count")
        route = json.loads(
            lines[0],
            object_pairs_hook=_reject_duplicate_keys,
        )
    except (
        UnicodeDecodeError,
        json.JSONDecodeError,
        TypeError,
        ValueError,
    ) as error:
        raise PublicError("Camera image delivery failed") from error
    required_route_keys = {
        "id",
        "identifier",
        "guid",
        "name",
        "service",
        "is_group",
        "participants",
    }
    allowed_route_keys = required_route_keys | {
        "account_id",
        "account_login",
        "last_addressed_handle",
    }
    if (
        not isinstance(route, dict)
        or not required_route_keys.issubset(route)
        or not set(route).issubset(allowed_route_keys)
        or isinstance(route.get("id"), bool)
        or route.get("id") != int(chat_id)
        or route.get("service") != "iMessage"
        or not isinstance(route.get("identifier"), str)
        or not isinstance(route.get("name"), str)
        or not isinstance(route.get("is_group"), bool)
        or not isinstance(route.get("participants"), list)
        or any(not isinstance(item, str) for item in route["participants"])
        or not isinstance(route.get("guid"), str)
        or not 1 <= len(route["guid"]) <= MAX_IMSG_GUID_CHARACTERS
        or not route["guid"].startswith(
            (
                "any;+;" if route["is_group"] else "any;-;",
                "iMessage;+;" if route["is_group"] else "iMessage;-;",
            )
        )
        or CONTROL_CHARACTER_PATTERN.search(route["guid"])
    ):
        raise PublicError("Camera image delivery failed")
    chat_guid = route["guid"]
    attachment_stdout = command_runner(
        [
            str(IMSG_BINARY),
            "send-attachment",
            "--chat",
            chat_guid,
            "--file",
            str(image_path),
            "--transport",
            "dylib",
            "--json",
        ],
        timeout=DELIVERY_TIMEOUT_SECONDS,
        failure_message="Camera image delivery failed",
    )
    try:
        lines = attachment_stdout.decode("utf-8").splitlines()
        if len(lines) != 1 or not lines[0]:
            raise ValueError("invalid attachment receipt line count")
        attachment_receipt = json.loads(
            lines[0],
            object_pairs_hook=_reject_duplicate_keys,
        )
    except (
        UnicodeDecodeError,
        json.JSONDecodeError,
        TypeError,
        ValueError,
    ) as error:
        raise PublicError("Camera image delivery failed") from error
    if (
        not isinstance(attachment_receipt, dict)
        or set(attachment_receipt)
        != {"chatGuid", "messageGuid", "selectedMessageGuid", "transferGuid"}
        or any(not isinstance(value, str) for value in attachment_receipt.values())
        or attachment_receipt.get("chatGuid") != chat_guid
        or attachment_receipt.get("selectedMessageGuid") != ""
        or not 1
        <= len(attachment_receipt.get("transferGuid", ""))
        <= MAX_IMSG_GUID_CHARACTERS
        or len(attachment_receipt.get("messageGuid", ""))
        > MAX_IMSG_GUID_CHARACTERS
        or any(
            CONTROL_CHARACTER_PATTERN.search(value)
            for value in attachment_receipt.values()
        )
    ):
        raise PublicError("Camera image delivery failed")
    request = {
        "jsonrpc": "2.0",
        "id": IMSG_RPC_REQUEST_ID,
        "method": "send",
        "params": {
            "chat_guid": chat_guid,
            "text": caption,
            "transport": "bridge",
        },
    }
    encoded_request = (
        json.dumps(
            request,
            separators=(",", ":"),
            ensure_ascii=False,
        ).encode("utf-8")
        + b"\n"
    )
    try:
        stdout = command_runner(
            [
                str(IMSG_BINARY),
                "rpc",
            ],
            timeout=DELIVERY_TIMEOUT_SECONDS,
            failure_message="Camera image commentary delivery failed",
            stdin_data=encoded_request,
        )
        lines = stdout.decode("utf-8").splitlines()
        if len(lines) != 1 or not lines[0]:
            raise ValueError("invalid receipt line count")
        receipt = json.loads(
            lines[0],
            object_pairs_hook=_reject_duplicate_keys,
        )
    except (
        UnicodeDecodeError,
        json.JSONDecodeError,
        TypeError,
        ValueError,
        PublicError,
    ):
        return display_name, False
    if (
        not isinstance(receipt, dict)
        or set(receipt) != {"jsonrpc", "id", "result"}
        or receipt.get("jsonrpc") != "2.0"
        or receipt.get("id") != IMSG_RPC_REQUEST_ID
        or not isinstance(receipt.get("result"), dict)
        or receipt["result"].get("ok") is not True
        or receipt["result"].get("transport") != "bridge"
        or receipt["result"].get("chat_guid") != chat_guid
        or any(not isinstance(key, str) for key in receipt["result"])
    ):
        return display_name, False
    return display_name, True


def share_image(
    alias: str,
    recipient: str,
    *,
    media_directory: Path | None = None,
    secrets_cache: Path | None = None,
    capture_function: Callable[..., dict[str, str]] = capture_image,
    analysis_function: Callable[..., dict[str, str | bool]] = analyze_image,
    delivery_function: Callable[..., tuple[str, bool]] = _deliver_owner_image,
) -> dict[str, str | bool]:
    if recipient not in OWNER_RECIPIENTS:
        raise PublicError("Camera image recipient is invalid")
    capture = capture_function(alias, media_directory=media_directory)
    if (
        not isinstance(capture, dict)
        or set(capture) != {"alias", "mediaPath", "cleanupToken"}
        or capture.get("alias") != alias
        or not isinstance(capture.get("cleanupToken"), str)
        or not TOKEN_PATTERN.fullmatch(capture["cleanupToken"])
    ):
        raise PublicError("Camera image sharing failed")
    token = capture["cleanupToken"]
    try:
        commentary = analysis_function(
            token,
            media_directory=media_directory,
        )
        summary = commentary.get("summary")
        if not isinstance(summary, str):
            raise PublicError("Camera image sharing failed")
        caption = f"{alias} — {summary}"
        delivery_result = delivery_function(
            recipient,
            token,
            caption,
            media_directory=media_directory,
            secrets_cache=secrets_cache,
        )
        if (
            not isinstance(delivery_result, tuple)
            or len(delivery_result) != 2
            or not isinstance(delivery_result[0], str)
            or not delivery_result[0]
            or not isinstance(delivery_result[1], bool)
        ):
            raise PublicError("Camera image sharing failed")
        display_name, commentary_delivered = delivery_result
        return {
            "alias": alias,
            "delivered": True,
            "commentaryDelivered": commentary_delivered,
            "recipient": display_name,
            **commentary,
        }
    except PublicError:
        raise
    except Exception as error:
        raise PublicError("Camera image sharing failed") from error
    finally:
        cleanup_image(token, media_directory=media_directory)


def _ensure_private_runtime_directory(path: Path) -> None:
    if path.exists() or path.is_symlink():
        _private_directory_metadata(path, "Camera configuration directory")
        return
    try:
        path.mkdir(mode=0o700, parents=True, exist_ok=False)
        path.chmod(0o700)
    except OSError as error:
        raise PublicError("Camera configuration directory is unavailable") from error
    _private_directory_metadata(path, "Camera configuration directory")


def _write_private_json(path: Path, payload: dict[str, Any]) -> Path:
    descriptor, temporary_name = tempfile.mkstemp(
        prefix=f".{path.name}.",
        dir=path.parent,
    )
    temporary = Path(temporary_name)
    completed = False
    try:
        os.fchmod(descriptor, 0o600)
        encoded = (
            json.dumps(
                payload,
                sort_keys=True,
                separators=(",", ":"),
                ensure_ascii=False,
            )
            + "\n"
        ).encode("utf-8")
        if len(encoded) > MAX_PRIVATE_JSON_BYTES:
            raise PublicError("Camera configuration is too large")
        offset = 0
        while offset < len(encoded):
            written = os.write(descriptor, encoded[offset:])
            if written <= 0:
                raise OSError("short write")
            offset += written
        os.fsync(descriptor)
        os.close(descriptor)
        descriptor = -1
        completed = True
        return temporary
    except PublicError:
        raise
    except OSError as error:
        raise PublicError("Camera configuration could not be saved") from error
    finally:
        if descriptor >= 0:
            os.close(descriptor)
        if not completed:
            try:
                temporary.unlink()
            except FileNotFoundError:
                pass


def _activate_registry_pair(
    config: dict[str, Any],
    credentials: dict[str, Any],
    *,
    config_path: Path,
    credentials_path: Path,
) -> None:
    _ensure_private_runtime_directory(config_path.parent)
    if credentials_path.parent != config_path.parent:
        raise PublicError("Camera configuration paths are invalid")
    config_temporary: Path | None = None
    credentials_temporary: Path | None = None
    try:
        config_temporary = _write_private_json(config_path, config)
        credentials_temporary = _write_private_json(
            credentials_path, credentials
        )
        os.replace(credentials_temporary, credentials_path)
        credentials_temporary = None
        os.chmod(credentials_path, 0o600)
        os.replace(config_temporary, config_path)
        config_temporary = None
        os.chmod(config_path, 0o600)
        directory_descriptor = os.open(
            config_path.parent,
            os.O_RDONLY | getattr(os, "O_DIRECTORY", 0),
        )
        try:
            os.fsync(directory_descriptor)
        finally:
            os.close(directory_descriptor)
    except PublicError:
        raise
    except OSError as error:
        raise PublicError("Camera configuration could not be saved") from error
    finally:
        for temporary in (config_temporary, credentials_temporary):
            if temporary is not None:
                try:
                    temporary.unlink()
                except FileNotFoundError:
                    pass


def probe_tls_fingerprint(host: str, port: int) -> str:
    validated_host = _validate_private_host(host)
    validated_port = _validate_port(port)
    try:
        with socket.create_connection(
            (validated_host, validated_port),
            timeout=REQUEST_TIMEOUT_SECONDS,
        ) as raw_socket:
            with _tls_context().wrap_socket(raw_socket) as tls_socket:
                certificate = tls_socket.getpeercert(binary_form=True)
    except (OSError, TimeoutError, socket.timeout, ssl.SSLError) as error:
        raise PublicError("Camera TLS endpoint is unavailable") from error
    if not isinstance(certificate, bytes) or not certificate:
        raise PublicError("Camera TLS endpoint is unavailable")
    return hashlib.sha256(certificate).hexdigest()


def _parse_operator_enroll(arguments: list[str]) -> dict[str, Any]:
    if not arguments:
        return {"replace": False}
    if arguments == ["--replace"]:
        return {"replace": True}
    raise PublicError("Operator enrollment arguments are invalid")


def _read_operator_value(
    reader: Callable[[str], str],
