#!/usr/bin/env bash
# petlibro — control Petlibro smart pet devices at Crosstown + Cabin

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
API_SCRIPT="$SCRIPT_DIR/petlibro-api.py"
PYTHON="/usr/bin/python3"

JSON_OUTPUT=false
if [[ "${1:-}" == "--json" ]]; then
  JSON_OUTPUT=true
  shift
elif (( $# > 0 )) && [[ "${!#}" == "--json" ]]; then
  JSON_OUTPUT=true
  args=("$@")
  unset "args[$(($# - 1))]"
  set -- "${args[@]}"
fi

if [[ "$JSON_OUTPUT" == true ]]; then
  # Preserve the public wrapper's explicit-portion safety contract even when
  # a machine caller requests structured output.
  if [[ "${1:-}" == "feed" ]] && { [[ $# -ne 3 ]] || [[ ! "$3" =~ ^[1-3]$ ]]; }; then
    printf '%s\n' '{"success":false,"error":"invalid_arguments","message":"Usage: petlibro feed <crosstown-feeder|cabin-feeder> <1|2|3>"}'
    exit 2
  fi
  if [[ "${1:-}" == "schedule-set" ]] && {
    [[ $# -ne 3 ]] ||
    [[ ! "${2:-}" =~ ^(crosstown-feeder|cabin-feeder)$ ]] ||
    [[ ! "${3:-}" =~ ^(on|off)$ ]]
  }; then
    printf '%s\n' '{"success":false,"error":"invalid_arguments","message":"Usage: petlibro schedule-set <crosstown-feeder|cabin-feeder> <on|off>"}'
    exit 2
  fi
  if [[ "${1:-}" == "schedule-state" ]] && {
    [[ $# -ne 2 ]] ||
    [[ ! "${2:-}" =~ ^(crosstown-feeder|cabin-feeder)$ ]]
  }; then
    printf '%s\n' '{"success":false,"error":"invalid_arguments","message":"Usage: petlibro schedule-state <crosstown-feeder|cabin-feeder>"}'
    exit 2
  fi
  if [[ "${1:-}" == "feeding-history" ]] && {
    [[ $# -lt 2 ]] ||
    [[ $# -gt 3 ]] ||
    [[ ! "${2:-}" =~ ^(crosstown-feeder|cabin-feeder)$ ]] ||
    { [[ $# -eq 3 ]] && [[ ! "${3:-}" =~ ^([1-9]|1[0-9]|2[0-5])$ ]]; }
  }; then
    printf '%s\n' '{"success":false,"error":"invalid_arguments","message":"Usage: petlibro feeding-history <crosstown-feeder|cabin-feeder> [1-25]"}'
    exit 2
  fi
  exec "$PYTHON" "$API_SCRIPT" "$@"
fi

run_api() { "$PYTHON" "$API_SCRIPT" "$@" 2>&1; }

parse_status() {
  python3 -c "
import sys, json
try:
    devices = json.loads(sys.stdin.read())
except:
    print('Error: Could not parse response')
    sys.exit(1)
if isinstance(devices, dict) and 'error' in devices:
    print(f'Error: {devices.get(\"message\", devices.get(\"error\"))}')
    sys.exit(1)
for d in devices:
    name = d.get('name', '?')
    selector = d.get('selector', 'unmapped')
    online = 'Online' if d.get('online') else 'Offline'
    print(f'{selector}: {name} ({d.get(\"model\", \"?\")}) — {online}')
    if d.get('type') == 'feeder':
        food = d.get('foodLevel', '?')
        nxt = d.get('nextFeedTime', '?')
        portions = d.get('nextFeedPortions', '?')
        print(f'  Food Level:  {food}')
        print(f'  Next Feed:   {nxt} ({portions} portions)')
        schedule = d.get('scheduleEnabled')
        label = 'Enabled' if schedule is True else 'Disabled' if schedule is False else 'Unavailable'
        print(f'  Schedule:    {label}')
        bowl = d.get('bowlMode')
        if bowl:
            print(f'  Bowl Mode:   {bowl}')
    elif d.get('type') == 'fountain':
        pct = d.get('waterPercent', '?')
        wt = d.get('waterWeight', '?')
        today = d.get('todayDrinkMl', '?')
        batt = d.get('battery', '?')
        bstate = d.get('batteryState', '?')
        filt = d.get('filterDaysRemaining', '?')
        print(f'  Water Level: {pct}% ({wt}g)')
        print(f'  Today Drunk: {today} mL')
        print(f'  Battery:     {batt}% ({bstate})')
        if isinstance(filt, int) and filt < 0:
            print(f'  Filter:      OVERDUE by {abs(filt)} days')
        else:
            print(f'  Filter:      {filt} days remaining')
    print()
"
}

parse_feed() {
  python3 -c "
import sys, json
try:
    d = json.loads(sys.stdin.read())
except:
    print('Error: Could not parse response')
    sys.exit(1)
if 'error' in d:
    print(f'Error: {d.get(\"message\", d.get(\"error\"))}')
    sys.exit(1)
print(f'{d.get(\"device\", \"?\")}: Fed {d.get(\"portions\", \"?\")} portion(s)')
print(f'  Request: {d.get(\"request_id\", \"recorded\")}')
"
}

parse_water() {
  python3 -c "
import sys, json
try:
    d = json.loads(sys.stdin.read())
except:
    print('Error: Could not parse response')
    sys.exit(1)
if 'error' in d:
    print(f'Error: {d.get(\"message\", d.get(\"error\"))}')
    sys.exit(1)
total = d.get('totalMl', d.get('todayTotalMl', '?'))
count = d.get('drinkCount', d.get('todayCount', '?'))
avg = d.get('avgMl', '?')
print(f'Today: {total} mL across {count} drink(s)')
if avg != '?':
    print(f'Average: {avg} mL per drink')
"
}

parse_schedule_set() {
  python3 -c "
import sys, json
try:
    d = json.loads(sys.stdin.read())
except:
    print('Error: Could not parse response')
    sys.exit(1)
if 'error' in d:
    print(f'Error: {d.get(\"message\", d.get(\"error\"))}')
    sys.exit(1)
state = 'Enabled' if d.get('scheduleEnabled') else 'Disabled'
print(f'{d.get(\"device\", \"?\")}: Scheduled feeding {state.lower()} and verified')
if not d.get('mutation_attempted', True):
    print('  No change was needed')
elif d.get('request_id'):
    print(f'  Request: {d.get(\"request_id\")}')
"
}

case "${1:-}" in
  status)
    if [[ $# -ne 1 ]]; then
      echo "Usage: petlibro status" >&2
      exit 2
    fi
    run_api status | parse_status
    ;;
  feed)
    if [[ $# -ne 3 ]]; then
      echo "Usage: petlibro feed <crosstown-feeder|cabin-feeder> <1|2|3>" >&2
      echo "  An explicit portion count is required; repeated feeds are cooldown-protected" >&2
      exit 2
    fi
    if [[ ! "$3" =~ ^[1-3]$ ]]; then
      echo "Usage: petlibro feed <crosstown-feeder|cabin-feeder> <1|2|3>" >&2
      exit 2
    fi
    run_api feed "$2" "$3" | parse_feed
    ;;
  water)
    if [[ $# -ne 2 ]]; then
      echo "Usage: petlibro water <crosstown-fountain|cabin-fountain>" >&2
      exit 2
    fi
    run_api water "$2" | parse_water
    ;;
  schedule)
    if [[ $# -ne 2 ]]; then
      echo "Usage: petlibro schedule <crosstown-feeder|cabin-feeder>" >&2
      exit 2
    fi
    run_api schedule "$2" | python3 -m json.tool
    ;;
  schedule-set)
    if [[ $# -ne 3 ]] ||
      [[ ! "${2:-}" =~ ^(crosstown-feeder|cabin-feeder)$ ]] ||
      [[ ! "${3:-}" =~ ^(on|off)$ ]]; then
      echo "Usage: petlibro schedule-set <crosstown-feeder|cabin-feeder> <on|off>" >&2
      exit 2
    fi
    run_api schedule-set "$2" "$3" | parse_schedule_set
    ;;
  schedule-state)
    if [[ $# -ne 2 ]] ||
      [[ ! "${2:-}" =~ ^(crosstown-feeder|cabin-feeder)$ ]]; then
      echo "Usage: petlibro schedule-state <crosstown-feeder|cabin-feeder>" >&2
      exit 2
    fi
    run_api schedule-state "$2" | python3 -m json.tool
    ;;
  feeding-history)
    if [[ $# -lt 2 ]] ||
      [[ $# -gt 3 ]] ||
      [[ ! "${2:-}" =~ ^(crosstown-feeder|cabin-feeder)$ ]] ||
      { [[ $# -eq 3 ]] && [[ ! "${3:-}" =~ ^([1-9]|1[0-9]|2[0-5])$ ]]; }; then
      echo "Usage: petlibro feeding-history <crosstown-feeder|cabin-feeder> [1-25]" >&2
      exit 2
    fi
    run_api feeding-history "$2" "${3:-14}" | python3 -m json.tool
    ;;
  devices)
    if [[ $# -ne 1 ]]; then
      echo "Usage: petlibro devices" >&2
      exit 2
    fi
    run_api devices | python3 -m json.tool
    ;;
  *)
    echo "Usage: petlibro <command>"
    echo ""
    echo "Commands:"
    echo "  status                  All devices summary"
    echo "  feed <location-feeder> <1|2|3>     Manual feed (explicit portions required)"
    echo "  water <location-fountain>          Today's water intake"
    echo "  schedule <location-feeder>         Today's feeding schedule"
    echo "  schedule-state <location-feeder>   Sanitized schedule readiness"
    echo "  feeding-history <location-feeder> [1-25]  Successful scheduled feedings"
    echo "  schedule-set <location-feeder> <on|off>  Pause or resume all scheduled feeding"
    echo "  devices                 List all devices"
    echo ""
    echo "Exact selectors: crosstown-feeder, crosstown-fountain, cabin-feeder, cabin-fountain"
    exit 1
    ;;
esac
