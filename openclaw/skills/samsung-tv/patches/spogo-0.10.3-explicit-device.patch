+package spotify
+
+import (
+	"context"
+	"net/http"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestExplicitTargetOverridesActiveAndCachedRoute(t *testing.T) {
+	commands := map[string]func(*ConnectClient) error{
+		"play":     func(c *ConnectClient) error { return c.Play(context.Background(), "spotify:track:test") },
+		"pause":    func(c *ConnectClient) error { return c.Pause(context.Background()) },
+		"next":     func(c *ConnectClient) error { return c.Next(context.Background()) },
+		"previous": func(c *ConnectClient) error { return c.Previous(context.Background()) },
+		"seek":     func(c *ConnectClient) error { return c.Seek(context.Background(), 1000) },
+		"shuffle":  func(c *ConnectClient) error { return c.Shuffle(context.Background(), true) },
+		"repeat":   func(c *ConnectClient) error { return c.Repeat(context.Background(), "off") },
+		"volume":   func(c *ConnectClient) error { return c.Volume(context.Background(), 20) },
+	}
+	for name, command := range commands {
+		t.Run(name, func(t *testing.T) {
+			writes := 0
+			client := newRegisteredConnectClientForTests(roundTripperFunc(func(req *http.Request) (*http.Response, error) {
+				if strings.Contains(req.URL.Path, "/devices/hobs_") {
+					return jsonResponse(200, map[string]any{
+						"devices":          map[string]any{"frame": map[string]any{"name": "Frame"}, "other": map[string]any{"name": "Phone"}},
+						"active_device_id": "other",
+					}), nil
+				}
+				writes++
+				if !strings.HasSuffix(req.URL.Path, "/to/frame") {
+					t.Fatalf("wrong target: %s", req.URL.Path)
+				}
+				return textResponse(200, "ok"), nil
+			}))
+			client.device = "frame"
+			client.cachedActiveDeviceID = "other"
+			client.cachedOriginDeviceID = "controller"
+			client.cachedRouteAt = time.Now()
+			if err := command(client); err != nil {
+				t.Fatal(err)
+			}
+			if writes != 1 {
+				t.Fatalf("writes=%d", writes)
+			}
+		})
+	}
+}
+
+func TestExplicitTargetFailsClosed(t *testing.T) {
+	for _, test := range []struct {
+		name, selector string
+		devices        map[string]any
+	}{
+		{"missing", "missing", map[string]any{"other": map[string]any{"name": "Phone"}}},
+		{"ambiguous", "Frame", map[string]any{"a": map[string]any{"name": "Frame"}, "b": map[string]any{"name": "Frame"}}},
+		{"restricted", "frame", map[string]any{"frame": map[string]any{"name": "Frame", "is_restricted": true}}},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			for _, command := range []func(*ConnectClient) error{
+				func(c *ConnectClient) error { return c.Play(context.Background(), "spotify:track:test") },
+				func(c *ConnectClient) error { return c.Pause(context.Background()) },
+				func(c *ConnectClient) error { return c.Volume(context.Background(), 20) },
+			} {
+				client := newRegisteredConnectClientForTests(roundTripperFunc(func(req *http.Request) (*http.Response, error) {
+					if strings.Contains(req.URL.Path, "/devices/hobs_") {
+						return jsonResponse(200, map[string]any{"devices": test.devices, "active_device_id": "other"}), nil
+					}
+					t.Fatalf("unexpected command/fallback: %s", req.URL.Path)
+					return nil, nil
+				}))
+				client.device = test.selector
+				if err := command(client); err == nil {
+					t.Fatal("expected failure")
+				}
+			}
+		})
+	}
+}
+
+func TestExplicitTargetDoesNotFalsifyPlaybackStatus(t *testing.T) {
+	client := newRegisteredConnectClientForTests(roundTripperFunc(func(req *http.Request) (*http.Response, error) {
+		return jsonResponse(200, map[string]any{"devices": map[string]any{"frame": map[string]any{"name": "Frame"}, "other": map[string]any{"name": "Phone"}}, "active_device_id": "other", "player_state": map[string]any{"is_paused": true}}), nil
+	}))
+	client.device = "frame"
+	status, err := client.Playback(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if status.Device.ID != "other" {
+		t.Fatal("status must reflect actual active device")
+	}
+}
