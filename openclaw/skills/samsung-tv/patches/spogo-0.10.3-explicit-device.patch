+// explicitTargetState preserves read-only playback reporting while routing writes
+// to the requested device. Missing/ambiguous/restricted targets never fall back.
+func (c *ConnectClient) explicitTargetState(state connectState) (connectState, error) {
+	selector := strings.TrimSpace(c.device)
+	if selector == "" {
+		return state, nil
+	}
+	devices := mapDevices(state)
+	var matches []Device
+	for _, device := range devices {
+		if device.ID == selector {
+			matches = []Device{device}
+			break
+		}
+		if strings.EqualFold(device.Name, selector) {
+			matches = append(matches, device)
+		}
+	}
+	if len(matches) != 1 || matches[0].ID == "" {
+		return state, errors.New("explicit device is missing or ambiguous; no playback command sent")
+	}
+	if matches[0].Restricted {
+		return state, errors.New("explicit device is restricted; no playback command sent")
+	}
+	state.activeDeviceID = matches[0].ID
+	return state, nil
+}
