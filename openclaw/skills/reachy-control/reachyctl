#!/usr/bin/env bash
# reachyctl — constrained OpenClaw control for the Crosstown Reachy Mini
set -o pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
media_helper="$script_dir/scripts/reachy_media.py"

usage() {
  echo 'usage: reachyctl status|presets|see|capture|cleanup <token>|stop|idle|mute|unmute|look <direction>|emotion <preset>|dance <preset>|speak <text>' >&2
  exit 2
}

case "${1:-}" in
  status|presets|see|stop|idle|mute|unmute)
    [[ "$#" -eq 1 ]] || usage
    ;;
  look)
    [[ "$#" -eq 2 ]] || usage
    case "$2" in left|right|up|down|front) ;; *) usage ;; esac
    ;;
  emotion)
    [[ "$#" -eq 2 ]] || usage
    [[ "$2" =~ ^[a-z0-9_-]+$ ]] || usage
    ;;
  dance)
    [[ "$#" -eq 2 ]] || usage
    [[ "$2" =~ ^[a-z0-9_-]+$ ]] || usage
    ;;
  speak)
    [[ "$#" -ge 2 ]] || usage
    shift
    encoded_text="$(printf '%s' "$*" | base64 | tr -d '\n')"
    set -- speak-b64 "$encoded_text"
    ;;
  speak-b64)
    # Internal transport form used by the Mac mini -> MBP relay. The first
    # wrapper has already encoded the text so SSH cannot split it; validate and
    # forward it unchanged instead of trying to encode it a second time.
    [[ "$#" -eq 2 ]] || usage
    [[ -n "$2" && "$2" =~ ^[A-Za-z0-9+/]*={0,2}$ ]] || usage
    ;;
  capture)
    [[ "$#" -eq 1 ]] || usage
    exec /usr/bin/python3 "$media_helper" capture
    ;;
  cleanup)
    [[ "$#" -eq 2 ]] || usage
    exec /usr/bin/python3 "$media_helper" cleanup "$2"
    ;;
  capture-stream)
    [[ "$#" -eq 1 ]] || usage
    exec /usr/bin/python3 "$media_helper" capture-stream
    ;;
  *) usage ;;
esac

relay_file="${REACHY_CONTROL_RELAY_FILE:-$HOME/.openclaw/reachy-control-relay}"
if [[ -r "$relay_file" ]]; then
  IFS= read -r relay_host < "$relay_file"
  if [[ ! "$relay_host" =~ ^[A-Za-z0-9._-]+(@[A-Za-z0-9._:-]+)?$ ]]; then
    echo "reachyctl: invalid relay host in $relay_file" >&2
    exit 1
  fi
  exec ssh \
    -o BatchMode=yes \
    -o ConnectTimeout=8 \
    -o IdentityAgent=none \
    -o StrictHostKeyChecking=yes \
    "$relay_host" \
    "$HOME/.openclaw/bin/reachyctl" "$@"
fi

exec ssh \
  -i "$HOME/.ssh/openclaw-reachy" \
  -o BatchMode=yes \
  -o ConnectTimeout=8 \
  -o IdentityAgent=none \
  -o StrictHostKeyChecking=yes \
  pollen@192.168.165.129 \
  /home/pollen/clawbody/bin/clawbody-control "$@"
