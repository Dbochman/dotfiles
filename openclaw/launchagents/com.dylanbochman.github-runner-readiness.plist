<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>com.dylanbochman.github-runner-readiness</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/python3</string>
        <string>/Users/dbochman/.local/libexec/github-runner-readiness.py</string>
    </array>
    <key>StartInterval</key><integer>3600</integer>
    <key>RunAtLoad</key><true/>
    <key>ProcessType</key><string>Background</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key><string>/Users/dbochman</string>
        <key>PATH</key><string>/opt/homebrew/bin:/usr/bin:/bin</string>
    </dict>
    <key>StandardOutPath</key><string>/Users/dbochman/.local/state/github-runner-readiness/launchd.log</string>
    <key>StandardErrorPath</key><string>/Users/dbochman/.local/state/github-runner-readiness/launchd.err.log</string>
</dict>
</plist>
