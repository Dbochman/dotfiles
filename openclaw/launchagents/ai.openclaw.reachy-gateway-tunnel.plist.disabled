<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Rollback-only: copy to a .plist path and enable explicitly before loading. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ai.openclaw.reachy-gateway-tunnel</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/ssh</string>
        <string>-NT</string>
        <string>-i</string>
        <string>/Users/dbochman/.ssh/openclaw-reachy</string>
        <string>-o</string>
        <string>BatchMode=yes</string>
        <string>-o</string>
        <string>ExitOnForwardFailure=yes</string>
        <string>-o</string>
        <string>IdentityAgent=none</string>
        <string>-o</string>
        <string>ServerAliveInterval=30</string>
        <string>-o</string>
        <string>ServerAliveCountMax=3</string>
        <string>-o</string>
        <string>StrictHostKeyChecking=yes</string>
        <string>-R</string>
        <string>127.0.0.1:18789:127.0.0.1:18789</string>
        <string>pollen@192.168.165.129</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/dbochman</string>
    </dict>
    <key>KeepAlive</key>
    <true/>
    <key>RunAtLoad</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>ProcessType</key>
    <string>Background</string>
    <key>StandardOutPath</key>
    <string>/Users/dbochman/.openclaw/logs/reachy-gateway-tunnel.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/dbochman/.openclaw/logs/reachy-gateway-tunnel.log</string>
</dict>
</plist>
