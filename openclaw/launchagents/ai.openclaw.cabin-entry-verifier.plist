<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ai.openclaw.cabin-entry-verifier</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/dbochman/.openclaw/bin/cabin-entry-verifier-wrapper.sh</string>
    <string>run</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/dbochman</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>CABIN_ENTRY_MODE</key>
    <string>ring-kitchen-verification</string>
    <key>HOME_EVENTS_ROOT</key>
    <string>/Users/dbochman/.openclaw/home-events</string>
    <key>CABIN_ENTRY_STATE_DIR</key>
    <string>/Users/dbochman/.openclaw/cabin-entry-verifier</string>
    <key>CABIN_ENTRY_DATABASE</key>
    <string>/Users/dbochman/.openclaw/cabin-entry-verifier/state.sqlite3</string>
