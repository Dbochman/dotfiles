scope=$1
script=$2
log=$3
status=$4
runner_pid=$5
job=$6
owner=$7
resources=$8
dependencies=$9
runner_sha=${10}
exec > >(tee -a "$log") 2>&1
tmp_pid="${runner_pid}.tmp.$$"
printf '%s\n' "$$" > "$tmp_pid"
mv -f "$tmp_pid" "$runner_pid"
export OPENCLAW_JOB_NAME="$job"
export OPENCLAW_JOB_OWNER="$owner"
export OPENCLAW_JOB_RESOURCES_JSON="$resources"
export OPENCLAW_JOB_DEPENDENCIES_JSON="$dependencies"
export OPENCLAW_RUNNER_SHA256="$runner_sha"
export OPENCLAW_JOB_STATE_DIR="$(dirname -- "$status")"
export OPENCLAW_NATIVE_PID_FILE="$OPENCLAW_JOB_STATE_DIR/standalone-native-process.json"
rm -f -- "$OPENCLAW_NATIVE_PID_FILE"
printf 'desktop-compute started %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
