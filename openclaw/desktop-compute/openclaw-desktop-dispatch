def command_run(arguments: list[str]) -> None:
    if len(arguments) != 7:
        raise RequestError(
            "run expects scope, job, script, approved SHA-256, owner, dependencies, and resources"
        )
    scope, job, relative, sha_raw, owner_raw, dependencies_raw, resources_raw = arguments
    scope = validate_scope(scope)
    job = validate_job(job)
    relative_path = validate_relative(relative)
    if relative_path.suffix.casefold() not in SCRIPT_SUFFIXES[scope]:
        raise RequestError("script type is not allowed for this scope")
    approved = validate_sha256(sha_raw)
    owner = validate_owner(owner_raw)
    dependencies = validate_name_list(dependencies_raw, resource=False)
    resources = validate_name_list(resources_raw, resource=True)
    if job in dependencies:
        raise RequestError("a job cannot depend on itself")
    directory = ensure_job(scope, job)
    session = session_name(scope, job)
    if subprocess.run(
        ["/usr/bin/tmux", "has-session", "-t", session],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    ).returncode == 0:
        raise RequestError("job session already exists")

    log = directory / "logs/run.log"
    status = directory / "state/exit-code"
    runner_pid = directory / "state/runner-pid"
    with host_state_lock():
        if read_run_record(scope, job) is not None:
            raise RequestError("job already has immutable run provenance")
        script = managed_path(directory / "input", relative, require_file=True)
        actual = hash_file(script)
        if actual != approved:
            raise RequestError("script SHA-256 no longer matches approval")
        incomplete = [
            dependency for dependency in dependencies if exit_code_for(scope, dependency) != 0
        ]
        if incomplete:
            raise RequestError("a declared dependency has not succeeded")
        holders = active_resource_holders(scope, resources, job)
        if holders:
            raise RequestError(
                "requested resources are held by unfinished jobs: " + ",".join(holders)
            )
        runtime = Path.home() / ".local/state/desktop-compute" / scope / job
        runtime.mkdir(mode=0o700, parents=True, exist_ok=True)
        runner = runtime / "run-approved-script.sh"
        runner.write_text(RUNNER, encoding="utf-8")
        runner.chmod(0o700)
        status.unlink(missing_ok=True)
        runner_pid.unlink(missing_ok=True)
        command = shlex.join(
            [
                str(runner),
                scope,
                str(script),
                str(log),
                str(status),
                str(runner_pid),
                job,
                owner,
                json.dumps(resources, separators=(",", ":")),
                json.dumps(dependencies, separators=(",", ":")),
                actual,
            ]
        )
        record = {
            "scope": scope,
            "job": job,
            "script": relative,
            "sha256": actual,
            "session": session,
            "owner": owner,
            "dependencies": dependencies,
            "resources": resources,
            "nativeProcessMarkersRequired": True,
        }
        write_json_atomic(directory / "state/run.json", record)
        completed = subprocess.run(
            ["/usr/bin/tmux", "new-session", "-d", "-s", session, "-c", str(directory), "/bin/bash", "-lc", f"sleep 1; exec {command}"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )
        if completed.returncode != 0:
            write_text_atomic(status, "125\n")
            raise RequestError("job session could not be created")
    subprocess.run(
        ["/usr/bin/tmux", "set-option", "-t", session, "remain-on-exit", "on"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    emit(
        {
            "ok": True,
            "started": True,
            "scope": scope,
            "job": job,
            "session": session,
            "sha256": actual,
            "owner": owner,
            "dependencies": dependencies,
            "resources": resources,
        }
    )


def command_progress(arguments: list[str]) -> None:
    if len(arguments) != 3:
        raise RequestError("progress expects scope, job, and line count")
    scope, job, lines_raw = arguments
    scope = validate_scope(scope)
    job = validate_job(job)
    try:
        lines = int(lines_raw)
    except ValueError as error:
        raise RequestError("invalid line count") from error
    if not 1 <= lines <= 200:
        raise RequestError("line count is outside the allowed range")
    directory = job_dir(scope, job)
    session = session_name(scope, job)
    run_record = read_run_record(scope, job)
    workflow_state = read_state_json(scope, job, "workflow-state.json")
    exists, pane_dead = tmux_session_state(session)
    state = "not_started"
    if exists:
        state = "finished" if pane_dead else "running"
    exit_code: int | None = None
    status = directory / "state/exit-code"
    if status.is_file() and not status.is_symlink():
        try:
            exit_code = int(status.read_text(encoding="ascii").strip())
            state = "succeeded" if exit_code == 0 else "failed"
            if exit_code == 130 and workflow_state is not None:
                if workflow_state.get("state") == "cancelled":
                    state = "cancelled"
        except (OSError, ValueError):
            state = "invalid_status"
    elif run_record is not None and (not exists or pane_dead):
        state = "interrupted"
    runner_pid: int | None = None
    runner_pid_path = directory / "state/runner-pid"
    if runner_pid_path.is_file() and not runner_pid_path.is_symlink():
        try:
            candidate_pid = int(runner_pid_path.read_text(encoding="ascii").strip())
            if 1 <= candidate_pid <= 2**31 - 1:
                runner_pid = candidate_pid
        except (OSError, ValueError):
            runner_pid = None
    tail: list[str] = []
    log = directory / "logs/run.log"
    if log.is_file() and not log.is_symlink():
        tail = log.read_bytes()[-MAX_LOG_BYTES:].decode("utf-8", errors="replace").splitlines()[-lines:]
    emit(
        {
            "ok": True,
            "scope": scope,
            "job": job,
            "session": session,
            "sessionExists": exists,
            "state": state,
            "exitCode": exit_code,
            "run": run_record,
            "workflow": workflow_state,
            "runnerPid": runner_pid,
            "logTail": tail,
        }
    )


def command_cancel(arguments: list[str]) -> None:
    if len(arguments) != 3:
        raise RequestError("cancel expects scope, job, and owner")
    scope, job, owner = arguments
    scope = validate_scope(scope)
    job = validate_job(job)
    owner = validate_owner(owner)
    record = read_run_record(scope, job)
    if record is None or record.get("script") != "run-workflow.sh":
        raise RequestError("job is not a managed workflow")
    if record.get("owner") != owner:
        raise RequestError("workflow owner does not match")
    existing_exit = exit_code_for(scope, job)
    if existing_exit is not None:
        emit(
            {
                "ok": True,
                "scope": scope,
                "job": job,
                "cancelRequested": False,
                "alreadyFinished": True,
                "exitCode": existing_exit,
            }
        )
        return
    session = session_name(scope, job)
    session_exists, pane_dead = tmux_session_state(session)
    if not session_exists or pane_dead:
        raise RequestError(
            "workflow is interrupted; inspect recorded process IDs before operator recovery"
        )
    request = job_dir(scope, job) / "state/cancel-request.json"
    write_json_atomic(
        request,
        {"job": job, "owner": owner, "requestedUnixSeconds": int(time.time())},
    )
    emit(
        {
            "ok": True,
            "scope": scope,
            "job": job,
            "cancelRequested": True,
            "alreadyFinished": False,
        }
    )


def command_get_output(arguments: list[str]) -> None:
    if len(arguments) != 4:
        raise RequestError("get-output expects scope, job, path, and SHA-256")
    scope, job, relative, sha_raw = arguments
    expected = validate_sha256(sha_raw)
    path = managed_path(job_dir(scope, job) / "outputs", relative, require_file=True)
    if hash_file(path) != expected:
        raise RequestError("output SHA-256 changed")
    with path.open("rb") as handle:
        shutil.copyfileobj(handle, sys.stdout.buffer, length=1024 * 1024)


def command_attach(arguments: list[str]) -> NoReturn:
    if len(arguments) != 2:
        raise RequestError("attach expects scope and job")
    scope, job = arguments
    session = session_name(validate_scope(scope), validate_job(job))
    os.execv("/usr/bin/tmux", ["tmux", "attach-session", "-t", session])


COMMANDS = {
    "status": command_status,
    "mkdir": command_mkdir,
    "put": command_put,
    "stat-input": command_stat_input,
    "stat-output": command_stat_output,
    "run": command_run,
    "progress": command_progress,
    "cancel": command_cancel,
    "get-output": command_get_output,
    "attach": command_attach,
}


def main() -> int:
    original = os.environ.get("SSH_ORIGINAL_COMMAND", "")
    try:
        tokens = shlex.split(original, posix=True)
        if len(tokens) < 2 or tokens[0] != PROTOCOL:
            raise RequestError("request is outside the desktop-compute protocol")
        command = COMMANDS.get(tokens[1])
        if command is None:
            raise RequestError("unknown desktop-compute operation")
        command(tokens[2:])
    except (RequestError, OSError, subprocess.SubprocessError) as error:
        fail(str(error))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
