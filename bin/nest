#!/bin/bash
# nest — CLI wrapper for Google Nest SDM API + local weather (Open-Meteo)
# Unattended credentials come from the protected cache; attended exact-field
# 1Password reads are an explicit terminal-only fallback. Tokens auto-refresh.

set -euo pipefail

# LaunchAgent-safe credential sources. API credentials come from the protected
# OpenClaw cache; only a real interactive terminal may fall back to exact-field
# `op read` calls supplied through OP_REF_NEST_* environment variables.
CACHE_DIR="${NEST_CACHE_DIR:-${HOME}/.cache/nest-sdm}"
TOKEN_TTL=3300
SECRETS_CACHE="${OPENCLAW_SECRETS_CACHE:-${HOME}/.openclaw/.secrets-cache}"
INTERACTIVE_TERMINAL=0
if [[ -t 0 && -t 1 ]]; then
  INTERACTIVE_TERMINAL=1
fi

# History directory (JSONL snapshots, one file per day)
HISTORY_DIR="${HOME}/.openclaw/nest-history"

# Dashboard
DASHBOARD_LABEL="ai.openclaw.nest-dashboard"
DASHBOARD_PLIST="${HOME}/Library/LaunchAgents/${DASHBOARD_LABEL}.plist"
DASHBOARD_SCRIPT="${HOME}/.openclaw/bin/nest-dashboard.py"
DASHBOARD_PORT=8550

# Protected location config (lat/lon for weather)
LOCATION_FILE="${HOME}/.openclaw/nest-location.conf"

_validate_coordinates() {
  python3 - "$1" "$2" <<'PY'
import math
import sys

try:
    latitude = float(sys.argv[1])
    longitude = float(sys.argv[2])
except (IndexError, TypeError, ValueError):
    raise SystemExit(1)

if not (
    math.isfinite(latitude)
    and math.isfinite(longitude)
    and -90 <= latitude <= 90
    and -180 <= longitude <= 180
):
    raise SystemExit(1)
PY
}

_validate_location_list() {
  local entry name latitude longitude extra
  [[ -n "${NEST_LOCATIONS:-}" ]] || return 0
  for entry in $NEST_LOCATIONS; do
    IFS=':' read -r name latitude longitude extra <<< "$entry"
    if [[ -z "$name" || -n "$extra" ]] || ! _validate_coordinates "$latitude" "$longitude"; then
      echo "Nest location config contains an invalid location entry" >&2
      return 1
    fi
  done
}

_load_protected_crosstown_location() {
  local protected_coordinates
  if ! protected_coordinates=$(
    unset CROSSTOWN_LAT CROSSTOWN_LON
    _source_private_assignments "$SECRETS_CACHE" || exit $?
    if ! _validate_coordinates "${CROSSTOWN_LAT:-}" "${CROSSTOWN_LON:-}"; then
      echo "Nest location coordinates are missing or invalid in the protected cache" >&2
      exit 1
    fi
    printf '%s\t%s' "$CROSSTOWN_LAT" "$CROSSTOWN_LON"
  ); then
    return 1
  fi
  IFS=$'\t' read -r NEST_LAT NEST_LON <<< "$protected_coordinates"
}

_get_location() {
  NEST_LAT=""
  NEST_LON=""
  NEST_LOCATIONS=""

  if [[ -e "$LOCATION_FILE" || -L "$LOCATION_FILE" ]]; then
    if [[ -L "$LOCATION_FILE" || ! -f "$LOCATION_FILE" ]]; then
      echo "Nest location config must be a regular, non-symlink file" >&2
      return 1
    fi
    local owner mode
    read -r owner mode < <(_private_file_metadata "$LOCATION_FILE")
    if [[ "$owner" != "$(id -u)" || "$mode" != "600" ]]; then
      echo "Nest location config must be owner-only with mode 0600" >&2
      return 1
    fi
    # shellcheck disable=SC1090
    if ! source "$LOCATION_FILE" >/dev/null 2>&1; then
      echo "Nest location config could not be loaded" >&2
      return 1
    fi
    if ! _validate_location_list; then
      return 1
    fi
    if [[ -n "${NEST_LAT:-}" || -n "${NEST_LON:-}" ]] \
      && ! _validate_coordinates "${NEST_LAT:-}" "${NEST_LON:-}"; then
      echo "Nest location config contains invalid fallback coordinates" >&2
      return 1
    fi
  fi

  if [[ -z "${NEST_LAT:-}" || -z "${NEST_LON:-}" ]]; then
    _load_protected_crosstown_location || return 1
  fi
}

_private_file_metadata() {
  local file="$1"
  if stat -f '%u %Lp' "$file" >/dev/null 2>&1; then
    stat -f '%u %Lp' "$file"
  else
    stat -c '%u %a' "$file"
  fi
}

_source_private_assignments() {
  local file="$1"
  [[ -e "$file" || -L "$file" ]] || return 1
  if [[ -L "$file" || ! -f "$file" ]]; then
    echo "Nest secrets cache must be a regular, non-symlink file" >&2
    return 2
  fi
  local owner mode
  read -r owner mode < <(_private_file_metadata "$file")
  if [[ "$owner" != "$(id -u)" || "$mode" != "600" ]]; then
    echo "Nest secrets cache must be owner-only with mode 0600" >&2
    return 2
  fi
  set -a
  # shellcheck disable=SC1090
  if ! source "$file"; then
    set +a
    echo "Nest secrets cache is malformed" >&2
    return 2
  fi
  set +a
}

_read_private_value_file() {
  local file="$1"
  [[ -e "$file" || -L "$file" ]] || return 1
  if [[ -L "$file" || ! -f "$file" ]]; then
    echo "Nest token cache must be a regular, non-symlink file" >&2
    return 2
  fi
  local owner mode
  read -r owner mode < <(_private_file_metadata "$file")
  if [[ "$owner" != "$(id -u)" || "$mode" != "600" ]]; then
    echo "Nest token cache must be owner-only with mode 0600" >&2
    return 2
  fi
  cat "$file"
}

_interactive_op_read() {
  local key="$1"
  local reference_variable="OP_REF_${key}"
  local reference="${!reference_variable:-}"
  local op_bin value

  if [[ "$INTERACTIVE_TERMINAL" -ne 1 ]]; then
    echo "Missing $key in the protected cache; refusing to call op without an interactive terminal" >&2
    return 1
  fi
  if [[ -z "$reference" ]]; then
    echo "Missing interactive field reference $reference_variable; run openclaw-refresh-secrets" >&2
    return 1
  fi
  op_bin=$(command -v op || true)
  if [[ -z "$op_bin" ]]; then
    echo "1Password CLI is unavailable" >&2
    return 1
  fi
  if ! value=$("$op_bin" read "$reference" 2>/dev/null) || [[ -z "$value" ]]; then
    echo "Could not read required Nest field $key" >&2
    return 1
  fi
  printf '%s' "$value"
}

_nest_credential() {
  local key="$1"
  local value

  if [[ "$key" == "NEST_REFRESH_TOKEN" ]]; then
    if value=$(_read_private_value_file "$CACHE_DIR/refresh_token"); then
      [[ -n "$value" ]] && { printf '%s' "$value"; return 0; }
    elif [[ "$?" -ne 1 ]]; then
      return 2
    fi
  fi

  value="${!key:-}"
  if [[ -n "$value" ]]; then
    printf '%s' "$value"
    return 0
  fi
  if _source_private_assignments "$SECRETS_CACHE"; then
    value="${!key:-}"
    if [[ -n "$value" ]]; then
      printf '%s' "$value"
      return 0
    fi
  elif [[ "$?" -ne 1 ]]; then
    return 2
  fi
  _interactive_op_read "$key"
}

_write_private_value_file() (
  local destination="$1"
  local value="$2"
  local directory temporary
  directory=$(dirname "$destination")
  mkdir -p "$directory"
  chmod 700 "$directory"
  temporary=$(mktemp "$directory/.$(basename "$destination").XXXXXX")
  trap 'rm -f "$temporary"' EXIT
  chmod 600 "$temporary"
  printf '%s' "$value" > "$temporary"
  python3 - "$temporary" <<'PY'
import os
import sys

descriptor = os.open(sys.argv[1], os.O_RDONLY)
try:
    os.fsync(descriptor)
finally:
    os.close(descriptor)
PY
  mv -f "$temporary" "$destination"
  chmod 600 "$destination"
  trap - EXIT
)

_get_access_token() {
  mkdir -p "$CACHE_DIR"
  chmod 700 "$CACHE_DIR"
  local token_cache="$CACHE_DIR/access_token"

  if [[ -f "$token_cache" ]]; then
    local age=$(( $(date +%s) - $(stat -f %m "$token_cache") ))
    if (( age < TOKEN_TTL )); then
      _read_private_value_file "$token_cache"
      return
    fi
  fi

  local client_id client_secret refresh_token
  client_id=$(_nest_credential NEST_CLIENT_ID)
  client_secret=$(_nest_credential NEST_CLIENT_SECRET)
  refresh_token=$(_nest_credential NEST_REFRESH_TOKEN)

  local resp token
  if ! resp=$(curl -sS --fail-with-body -X POST "https://www.googleapis.com/oauth2/v4/token" \
    -d "client_id=${client_id}" \
    -d "client_secret=${client_secret}" \
    -d "refresh_token=${refresh_token}" \
    -d "grant_type=refresh_token"); then
    echo "Error refreshing Nest access token" >&2
    return 1
  fi
  token=$(printf '%s' "$resp" | python3 -c '
import json
import sys

try:
    data = json.load(sys.stdin)
except (json.JSONDecodeError, UnicodeDecodeError):
    sys.exit(1)
token = data.get("access_token") if isinstance(data, dict) and "error" not in data else None
if not isinstance(token, str) or not token or any(char.isspace() for char in token):
    sys.exit(1)
sys.stdout.write(token)
' 2>/dev/null || true)
  if [[ -z "$token" ]]; then
    echo "Error refreshing Nest access token" >&2
    return 1
  fi

  _write_private_value_file "$token_cache" "$token"
  printf '%s' "$token"
}

_project_id() {
  _nest_credential NEST_PROJECT_ID
}

_api() {
  local method="$1" path="$2"
  shift 2
  local token project_id response validated
  token=$(_get_access_token)
  project_id=$(_project_id)
  if ! response=$(curl -sS --fail-with-body -X "$method" \
    "https://smartdevicemanagement.googleapis.com/v1/enterprises/${project_id}${path}" \
    -H "Content-Type: application/json" \
    -H "Authorization: Bearer ${token}" \
    "$@"); then
    echo "Nest API request failed" >&2
    return 1
  fi
  if ! validated=$(printf '%s' "$response" | python3 -c '
import json
import sys

try:
    data = json.load(sys.stdin)
except (json.JSONDecodeError, UnicodeDecodeError):
    sys.exit(1)
if not isinstance(data, dict) or "error" in data:
    sys.exit(1)
sys.stdout.write(json.dumps(data, separators=(",", ":")))
' 2>/dev/null); then
    echo "Nest API returned an invalid response" >&2
    return 1
  fi
  printf '%s\n' "$validated"
}

_get_weather() {
  # Returns JSON: {"temp_f":12.0,"feels_like_f":4.7,"humidity":73,"wind_mph":1.9,"code":3,"description":"Overcast"}
  # Optional: _get_weather [lat] [lon] — uses positional args if provided, else NEST_LAT/NEST_LON
  _get_location || return 1
  local lat="${1:-$NEST_LAT}" lon="${2:-$NEST_LON}"
  local resp
  resp=$(curl -s --connect-timeout 5 --max-time 10 \
    "https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}&current=temperature_2m,relative_humidity_2m,wind_speed_10m,wind_gusts_10m,weather_code,apparent_temperature&temperature_unit=fahrenheit&wind_speed_unit=mph" 2>/dev/null) || true

  if [[ -z "$resp" ]]; then
    echo '{}'
    return
  fi

  python3 -c "
import json, sys
WMO_CODES = {
    0: 'Clear sky', 1: 'Mainly clear', 2: 'Partly cloudy', 3: 'Overcast',
    45: 'Fog', 48: 'Rime fog',
    51: 'Light drizzle', 53: 'Drizzle', 55: 'Dense drizzle',
    61: 'Light rain', 63: 'Rain', 65: 'Heavy rain',
    66: 'Light freezing rain', 67: 'Freezing rain',
    71: 'Light snow', 73: 'Snow', 75: 'Heavy snow',
    77: 'Snow grains', 80: 'Light showers', 81: 'Showers', 82: 'Heavy showers',
    85: 'Light snow showers', 86: 'Snow showers',
    95: 'Thunderstorm', 96: 'Thunderstorm w/ hail', 99: 'Thunderstorm w/ heavy hail',
}
try:
    data = json.loads(sys.stdin.read())
    c = data['current']
    code = c.get('weather_code', 0)
    print(json.dumps({
        'temp_f': c['temperature_2m'],
        'feels_like_f': c['apparent_temperature'],
        'humidity': c['relative_humidity_2m'],
        'wind_mph': c['wind_speed_10m'],
        'wind_gusts_mph': c.get('wind_gusts_10m', 0),
        'code': code,
        'description': WMO_CODES.get(code, f'Code {code}'),
    }))
except Exception:
    print('{}')
" <<< "$resp"
}

_get_all_weather() {
  # If NEST_LOCATIONS is set (space-separated "name:lat:lon" entries),
  # returns a JSON dict keyed by structure name: {"Philly": {...}, "19Crosstown": {...}}
  # Otherwise falls back to single-location _get_weather (returns flat dict).
  _get_location || return 1
  if [[ -z "${NEST_LOCATIONS:-}" ]]; then
    _get_weather
    return
  fi

  local results=()
  for entry in $NEST_LOCATIONS; do
    local name lat lon w
    IFS=':' read -r name lat lon <<< "$entry"
    w=$(_get_weather "$lat" "$lon")
    results+=("\"$name\": $w")
  done

  # Join into JSON object
  local joined
  joined=$(IFS=','; echo "${results[*]}")
  echo "{$joined}"
}

_get_cielo_status() {
  # Returns a JSON array of Cielo device statuses; [] on failure.
  local cielo_bin out
  cielo_bin=$(command -v cielo || true)
  if [[ -z "$cielo_bin" ]]; then
    echo '[]'
    return
  fi
  out=$("$cielo_bin" status --json 2>/dev/null) || true
  if [[ -z "$out" ]]; then echo '[]'; else echo "$out"; fi
}

_get_mysa_status() {
  # Returns the Mysa status object; {} on failure.
  local mysa_bin out
  mysa_bin=$(command -v mysa || true)
  if [[ -z "$mysa_bin" ]]; then
    echo '{}'
    return
  fi
  out=$("$mysa_bin" 2>/dev/null) || true
  if [[ -z "$out" ]]; then echo '{}'; else echo "$out"; fi
}

_c_to_f() {
  python3 -c 'import sys; print(round(float(sys.argv[1]) * 9/5 + 32, 1))' "$1"
}

_f_to_c() {
  python3 -c '
import math
import sys

try:
    value = float(sys.argv[1])
except (TypeError, ValueError):
    sys.exit(2)
if not math.isfinite(value) or not 45 <= value <= 90:
    sys.exit(2)
print(round((value - 32) * 5/9, 6))
' "$1"
}

# Structure name map (cached per session)
_structure_map=""
_build_structure_map() {
  if [[ -n "$_structure_map" ]]; then return; fi
  _structure_map=$(_api GET /structures | python3 -c "
import sys, json
data = json.load(sys.stdin)
for s in data.get('structures', []):
    sid = s['name'].split('/')[-1]
    name = s.get('traits', {}).get('sdm.structures.traits.Info', {}).get('customName', 'Unknown')
    print(f'{sid}\t{name}')
")
}

# Map room names to device IDs (cached per session)
# Uses "Home Room" format when multiple structures exist
_device_map=""
_build_device_map() {
  if [[ -n "$_device_map" ]]; then return; fi
  _build_structure_map
  local devices_json structures_json
  devices_json=$(_api GET /devices)
  structures_json="$_structure_map"
  _device_map=$(STRUCT_MAP="$structures_json" python3 -c "
import sys, json, os
data = json.load(sys.stdin)
struct_map = {}
for line in os.environ.get('STRUCT_MAP', '').strip().split('\n'):
    if '\t' in line:
        sid, name = line.split('\t', 1)
        struct_map[sid] = name
multi = len(struct_map) > 1
for d in data.get('devices', []):
    room = d.get('parentRelations', [{}])[0].get('displayName', 'Unknown')
    did = d['name'].split('/')[-1]
    if multi:
        parent = d.get('parentRelations', [{}])[0].get('parent', '')
        for sid, sname in struct_map.items():
            if sid in parent:
                room = f'{sname} {room}'
                break
    print(f'{room}\t{did}')
" <<< "$devices_json")
}

_resolve_device() {
  local query
  query="$(echo "$1" | tr '[:upper:]' '[:lower:]')"
  _build_device_map
  local match
  match=$(python3 -c '
import sys

query = sys.argv[1]
for line in sys.stdin:
    name, separator, device_id = line.rstrip("\n").partition("\t")
    if separator and query in name.lower():
        print(device_id)
        break
' "$query" <<< "$_device_map")
  if [[ -z "$match" ]]; then
    echo "No thermostat matching '$1'. Available:" >&2
    echo "$_device_map" | awk -F'\t' '{print "  - " $1}' >&2
    exit 1
  fi
  echo "$match"
}

_device_path() {
  echo "/devices/$(_resolve_device "$1")"
}

cmd_status() {
  local data weather
  data=$(_api GET /devices)
  weather=$(_get_all_weather)

  # Build structure map for prefixing
  _build_structure_map
  WEATHER_JSON="$weather" STRUCT_MAP="$_structure_map" python3 -c "
import json, sys, os

data = json.load(sys.stdin)
weather_raw = os.environ.get('WEATHER_JSON', '{}')
weather = json.loads(weather_raw) if weather_raw and weather_raw != '{}' else None

struct_map = {}
for line in os.environ.get('STRUCT_MAP', '').strip().split('\n'):
    if '\t' in line:
        sid, name = line.split('\t', 1)
        struct_map[sid] = name
multi = len(struct_map) > 1

if weather:
    # Detect format: 'temp_f' at top level = single-location, else dict-of-dicts
    if 'temp_f' in weather:
        locations = {'Outside': weather}
    else:
        locations = {f'Outside ({k})': v for k, v in weather.items()}
    for label, w in locations.items():
        if not w or 'temp_f' not in w:
            continue
        print(f'{label}:  {w[\"temp_f\"]:.1f}\u00b0F  (feels {w[\"feels_like_f\"]:.1f}\u00b0F)  {w[\"description\"]}  {w[\"wind_mph\"]:.0f} mph wind  {w[\"humidity\"]}% humidity')
    print()

for d in data.get('devices', []):
    t = d['traits']
    if 'sdm.devices.traits.ThermostatMode' not in t:
        continue
    room = d.get('parentRelations', [{}])[0].get('displayName', 'Unknown')
    if multi:
        parent = d.get('parentRelations', [{}])[0].get('parent', '')
        for sid, sname in struct_map.items():
            if sid in parent:
                room = f'{sname} {room}'
                break
    temp_c = t.get('sdm.devices.traits.Temperature', {}).get('ambientTemperatureCelsius', 0)
    temp_f = round(temp_c * 9/5 + 32, 1)
    humidity = t.get('sdm.devices.traits.Humidity', {}).get('ambientHumidityPercent', 0)
    mode = t.get('sdm.devices.traits.ThermostatMode', {}).get('mode', '?')
    hvac = t.get('sdm.devices.traits.ThermostatHvac', {}).get('status', '?')
    eco = t.get('sdm.devices.traits.ThermostatEco', {}).get('mode', 'OFF')
    setpoint = t.get('sdm.devices.traits.ThermostatTemperatureSetpoint', {})
    set_c = setpoint.get('heatCelsius') or setpoint.get('coolCelsius') or 0
    set_f = round(set_c * 9/5 + 32, 1)
    status = f'ECO' if eco != 'OFF' else hvac
    print(f'{room:25s}  {temp_f:5.1f}\u00b0F  set:{set_f:.0f}\u00b0F  {mode:4s}  {status:8s}  {humidity}% humidity')
" <<< "$data"
}

cmd_weather() {
  local weather
  weather=$(_get_all_weather)
  if [[ "$weather" == "{}" ]]; then
    echo "Failed to fetch weather data" >&2
    exit 1
  fi
  WEATHER_JSON="$weather" python3 -c "
import json, os
raw = json.loads(os.environ['WEATHER_JSON'])
# Detect format: if 'temp_f' is a top-level key, it's a single-location dict
if 'temp_f' in raw:
    locations = {'Weather': raw}
else:
    locations = raw
for name, w in locations.items():
    if not w or 'temp_f' not in w:
        continue
    print(f'{name}:')
    print(f'  Temperature:  {w[\"temp_f\"]:.1f}\u00b0F  (feels like {w[\"feels_like_f\"]:.1f}\u00b0F)')
    print(f'  Conditions:   {w[\"description\"]}')
    print(f'  Humidity:     {w[\"humidity\"]}%')
    print(f'  Wind:         {w[\"wind_mph\"]:.1f} mph (gusts {w[\"wind_gusts_mph\"]:.1f} mph)')
    print()
"
}

_thermostat_payload() {
  local command="$1" parameter="$2" value="$3" value_type="$4"
  python3 -c '
import json
import sys

command, parameter, value, value_type = sys.argv[1:]
if value_type == "number":
    value = float(value)
elif value_type != "string":
    sys.exit(2)
print(json.dumps({"command": command, "params": {parameter: value}}, separators=(",", ":")))
' "$command" "$parameter" "$value" "$value_type"
}

_verify_mutation() {
  local device_path="$1" kind="$2" expected="$3"
  local attempts="${NEST_VERIFY_ATTEMPTS:-3}"
  local delay_seconds="${NEST_VERIFY_DELAY_SECONDS:-2}"
  local response attempt

  if ! [[ "$attempts" =~ ^[1-9][0-9]*$ ]] || (( attempts > 10 )); then
    echo "Invalid Nest verification attempt count" >&2
    return 2
  fi
  if ! [[ "$delay_seconds" =~ ^([0-9]([.][0-9]+)?|10([.]0+)?)$ ]]; then
    echo "Invalid Nest verification delay" >&2
    return 2
  fi

  attempt=1
  while (( attempt <= attempts )); do
    if response=$(_api GET "$device_path"); then
      if printf '%s' "$response" | python3 -c '
import json
import math
import sys

kind = sys.argv[1]
expected = sys.argv[2]
try:
    data = json.load(sys.stdin)
    traits = data["traits"]
    if kind == "heat":
        actual = traits["sdm.devices.traits.ThermostatTemperatureSetpoint"]["heatCelsius"]
        if isinstance(actual, bool) or not isinstance(actual, (int, float)):
            raise ValueError
        matched = math.isfinite(float(actual)) and abs(float(actual) - float(expected)) <= 0.15
    elif kind == "mode":
        actual = traits["sdm.devices.traits.ThermostatMode"]["mode"]
        matched = isinstance(actual, str) and actual == expected
    elif kind == "eco":
        actual = traits["sdm.devices.traits.ThermostatEco"]["mode"]
        matched = isinstance(actual, str) and actual == expected
    else:
        raise ValueError
except (KeyError, TypeError, ValueError, json.JSONDecodeError):
    sys.exit(2)
sys.exit(0 if matched else 1)
' "$kind" "$expected" 2>/dev/null; then
        return 0
      fi
    fi
    if (( attempt < attempts )) && [[ "$delay_seconds" != "0" ]]; then
      sleep "$delay_seconds"
    fi
    attempt=$((attempt + 1))
  done

  echo "Nest command completed, but the requested state could not be verified" >&2
  return 1
}

cmd_set() {
  local room="$1" temp_f="$2"
  local device_path temp_c payload
  if ! temp_c=$(_f_to_c "$temp_f"); then
    echo "Temperature must be a finite number from 45 to 90°F" >&2
    return 2
  fi
  device_path=$(_device_path "$room")
  payload=$(_thermostat_payload \
    "sdm.devices.commands.ThermostatTemperatureSetpoint.SetHeat" \
    "heatCelsius" "$temp_c" "number")

  if ! _api POST "${device_path}:executeCommand" -d "$payload" > /dev/null; then
    echo "Nest temperature command failed" >&2
    return 1
  fi
  _verify_mutation "$device_path" heat "$temp_c" || return

  echo "Set $room to ${temp_f}°F"
}

cmd_mode() {
  local room="$1" mode
  mode="$(echo "$2" | tr '[:lower:]' '[:upper:]')"
  local device_path payload
  if [[ "$mode" != "HEAT" && "$mode" != "OFF" ]]; then
    echo "Mode must be HEAT or OFF" >&2
    return 2
  fi
  device_path=$(_device_path "$room")
  payload=$(_thermostat_payload \
    "sdm.devices.commands.ThermostatMode.SetMode" \
    "mode" "$mode" "string")

  if ! _api POST "${device_path}:executeCommand" -d "$payload" > /dev/null; then
    echo "Nest mode command failed" >&2
    return 1
  fi
  _verify_mutation "$device_path" mode "$mode" || return

  echo "Set $room mode to ${mode}"
}

cmd_eco() {
  local room="$1" mode
  mode="$(echo "${2:-MANUAL_ECO}" | tr '[:lower:]' '[:upper:]')"
  local device_path payload
  if [[ "$mode" != "MANUAL_ECO" && "$mode" != "OFF" ]]; then
    echo "Eco mode must be MANUAL_ECO or OFF" >&2
    return 2
  fi
  device_path=$(_device_path "$room")
  payload=$(_thermostat_payload \
    "sdm.devices.commands.ThermostatEco.SetMode" \
    "mode" "$mode" "string")

  if ! _api POST "${device_path}:executeCommand" -d "$payload" > /dev/null; then
    echo "Nest eco command failed" >&2
    return 1
  fi
  _verify_mutation "$device_path" eco "$mode" || return

  echo "Set $room eco to ${mode}"
}

cmd_snapshot() {
  # Record current state + weather as a JSON line to daily history file
  mkdir -p "$HISTORY_DIR"
  local data weather ts today

  # Tolerate network failures — skip snapshot rather than crash
  data=$(_api GET /devices) || { echo "Snapshot skipped: Nest API unreachable" >&2; return 0; }
  if [[ -z "$data" ]] || ! echo "$data" | python3 -c "import sys,json; json.load(sys.stdin)" 2>/dev/null; then
    echo "Snapshot skipped: invalid API response" >&2
    return 0
  fi

  weather=$(_get_all_weather)
  local cielo mysa
  cielo=$(_get_cielo_status)
  mysa=$(_get_mysa_status)
  ts=$(date -u +%FT%TZ)
  today=$(date +%Y-%m-%d)

  _build_structure_map
  WEATHER_JSON="$weather" SNAP_TS="$ts" STRUCT_MAP="$_structure_map" \
    CIELO_JSON="$cielo" MYSA_JSON="$mysa" python3 -c "
import json, sys, os
data = json.load(sys.stdin)
ts = os.environ['SNAP_TS']
weather_raw = os.environ.get('WEATHER_JSON', '{}')
weather = json.loads(weather_raw) if weather_raw and weather_raw != '{}' else None
struct_map = {}
for line in os.environ.get('STRUCT_MAP', '').strip().split('\n'):
    if '\t' in line:
        sid, name = line.split('\t', 1)
        struct_map[sid] = name
multi = len(struct_map) > 1
snapshot = {'timestamp': ts, 'rooms': []}
if weather:
    snapshot['weather'] = weather
for d in data.get('devices', []):
    t = d['traits']
    if 'sdm.devices.traits.ThermostatMode' not in t:
        continue
    room = d.get('parentRelations', [{}])[0].get('displayName', 'Unknown')
    if multi:
        parent = d.get('parentRelations', [{}])[0].get('parent', '')
        for sid, sname in struct_map.items():
            if sid in parent:
                room = f'{sname} {room}'
                break
    temp_c = t.get('sdm.devices.traits.Temperature', {}).get('ambientTemperatureCelsius', 0)
    humidity = t.get('sdm.devices.traits.Humidity', {}).get('ambientHumidityPercent', 0)
    mode = t.get('sdm.devices.traits.ThermostatMode', {}).get('mode', '?')
    hvac = t.get('sdm.devices.traits.ThermostatHvac', {}).get('status', '?')
    eco = t.get('sdm.devices.traits.ThermostatEco', {}).get('mode', 'OFF')
    setpoint = t.get('sdm.devices.traits.ThermostatTemperatureSetpoint', {})
    set_c = setpoint.get('heatCelsius') or setpoint.get('coolCelsius') or 0
    conn = t.get('sdm.devices.traits.Connectivity', {}).get('status', '?')
    snapshot['rooms'].append({
        'room': room,
        'temp_c': round(temp_c, 2),
        'temp_f': round(temp_c * 9/5 + 32, 1),
        'humidity': humidity,
        'mode': mode,
        'hvac': hvac,
        'eco': eco,
        'setpoint_c': round(set_c, 2),
        'setpoint_f': round(set_c * 9/5 + 32, 1),
        'connectivity': conn,
        'source': 'nest',
    })
# Inject Cielo devices (all at Crosstown).
try:
    cielo_devices = json.loads(os.environ.get('CIELO_JSON', '[]'))
except (TypeError, ValueError, json.JSONDecodeError):
    cielo_devices = []
for cd in cielo_devices if isinstance(cielo_devices, list) else []:
    env = cd.get('latEnv', {})
    action = cd.get('latestAction', {})
    c_temp_f = float(env.get('temp', 0))
    c_humidity = env.get('humidity', 0)
    c_mode = action.get('mode', '?')
    c_power = action.get('power', 'off')
    hvac_map = {'heat': 'HEATING', 'cool': 'COOLING', 'auto': 'AUTO', 'fan': 'FAN', 'dry': 'DRY'}
    c_hvac = hvac_map.get(c_mode, 'ON') if c_power == 'on' else 'OFF'
    c_set_f = float(action.get('temp', 0))
    snapshot['rooms'].append({
        'room': '19Crosstown ' + cd.get('deviceName', 'Unknown'),
        'temp_f': round(c_temp_f, 1),
        'temp_c': round((c_temp_f - 32) * 5 / 9, 2),
        'humidity': c_humidity,
        'mode': c_mode,
        'hvac': c_hvac,
        'eco': 'OFF',
        'setpoint_f': round(c_set_f, 1),
        'setpoint_c': round((c_set_f - 32) * 5 / 9, 2),
        'connectivity': 'ONLINE' if cd.get('deviceStatus', 0) == 1 else 'OFFLINE',
        'source': 'cielo',
    })
# Inject Mysa baseboard heaters (all at Crosstown).
try:
    mysa_data = json.loads(os.environ.get('MYSA_JSON', '{}'))
except (TypeError, ValueError, json.JSONDecodeError):
    mysa_data = {}
if not isinstance(mysa_data, dict):
    mysa_data = {}
for md in mysa_data.get('devices', []):
    m_temp_f = float(md.get('temp_f') or md.get('sensor_temp_f') or 0)
    m_set_f = float(md.get('setpoint_f', 0))
    m_duty = float(md.get('duty_pct', 0))
    snapshot['rooms'].append({
        'room': '19Crosstown ' + md.get('name', 'Unknown'),
        'temp_f': round(m_temp_f, 1),
        'temp_c': round((m_temp_f - 32) * 5 / 9, 2),
        'humidity': md.get('humidity', 0),
        'mode': 'heat' if m_duty > 0 else 'off',
        'hvac': 'HEATING' if m_duty > 0 else 'OFF',
        'eco': 'OFF',
        'setpoint_f': round(m_set_f, 1),
        'setpoint_c': round((m_set_f - 32) * 5 / 9, 2),
        'connectivity': 'ONLINE',
        'duty_pct': m_duty,
        'source': 'mysa',
    })
print(json.dumps(snapshot))
" <<< "$data" >> "$HISTORY_DIR/${today}.jsonl"

  # Prune history files older than 90 days
  find "$HISTORY_DIR" -name '*.jsonl' -mtime +1000 -delete 2>/dev/null || true

  echo "Snapshot recorded at $ts → $HISTORY_DIR/${today}.jsonl"
}

cmd_history() {
  # Show history summary. Usage: nest history [hours] [room]
  local hours="${1:-24}" room_filter="${2:-}"
  mkdir -p "$HISTORY_DIR"

  NEST_HISTORY_HOURS="$hours" NEST_HISTORY_ROOM="$room_filter" \
    NEST_HISTORY_DIR_PATH="$HISTORY_DIR" python3 -c "
import json, sys, os
from datetime import datetime, timedelta, timezone

hours = int(os.environ['NEST_HISTORY_HOURS'])
room_filter = os.environ['NEST_HISTORY_ROOM'].lower()
history_dir = os.environ['NEST_HISTORY_DIR_PATH']
cutoff = datetime.now(timezone.utc) - timedelta(hours=hours)

# Collect snapshots from recent daily files
records = []
for i in range(max(1, hours // 24 + 2)):
    day = (datetime.now(timezone.utc) - timedelta(days=i)).strftime('%Y-%m-%d')
    path = os.path.join(history_dir, f'{day}.jsonl')
    if os.path.exists(path):
        with open(path) as f:
            for line in f:
                line = line.strip()
                if not line:
                    continue
                rec = json.loads(line)
                ts = datetime.fromisoformat(rec['timestamp'].replace('Z', '+00:00'))
                if ts >= cutoff:
                    records.append(rec)

if not records:
    print(f'No history data found for the last {hours} hours.')
    print(f'Run \"nest snapshot\" to start recording data.')
    sys.exit(0)

records.sort(key=lambda r: r['timestamp'])

# Aggregate outdoor weather
weather_temps = []
weather_feels = []
weather_humidity = []
weather_wind = []
weather_descriptions = {}
for rec in records:
    w = rec.get('weather')
    if w:
        weather_temps.append(w['temp_f'])
        weather_feels.append(w['feels_like_f'])
        weather_humidity.append(w['humidity'])
        weather_wind.append(w['wind_mph'])
        desc = w.get('description', '?')
        weather_descriptions[desc] = weather_descriptions.get(desc, 0) + 1

# Aggregate per room
rooms = {}
for rec in records:
    for r in rec['rooms']:
        name = r['room']
        if room_filter and room_filter not in name.lower():
            continue
        if name not in rooms:
            rooms[name] = {'temps': [], 'humidities': [], 'hvac_heating': 0, 'total': 0, 'setpoints': []}
        rooms[name]['temps'].append(r['temp_f'])
        rooms[name]['humidities'].append(r['humidity'])
        rooms[name]['setpoints'].append(r['setpoint_f'])
        rooms[name]['total'] += 1
        if r['hvac'] == 'HEATING':
            rooms[name]['hvac_heating'] += 1

print(f'Climate history — last {hours}h ({len(records)} snapshots)')
print(f'Period: {records[0][\"timestamp\"]} → {records[-1][\"timestamp\"]}')
print()

if weather_temps:
    top_conditions = sorted(weather_descriptions.items(), key=lambda x: -x[1])
    conditions_str = ', '.join(f'{d}' for d, _ in top_conditions[:3])
    print(f'Outside:')
    print(f'  Temperature:  {min(weather_temps):.1f}°F — {max(weather_temps):.1f}°F  (avg {sum(weather_temps)/len(weather_temps):.1f}°F)')
    print(f'  Feels like:   {min(weather_feels):.1f}°F — {max(weather_feels):.1f}°F')
    print(f'  Humidity:     {min(weather_humidity)}% — {max(weather_humidity)}%')
    print(f'  Wind:         {min(weather_wind):.0f} — {max(weather_wind):.0f} mph')
    print(f'  Conditions:   {conditions_str}')
    print()

for name in sorted(rooms.keys()):
    d = rooms[name]
    t = d['temps']
    h = d['humidities']
    s = d['setpoints']
    heat_pct = round(100 * d['hvac_heating'] / d['total'])
    print(f'{name}:')
    print(f'  Temperature:  {min(t):.1f}°F — {max(t):.1f}°F  (avg {sum(t)/len(t):.1f}°F)')
    print(f'  Humidity:     {min(h)}% — {max(h)}%  (avg {sum(h)//len(h)}%)')
    print(f'  Setpoint:     {min(s):.0f}°F — {max(s):.0f}°F')
    print(f'  HVAC heating: {heat_pct}% of snapshots')
    if weather_temps:
        avg_indoor = sum(t) / len(t)
        avg_outdoor = sum(weather_temps) / len(weather_temps)
        print(f'  Δ vs outside: +{avg_indoor - avg_outdoor:.1f}°F')
    print()
"
}

cmd_dashboard() {
  local subcmd="${1:-open}"
  case "$subcmd" in
    open)
      open "http://localhost:${DASHBOARD_PORT}/"
      ;;
    start)
      if [[ ! -f "$DASHBOARD_PLIST" ]]; then
        echo "LaunchAgent plist not found at $DASHBOARD_PLIST" >&2
        echo "Install it first: cp <dotfiles>/openclaw/launchagents/ai.openclaw.nest-dashboard.plist ~/Library/LaunchAgents/" >&2
        exit 1
      fi
      if launchctl list "$DASHBOARD_LABEL" &>/dev/null; then
        echo "Dashboard already running"
      else
        launchctl load -w "$DASHBOARD_PLIST"
        echo "Dashboard started on port $DASHBOARD_PORT"
      fi
      ;;
    stop)
      if launchctl list "$DASHBOARD_LABEL" &>/dev/null; then
        launchctl unload "$DASHBOARD_PLIST"
        echo "Dashboard stopped"
      else
        echo "Dashboard not running"
      fi
      ;;
    restart)
      cmd_dashboard stop
      sleep 1
      cmd_dashboard start
      ;;
    status)
      if launchctl list "$DASHBOARD_LABEL" &>/dev/null; then
        local pid
        pid=$(launchctl list "$DASHBOARD_LABEL" | awk -F'"PID" = ' 'NF>1{gsub(/[^0-9]/,"",$2); print $2}')
        echo "Dashboard running (PID: ${pid:-?}) on port $DASHBOARD_PORT"
      else
        echo "Dashboard not running"
      fi
      ;;
    *)
      echo "Usage: nest dashboard [open|start|stop|restart|status]" >&2
      exit 1
      ;;
  esac
}

cmd_help() {
  cat <<'HELP'
Usage: nest <command> [args]

Commands:
  status                    Show all thermostats + outdoor weather
  weather                   Show current outdoor weather only
  set <room> <temp°F>       Set temperature (e.g. nest set bedroom 72)
  mode <room> <HEAT|OFF>    Set thermostat mode
  eco <room> [on|off]       Toggle eco mode
  camera snap [room] [out]  Capture camera snapshot (default: kitchen)
  snapshot                  Record current state + weather to history
  history [hours] [room]    Show history summary (default: 24h, all rooms)
  dashboard                 Open dashboard in browser
  dashboard start|stop      Start/stop dashboard LaunchAgent
  dashboard restart|status  Restart or check dashboard status
  raw                       Raw JSON device dump
  reauth                    Re-run Google Device Access OAuth (e.g. to add a new camera)
  help                      Show this help

Room names are fuzzy-matched (e.g. "bed" matches "Bedroom").
History is stored in ~/.openclaw/nest-history/ as daily JSONL files.
Weather data from Open-Meteo. Location: ~/.openclaw/nest-location.conf
HELP
}

cmd_reauth() {
  # Re-run Google Device Access OAuth consent to add newly-paired Nest devices.
  # Required whenever a device is added in the Google Home app after initial setup —
  # SDM only exposes devices that were ticked on the consent screen at grant time.
  #
  # Two-step (non-interactive) flow so it works fine over SSH/`!` shell-out:
  #   1) `nest reauth`             → prints the consent URL
  #   2) `nest reauth <code-or-redirect-url>` → exchanges code for tokens
  local client_id client_secret project_id redirect_uri code resp
  local refresh_token access_token input="${1:-}"

  client_id=$(_nest_credential NEST_CLIENT_ID)
  client_secret=$(_nest_credential NEST_CLIENT_SECRET)
  project_id=$(_nest_credential NEST_PROJECT_ID)
  redirect_uri="${NEST_REAUTH_REDIRECT_URI:-https://www.google.com}"

  if [[ -z "$client_id" || -z "$project_id" || -z "$client_secret" ]]; then
    echo "Missing client_id, client_secret, or project_id from the protected cache" >&2
    echo "Run openclaw-refresh-secrets --interactive before retrying" >&2
    exit 1
  fi

  if [[ -z "$input" ]]; then
    cat <<EOF
1) Open this URL in a browser. On the consent screen, tick EVERY device you
   want SDM to see — both previously-authorized AND any newly-added ones.
   Anything left unticked becomes invisible to the API.

   https://nestservices.google.com/partnerconnections/${project_id}/auth?redirect_uri=${redirect_uri}&access_type=offline&prompt=consent&client_id=${client_id}&response_type=code&scope=https%3A%2F%2Fwww.googleapis.com%2Fauth%2Fsdm.service

2) After consenting, the browser will redirect to a URL like:
     ${redirect_uri}/?code=<LONG_CODE>&scope=...

3) Run:  nest reauth '<that-redirect-URL-or-bare-code>'
EOF
    return 0
  fi

  # Extract code from full URL or accept bare code
  if [[ "$input" == *"code="* ]]; then
    code="${input#*code=}"
    code="${code%%&*}"
  else
    code="$input"
  fi

  if [[ -z "$code" ]]; then
    echo "No code provided" >&2
    exit 1
  fi

  echo "Exchanging code for tokens..."
  if ! resp=$(curl -sS --fail-with-body -X POST "https://www.googleapis.com/oauth2/v4/token" \
    -d "client_id=${client_id}" \
    -d "client_secret=${client_secret}" \
    -d "code=${code}" \
    -d "grant_type=authorization_code" \
    --data-urlencode "redirect_uri=${redirect_uri}"); then
    echo "Failed to exchange the Nest authorization code" >&2
    return 1
  fi

  local token_pair
  if ! token_pair=$(printf '%s' "$resp" | python3 -c '
import json
import sys

try:
    data = json.load(sys.stdin)
except (json.JSONDecodeError, UnicodeDecodeError):
    sys.exit(1)
if not isinstance(data, dict) or "error" in data:
    sys.exit(1)
refresh = data.get("refresh_token")
access = data.get("access_token")
if not all(isinstance(value, str) and value and not any(char.isspace() for char in value) for value in (refresh, access)):
    sys.exit(1)
sys.stdout.write(refresh + "\t" + access)
' 2>/dev/null); then
    echo "Failed to obtain a Nest refresh token" >&2
    return 1
  fi
  IFS=$'\t' read -r refresh_token access_token <<< "$token_pair"

  mkdir -p "$CACHE_DIR"
  _write_private_value_file "$CACHE_DIR/refresh_token" "$refresh_token"
  _write_private_value_file "$CACHE_DIR/access_token" "$access_token"

  echo "✓ New refresh_token + access_token saved to $CACHE_DIR"
  echo "  (Update 1Password 'Google Nest' item's refresh_token field if you"
  echo "   want it in the combined cache, run openclaw-refresh-secrets --interactive.)"
  echo
  echo "Visible devices now:"
  _api GET /devices | python3 -c "
import json, sys
data = json.load(sys.stdin)
for d in data.get('devices', []):
    t = d['type'].split('.')[-1]
    name = d['parentRelations'][0].get('displayName') if d.get('parentRelations') else '?'
    custom = d['traits'].get('sdm.devices.traits.Info', {}).get('customName') or ''
    print(f'  {t:14}  {name:20}  {custom}')
"
}

cmd_camera_snap() {
  # Capture a single frame from a camera via WebRTC
  local room="${1:-kitchen}"
  local output="${2:-${HOME}/.openclaw/workspace/camera-snap.jpg}"

  # Find camera device ID
  local data camera_id
  data=$(_api GET /devices)
  camera_id=$(NEST_CAMERA_QUERY="$room" python3 -c "
import json, sys
import os
query = os.environ['NEST_CAMERA_QUERY'].lower()
data = json.load(sys.stdin)
for d in data.get('devices', []):
    if 'CAMERA' not in d.get('type', '') and 'DOORBELL' not in d.get('type', ''):
        continue
    room_name = d.get('parentRelations', [{}])[0].get('displayName', '').lower()
    custom_name = d.get('traits', {}).get('sdm.devices.traits.Info', {}).get('customName', '').lower()
    if query in room_name or (custom_name and query in custom_name):
        print(d['name'].split('/')[-1])
        break
" <<< "$data")

  if [[ -z "$camera_id" ]]; then
    echo "No camera matching '$room'" >&2
    exit 1
  fi

  local token project_id
  token=$(_get_access_token)
  project_id=$(_project_id)

  mkdir -p "$(dirname "$output")"
  /usr/bin/python3 "${HOME}/.openclaw/bin/nest-camera-snap.py" "$camera_id" "$token" "$project_id" "$output"
}

cmd_raw() {
  _api GET /devices | python3 -m json.tool
}

case "${1:-help}" in
  status)           cmd_status ;;
  weather)          cmd_weather ;;
  set)
    [[ "$#" -eq 3 ]] || { echo "Usage: nest set <room> <temp°F>" >&2; exit 2; }
    cmd_set "$2" "$3"
    ;;
  mode)
    [[ "$#" -eq 3 ]] || { echo "Usage: nest mode <room> <HEAT|OFF>" >&2; exit 2; }
    cmd_mode "$2" "$3"
    ;;
  eco)
    [[ "$#" -ge 2 && "$#" -le 3 ]] || { echo "Usage: nest eco <room> [on|off]" >&2; exit 2; }
    room="$2"
    toggle="${3:-on}"
    case "$toggle" in
      on)  cmd_eco "$room" "MANUAL_ECO" ;;
      off) cmd_eco "$room" "OFF" ;;
      *)   echo "Usage: nest eco <room> [on|off]" >&2; exit 2 ;;
    esac
    ;;
  camera)
    case "${2:-}" in
      snap)  cmd_camera_snap "${3:-kitchen}" "${4:-}" ;;
      *)     echo "Usage: nest camera snap [room] [output_path]" >&2; exit 1 ;;
    esac
    ;;
  snapshot)         cmd_snapshot ;;
  history)          cmd_history "${2:-24}" "${3:-}" ;;
  dashboard)        cmd_dashboard "${2:-open}" ;;
  raw)              cmd_raw ;;
  reauth)           cmd_reauth "${2:-}" ;;
  help|--help|-h)   cmd_help ;;
  *)                echo "Unknown command: $1. Run 'nest help'." >&2; exit 1 ;;
esac
