#!/usr/bin/env python3
"""Bounded Samsung TV developer controls through the Crosstown Mac.

Usage: samsung-tv-dev status | apps [QUERY] | launch APP_ID [--url URI]
       samsung-tv-dev browser | open URL | app-info APP_ID | app-state APP_ID
       samsung-tv-dev youtube VIDEO_URL_OR_ID | youtube-state [VIDEO_URL_OR_ID] | wake | foreground
       samsung-tv-dev netflix CONTENT_URL_OR_ID  # Restarts Netflix to select content
       samsung-tv-dev twitch CHANNEL_OR_URL     # Restarts Twitch to select channel
       samsung-tv-dev apple-tv URL | apple-tv-play URL
       samsung-tv-dev prime-video GTI          # Opens exact content; no blind Play key
       samsung-tv-dev max-show ID_OR_URL | max-play ID_OR_URL | max-search TITLE
       samsung-tv-dev peacock-episode ID_OR_URL | peacock-play ID_OR_URL
       samsung-tv-dev peacock-show SERIES_ID | peacock-search TITLE
       samsung-tv-dev screenshot --output NEW_LOCAL_PNG
Uses an already enabled Developer Mode and an already installed, verified SDB.
Content/navigation uses the owner-authorized SDK-user package-name execution
path. Screenshots use owner-authorized temporary root; no arbitrary shell
interface or TV app installation is exposed.
"""

import argparse
import asyncio
import base64
