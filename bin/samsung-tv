#!/usr/bin/env python3
"""samsung-tv — CLI for controlling Samsung The Frame TVs.

Uses samsungtvws (NickWaterton fork) for WebSocket control and art mode.
Crosstown TV connections travel through its always-on MacBook over SSH.

Usage:
  samsung-tv status                     Show TV status (power, volume, app)
  samsung-tv pair <name>                One attended approval attempt; no keys sent
  samsung-tv power <name> on            Ensure power on; verify before any toggle
  samsung-tv power <name> off           Power off
  samsung-tv volume <name> up|down|N     Volume up/down (N = number of presses, negative = down)
  samsung-tv mute <name>                Toggle mute
  samsung-tv key <name> <KEY_NAME>      Send remote key (KEY_HOME, KEY_SOURCE, etc.)
  samsung-tv keys <name> <KEY>...       Send up to 16 navigation/transport keys in one connection
  samsung-tv app <name> list            List installed apps
  samsung-tv app <name> launch <app>    Launch app by ID or fuzzy name
  samsung-tv app <name> close <app>     Close app by ID or fuzzy name
  samsung-tv art <name>                 Show current art mode state
  samsung-tv art <name> on              Enter art mode
  samsung-tv art <name> off             Exit art mode
  samsung-tv art <name> list            List available artwork
  samsung-tv art <name> select <id>     Select artwork to display
  samsung-tv help                       Show this help

TV names are fuzzy-matched; "TV", "frame", and "crosstown" identify the Crosstown TV.
"""

import json
import os
from pathlib import Path
import selectors
import socket
import subprocess
import sys
import tempfile
import time
from contextlib import contextmanager
from urllib.parse import urlsplit, urlunsplit

CONFIG_FILE = os.path.expanduser("~/.openclaw/samsung-tvs.json")
CACHE_DIR = os.path.expanduser("~/.cache/samsung-tv")
WAKE_READY_TIMEOUT = 90
CROSSTOWN_HOST = "dylans-macbook-pro"
CROSSTOWN_TV = "192.168.165.2"
_tunnel = None


class TransportError(RuntimeError):
    """The required Crosstown SSH transport is unavailable."""


class CrosstownTunnel:
    """One owned SSH process, two loopback forwards, no subnet-route fallback."""

    def __init__(self):
        self.ports = {}
        self.process = None
        self.errors = None

    def __enter__(self):
        reservations = []
        try:
            for port in (8001, 8002):
                listener = socket.socket()
                reservations.append(listener)
                listener.bind(("127.0.0.1", 0))
                self.ports[port] = listener.getsockname()[1]
        finally:
            for listener in reservations:
                listener.close()
        # SSH must own both ports. A competing bind fails closed; never replace
        # an existing listener or reuse somebody else's control connection.
        args = ["ssh", "-T", "-o", "BatchMode=yes", "-o", "ConnectTimeout=5",
                "-o", "ConnectionAttempts=1", "-o", "ExitOnForwardFailure=yes",
                "-o", "ControlMaster=no", "-o", "ControlPath=none",
                "-o", "ServerAliveInterval=5", "-o", "ServerAliveCountMax=2"]
        for remote, local in self.ports.items():
            args += ["-L", f"127.0.0.1:{local}:{CROSSTOWN_TV}:{remote}"]
        # The private stdin pipe ties the remote command to this parent. Even
        # an abrupt parent exit closes it, so SSH doesn't remain as an orphaned
        # -N tunnel. No shared daemon or persistent remote helper is created.
        args += [CROSSTOWN_HOST,
                 "printf 'OPENCLAW_TV_FORWARD_READY\\n'; exec /bin/cat >/dev/null"]
        try:
            self.errors = tempfile.TemporaryFile()
            self.process = subprocess.Popen(args, stdin=subprocess.PIPE,
                                            stdout=subprocess.PIPE, stderr=self.errors)
            deadline = time.monotonic() + 8
            self.check_alive()
            # Read readiness from our authenticated SSH process, not by
            # probing ports that a competing local process could have bound.
            ready = b""
            with selectors.DefaultSelector() as selector:
                selector.register(self.process.stdout, selectors.EVENT_READ)
                while time.monotonic() < deadline:
                    self.check_alive()
                    if not selector.select(max(0, deadline - time.monotonic())):
                        break
                    chunk = os.read(self.process.stdout.fileno(), 128)
                    if not chunk:
                        break
                    ready += chunk
                    if ready == b"OPENCLAW_TV_FORWARD_READY\n":
                        self.check_alive()
                        return self
                    if len(ready) > 128 or b"\n" in ready:
                        break
            raise TransportError("Crosstown SSH forwards did not become ready")
        except BaseException:
            self.__exit__(None, None, None)
            raise

    def check_alive(self):
        if self.process is None or self.process.poll() is not None:
            raise TransportError("Crosstown SSH connection unavailable; check dylans-macbook-pro")

    def route(self, url):
        self.check_alive()
        parts = urlsplit(url)
        if parts.hostname != CROSSTOWN_TV or parts.port not in self.ports:
            raise TransportError("Unexpected TV destination; refusing to bypass Crosstown")
        # Preserve HTTPS/WSS even though the local forward uses an ephemeral
        # port. The library otherwise infers TLS from the literal port 8002.
        return urlunsplit(parts._replace(netloc=f"127.0.0.1:{self.ports[parts.port]}"))

    def __exit__(self, *_args):
        try:
            if self.process is not None and self.process.poll() is None:
                self.process.terminate()
                try:
                    self.process.wait(timeout=5)
                except subprocess.TimeoutExpired:
                    self.process.kill()
                    self.process.wait(timeout=5)
        finally:
            if self.process is not None and self.process.stdin is not None:
                self.process.stdin.close()
            if self.process is not None and self.process.stdout is not None:
                self.process.stdout.close()
            if self.errors is not None:
                self.errors.close()


@contextmanager
def tv_transport(required):
    global _tunnel
    if not required:
        yield
        return
    with CrosstownTunnel() as tunnel:
        _tunnel = tunnel
        try:
            yield
        finally:
            _tunnel = None


def client_classes(ip):
    from samsungtvws import SamsungTVWS
    from samsungtvws.rest import SamsungTVRest
    if ip != CROSSTOWN_TV:
        return SamsungTVWS, SamsungTVRest
    tunnel = _tunnel
    if tunnel is None:
        raise TransportError("Crosstown TV requires its SSH transport")
    tunnel.check_alive()
    from samsungtvws.art import SamsungTVArt

    class RoutedConnection:
        def open(self):
            return open_websocket(self)

        def _format_rest_url(self, *args, **kwargs):
            return tunnel.route(super()._format_rest_url(*args, **kwargs))

        def _format_websocket_url(self, *args, **kwargs):
            return tunnel.route(super()._format_websocket_url(*args, **kwargs))

    class RoutedRest(RoutedConnection, SamsungTVRest):
        pass

    class RoutedRestOwner:
        def _get_rest_api(self):
            if self._rest_api is None:
                self._rest_api = RoutedRest(self.host, self.port, self.timeout)
            return self._rest_api

    class RoutedArt(RoutedRestOwner, RoutedConnection, SamsungTVArt):
        pass

    class RoutedTV(RoutedRestOwner, RoutedConnection, SamsungTVWS):
        def art(self, timeout=5):
            return RoutedArt(self.host, token=self.token, token_file=self.token_file,
                             port=self.port, timeout=timeout,
                             key_press_delay=self.key_press_delay, name=self.name)

    return RoutedTV, RoutedRest


def open_websocket(client):
    """Bounded library-compatible handshake, including the Frame's touch notice."""
    from samsungtvws import connection as protocol
    if client.connection:
        return client.connection
    timeout = client.timeout or 5
    deadline = time.monotonic() + timeout
    connection = protocol.websocket.create_connection(
        client._format_websocket_url(client.endpoint), timeout,
        sslopt={"cert_reqs": protocol.ssl.CERT_NONE} if client._is_ssl_connection() else {},
        connection="Connection: Upgrade",
    )
    ignored = (*protocol.IGNORE_EVENTS_AT_STARTUP,
               "ms.remote.touchEnable", "ms.remote.touchDisable")
    try:
        for _ in range(16):
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise TimeoutError("TV remote handshake timed out")
            connection.settimeout(remaining)
            response = protocol.helper.process_api_response(connection.recv())
            event = response.get("event")
            client._websocket_event(event, response)
            if event in ignored:
                continue
            if event == protocol.MS_CHANNEL_UNAUTHORIZED:
                raise protocol.exceptions.UnauthorizedError("TV connection approval required")
            if event != protocol.MS_CHANNEL_CONNECT_EVENT:
                raise protocol.exceptions.ConnectionFailure("Unexpected TV handshake event")
            client._check_for_token(response)
            connection.settimeout(timeout)
            client.connection = connection
            return connection
        raise TimeoutError("TV remote handshake exceeded its event limit")
    except BaseException:
        connection.close()
        raise


def new_tv(ip, name, timeout=5):
    remote, _rest = client_classes(ip)
    # The display-name change must not discard the existing pairing identity.
    pairing_name = "Samsung The Frame 65" if ip == CROSSTOWN_TV else name
    return remote(host=ip, port=8002, token_file=token_path(pairing_name),
                  timeout=timeout, name="OpenClaw")


def device_info(ip, timeout=3):
    _remote, rest = client_classes(ip)
    # Use the REST client directly: no token, model-year constructor request,
    # or implicit WebSocket open on newer TVs.
    return rest(host=ip, port=8001, timeout=timeout).rest_device_info()

DEFAULT_TVS = {
    "TV": {
        "ip": "192.168.165.2",
        "mac": "A0:D7:F3:B2:C0:AC",
    }
}

# Common Samsung TV app IDs for fuzzy matching
KNOWN_APPS = {
    "netflix": "3201907018807",
    "youtube": "111299001912",
    "spotify": "3201606009684",
    "disney": "3201901017640",
    "disney+": "3201901017640",
    "hulu": "3201601007625",
    "prime": "3201910019365",
    "prime video": "3201910019365",
    "amazon": "3201910019365",
    "hbo": "3202301029760",
    "hbo max": "3202301029760",
    "max": "3202301029760",
    "apple": "3201807016597",
    "apple tv": "3201807016597",
    "plex": "3201512006963",
    "paramount": "3201908019041",
    "paramount+": "3201908019041",
    "peacock": "3201909019858",
    "tubi": "3201504001965",
}


def load_tvs():
    if os.path.exists(CONFIG_FILE):
        with open(CONFIG_FILE) as f:
            return json.load(f)
    return DEFAULT_TVS


def resolve_tv(query, tvs):
    """Fuzzy-match a TV name."""
    q = query.lower()
    if q in {"tv", "frame", "crosstown", "samsung the frame 65"}:
        crosstown = [(name, info) for name, info in tvs.items()
                     if info.get("ip") == CROSSTOWN_TV]
        if len(crosstown) == 1:
            return crosstown[0]
    for name, info in tvs.items():
        if q in name.lower():
            return name, info
    print(f"No TV matching '{query}'. Available:", file=sys.stderr)
    for name in tvs:
        print(f"  - {name}", file=sys.stderr)
    sys.exit(1)


def token_path(name):
    """Get token file path for a TV."""
    slug = name.lower().replace(" ", "_")
    d = os.path.join(CACHE_DIR, slug)
    os.makedirs(d, mode=0o700, exist_ok=True)
    os.chmod(d, 0o700)
    path = os.path.join(d, "token.txt")
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    try:
        os.fchmod(fd, 0o600)
    finally:
        os.close(fd)
    return path


def get_tv(ip, name, timeout=5):
    """Connect to a Samsung TV."""
    try:
        tv = new_tv(ip, name, timeout)
        tv.open()
        return tv
    except TransportError:
        raise
    except Exception as e:
        print(f"Error connecting to {name} ({ip}): {e}", file=sys.stderr)
        sys.exit(1)


def resolve_app_id(query, installed_apps=None):
    """Resolve an app name to an app ID. Check known apps first, then fuzzy-match installed."""
    q = query.lower()

    # Exact app ID (numeric)
    if q.isdigit():
        return query

    # Known apps
    if q in KNOWN_APPS:
        return KNOWN_APPS[q]

    # Fuzzy match known apps
    for app_name, app_id in KNOWN_APPS.items():
        if q in app_name:
            return app_id

    # Fuzzy match installed apps
    if installed_apps:
        for app in installed_apps:
            if q in app.get("name", "").lower():
                return app["appId"]

    return query  # Return as-is, let the TV reject it if invalid


def cmd_status(_args):
    # REST-only: opening the WS connection wakes the Frame's panel and shows a
    # connection notification, even with a saved token. Use `samsung-tv art`
    # explicitly when art-mode info is needed.
    tvs = load_tvs()
    for name, info in tvs.items():
        ip = info["ip"]
        try:
            data = device_info(ip, timeout=5)
            dev = data.get("device", data)
            power = dev.get("PowerState", "Unknown")
            model = dev.get("modelName", "Unknown")
            print(f"  {name}")
            print(f"    Model:  {model}")
            print(f"    IP:     {ip}")
            print(f"    Power:  {power}")
        except TransportError:
            raise
        except Exception:
            print(f"  {name}")
            print(f"    IP:     {ip}")
            print(f"    Power:  UNREACHABLE")


def read_power(info):
    """Passive REST query; no WebSocket connection or token required."""
    try:
        data = device_info(info["ip"])
        return str(data.get("device", data).get("PowerState", "unknown")).lower()
    except TransportError:
        raise
    except Exception:
        return "unknown"


def send_wake(info):
    # Wake broadcasts originate on the same Crosstown LAN as REST/WebSockets.
    if info["ip"] == CROSSTOWN_TV:
        helper = Path(__file__).resolve().with_name("samsung-tv-dev")
        subprocess.run([str(helper), "wake"], check=True, timeout=35,
                       stdout=subprocess.DEVNULL)
        return
    from wakeonlan import send_magic_packet
    mac = info.get("mac")
    if not mac:
        raise RuntimeError("No MAC address configured for LAN wake")
    send_magic_packet(mac)


def poll_power(info):
    for _ in range(5):
        state = read_power(info)
        if state == "on":
            return state
        time.sleep(1)
    return read_power(info)


def wait_for_wake(info):
    # A cold wake can start the developer port well before REST/MSF. The
    # observed TV started MSF about 61 seconds into boot. Wait for a usable
    # power state, including standby so the verified remote fallback can run.
    deadline = time.monotonic() + WAKE_READY_TIMEOUT
    while True:
        state = read_power(info)
        if state in ("on", "standby"):
            return state
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            return state
        time.sleep(min(2, remaining))


def ensure_power_on(name, info):
    result = {"power_on_verified": False, "wake_packet_sent": False,
              "power_key_sent": False}
    state = read_power(info)
    if state not in ("on", "standby"):
        send_wake(info)
        result["wake_packet_sent"] = True
        state = wait_for_wake(info)
    if state == "standby":
        remote = get_tv(info["ip"], name)
        try:
            # Opening WS can itself wake the panel. Never toggle it back off.
            state = read_power(info)
            if state == "standby":
                remote.send_key("KEY_POWER")
                result["power_key_sent"] = True
                state = poll_power(info)
        finally:
            remote.close()
    result.update(power=state, power_on_verified=state == "on")
    return result


def cmd_power_on(name, info):
    try:
        result = ensure_power_on(name, info)
    except Exception as exc:
        print(f"Power-on failed; do not assume the TV is on: {exc}", file=sys.stderr)
        sys.exit(1)
    print(json.dumps(result))
    if not result["power_on_verified"]:
        print("Power-on unverified after bounded wake/power checks; "
              "no blind power-toggle retry. Check TV connectivity and power state.",
              file=sys.stderr)
        sys.exit(1)


def cmd_power_off(name, info):
    tv = get_tv(info["ip"], name)
    tv.send_key("KEY_POWER")
    print(f"Sent power off to {name}")
    tv.close()


def cmd_pair(name, info):
    print("Waiting up to 60 seconds for one TV connection approval; no keys will be sent.",
          flush=True)
    tv = new_tv(info["ip"], name, timeout=60)
    try:
        tv.open()
        print(f"Pairing verified for {name}; TV token saved locally.")
    finally:
        tv.close()


def cmd_volume(name, info, direction):
    """Send volume up/down key presses. direction: 'up', 'down', or a number of presses."""
    tv = get_tv(info["ip"], name)
    d = direction.lower() if isinstance(direction, str) else str(direction)
    if d in ("up", "+"):
        tv.send_key("KEY_VOLUP")
        print(f"Volume up on {name}")
    elif d in ("down", "-"):
        tv.send_key("KEY_VOLDOWN")
        print(f"Volume down on {name}")
    else:
        # Treat as number of presses: positive = up, negative = down
        try:
            n = int(d)
        except ValueError:
            print(f"Invalid volume direction: {direction}. Use 'up', 'down', or a number.", file=sys.stderr)
            tv.close()
            sys.exit(1)
        key = "KEY_VOLUP" if n > 0 else "KEY_VOLDOWN"
        times = abs(n)
        for _ in range(times):
            tv.send_key(key, key_press_delay=0.1)
        print(f"Volume {'up' if n > 0 else 'down'} {times}x on {name}")
    tv.close()


def cmd_mute(name, info):
    tv = get_tv(info["ip"], name)
    tv.send_key("KEY_MUTE")
    print(f"Toggled mute on {name}")
    tv.close()


def cmd_key(name, info, key):
    key = key.upper()
    if not key.startswith("KEY_"):
        key = "KEY_" + key
    tv = get_tv(info["ip"], name)
    tv.send_key(key)
    print(f"Sent {key} to {name}")
    tv.close()


def cmd_keys(name, info, keys):
    """Short, observed navigation sequences; never retry partially sent batches."""
    normalized = [key.upper() if key.upper().startswith("KEY_") else "KEY_" + key.upper()
                  for key in keys]
    allowed = {"KEY_UP", "KEY_DOWN", "KEY_LEFT", "KEY_RIGHT", "KEY_ENTER",
               "KEY_RETURN", "KEY_PLAY", "KEY_PAUSE", "KEY_STOP"}
    if not 1 <= len(normalized) <= 16 or any(key not in allowed for key in normalized):
        print("Use 1–16 navigation or playback keys; inspect the screen between batches.", file=sys.stderr)
        raise SystemExit(1)
    tv = get_tv(info["ip"], name)
    sent = 0
    try:
        for key in normalized:
            tv.send_key(key, key_press_delay=0.35)
            sent += 1
        print(f"Sent {sent} keys to {name}; verify the resulting screen")
    except Exception:
        print(f"Batch interrupted after {sent} sends; inspect before retrying", file=sys.stderr)
        raise
    finally:
        tv.close()


def cmd_app_list(name, info):
    """List apps using REST API for known apps (WS app_list often returns empty)."""
    tv = new_tv(info["ip"], name)

    # Check each known app via REST API (deduplicate by app ID)
    found = []
    seen_ids = set()
    for app_name, app_id in sorted(KNOWN_APPS.items()):
        if app_id in seen_ids:
            continue
        seen_ids.add(app_id)
        try:
            status = tv.rest_app_status(app_id)
            if status and status.get("name"):
                running = " [RUNNING]" if status.get("running") else ""
                visible = " [VISIBLE]" if status.get("visible") else ""
                print(f"  {status['name']:30s}  {app_id}  {running}{visible}")
                found.append(status)
        except TransportError:
            raise
        except Exception:
            pass

    if not found:
        print("No apps detected. TV may be off or unreachable.")


def cmd_app_launch(name, info, app_query):
    """Launch app via REST API (more reliable than WebSocket run_app)."""
    tv = new_tv(info["ip"], name, timeout=10)
    app_id = resolve_app_id(app_query)
    result = tv.rest_app_run(app_id)
    if result:
        print(f"Launched app {app_query} ({app_id}) on {name}")
    else:
        print(f"Failed to launch app {app_query} ({app_id}) on {name}", file=sys.stderr)
        sys.exit(1)


def cmd_app_close(name, info, app_query):
    tv = get_tv(info["ip"], name)
    app_id = resolve_app_id(app_query)
    tv.rest_app_close(app_id)
    print(f"Closed app {app_query} ({app_id}) on {name}")
    tv.close()


def cmd_art(name, info, subcmd=None, arg=None):
    tv = get_tv(info["ip"], name)
    try:
        art = tv.art()
        if not art.supported():
            print(f"{name} does not support art mode", file=sys.stderr)
            tv.close()
            sys.exit(1)

        if subcmd is None or subcmd == "status":
            # Show art mode state
            try:
                mode = art.get_artmode()
                print(f"  Art mode:    {mode}")
            except Exception as e:
                print(f"  Art mode:    unknown ({e})")

            try:
                current = art.get_current()
                if isinstance(current, dict):
                    cid = current.get("content_id", "?")
                    cat = current.get("category_id", "")
                    ctype = current.get("content_type", "")
                    matte = current.get("matte_id", "")
                    print(f"  Content ID:  {cid}")
                    print(f"  Category:    {cat}")
                    print(f"  Type:        {ctype}")
                    if matte and matte != "none":
                        print(f"  Matte:       {matte}")
                else:
                    print(f"  Current:     {current}")
            except Exception:
                pass

            try:
                brightness = art.get_brightness()
                print(f"  Brightness:  {brightness}")
            except Exception:
                pass

        elif subcmd == "on":
            art.set_artmode("on")
            print(f"Art mode enabled on {name}")

        elif subcmd == "off":
            art.set_artmode("off")
            print(f"Art mode disabled on {name}")

        elif subcmd == "list":
            artworks = art.available()
            if not artworks:
                print("No artwork available")
            else:
                if isinstance(artworks, str):
                    artworks = json.loads(artworks)
                if isinstance(artworks, list):
                    for item in artworks[:50]:  # Limit output
                        if isinstance(item, dict):
                            cid = item.get("content_id", "?")
                            title = item.get("title", "")
                            category = item.get("category_id", "")
                            print(f"  {cid:40s}  {title:30s}  {category}")
                        else:
                            print(f"  {item}")
                else:
                    print(artworks)

        elif subcmd == "select" and arg:
            art.select_image(arg, show=True)
            print(f"Selected artwork {arg} on {name}")

        else:
            print(f"Unknown art subcommand: {subcmd}", file=sys.stderr)
            sys.exit(1)

        art.close()
    except SystemExit:
        raise
    except Exception as e:
        print(f"Art mode error: {e}", file=sys.stderr)
        sys.exit(1)
    finally:
        tv.close()


def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("help", "--help", "-h"):
        print(__doc__)
        return

    cmd = sys.argv[1]
    rest = sys.argv[2:]
    tvs = load_tvs()
    required = False
    if cmd == "status":
        required = any(info["ip"] == CROSSTOWN_TV for info in tvs.values())
    elif cmd in {"pair", "power", "volume", "mute", "key", "keys", "app", "art"} and rest:
        _name, info = resolve_tv(rest[0], tvs)
        required = info["ip"] == CROSSTOWN_TV
    with tv_transport(required):
        dispatch(cmd, rest, tvs)


def dispatch(cmd, rest, tvs):
    if cmd == "status":
        cmd_status(rest)

    elif cmd == "pair" and len(rest) == 1:
        name, info = resolve_tv(rest[0], tvs)
        cmd_pair(name, info)

    elif cmd == "power" and len(rest) >= 2:
        name, info = resolve_tv(rest[0], tvs)
        action = rest[1].lower()
        if action == "on":
            cmd_power_on(name, info)
        elif action == "off":
            cmd_power_off(name, info)
        else:
            print(f"Unknown power action: {action}. Use 'on' or 'off'.", file=sys.stderr)
            sys.exit(1)

    elif cmd == "volume" and len(rest) >= 2:
        name, info = resolve_tv(rest[0], tvs)
        cmd_volume(name, info, rest[1])

    elif cmd == "mute" and len(rest) >= 1:
        name, info = resolve_tv(rest[0], tvs)
        cmd_mute(name, info)

    elif cmd == "key" and len(rest) >= 2:
        name, info = resolve_tv(rest[0], tvs)
        cmd_key(name, info, rest[1])

    elif cmd == "keys" and len(rest) >= 2:
        name, info = resolve_tv(rest[0], tvs)
        cmd_keys(name, info, rest[1:])

    elif cmd == "app" and len(rest) >= 2:
        name, info = resolve_tv(rest[0], tvs)
        subcmd = rest[1].lower()
        if subcmd == "list":
            cmd_app_list(name, info)
        elif subcmd == "launch" and len(rest) >= 3:
            cmd_app_launch(name, info, " ".join(rest[2:]))
        elif subcmd == "close" and len(rest) >= 3:
            cmd_app_close(name, info, " ".join(rest[2:]))
        else:
            print(f"Unknown app subcommand: {subcmd}", file=sys.stderr)
            sys.exit(1)

    elif cmd == "art" and len(rest) >= 1:
        name, info = resolve_tv(rest[0], tvs)
        subcmd = rest[1].lower() if len(rest) >= 2 else None
        arg = rest[2] if len(rest) >= 3 else None
        cmd_art(name, info, subcmd, arg)

    else:
        print(f"Unknown command or missing args: {cmd} {' '.join(rest)}", file=sys.stderr)
        print("Run 'samsung-tv help' for usage.", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    try:
        main()
    except (TransportError, OSError, subprocess.SubprocessError) as exc:
        print(f"TV control failed: {exc}", file=sys.stderr)
        raise SystemExit(1)
